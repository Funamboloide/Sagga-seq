      <object id="patch/object" uuid="060c6f31-af80-555a-bfb1-68e7de4f3838">
         <sDescription>Microcosm-style granular/looper engine: 11 effects x 4 variations, hold, filter, Space reverb and echo, 60 s looper. Uses about 28 MB of SDRAM. routing: insert = dry/wet mix, aux = send/return (no dry at the output). output: stereo or mono (L+R on both jacks). secho: the echo in SPACE follows the tempo, free = fixed as at 120 BPM, off = reverb alone.</sDescription>
         <author>Claude for Ksoloti Gills</author>
         <license>BSD</license>
         <inlets>
            <frac32buffer name="inL" description="audio in left"/>
            <frac32buffer name="inR" description="audio in right"/>
            <int32 name="algo" description="effect 0-10"/>
            <int32 name="var" description="variation 0-3 (A-D)"/>
            <frac32.positive name="act" description="activity"/>
            <frac32.positive name="rep" description="repeats"/>
            <frac32.positive name="shp" description="shape"/>
            <frac32.positive name="flt" description="filter cutoff (max = bypass, min = effect muted)"/>
            <frac32.positive name="res" description="filter resonance"/>
            <frac32.positive name="mix" description="dry/effect mix"/>
            <frac32.positive name="fxv" description="effect volume (32 = unity)"/>
            <frac32.positive name="spc" description="space (reverb) amount"/>
            <int32 name="rmode" description="reverb mode 0-3"/>
