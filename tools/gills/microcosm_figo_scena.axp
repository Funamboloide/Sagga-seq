         <includes/>
         <code.declaration><![CDATA[#ifndef S3_SECT
#define S3_STR2(x) #x
#define S3_STR(x) S3_STR2(x)
#define S3_SECT(kind) section(".sram3." kind "." S3_STR(__COUNTER__))
#endif
#undef MC_COLD
#ifdef __clang__
#define MC_COLD __attribute__((noinline, minsize, S3_SECT("text")))
#else
#define MC_COLD __attribute__((noinline, optimize("Os"), S3_SECT("text")))
#endif
/* =====================================================================
   mc_panel - Gills front panel for the Microcosm-style engine
   pots 1-10, buttons 1-4, encoder + switch (SHIFT), OLED, LEDs
   ===================================================================== */
#ifndef MC_COLD
#ifdef __clang__
#define MC_COLD __attribute__((noinline, minsize))
#else
#define MC_COLD __attribute__((noinline, optimize("Os")))
#endif
#endif
enum { UI_NP = 10 };
#define MCUI_LOOPMS 60000

float    pv[UI_NP], pShow[UI_NP], pLast[UI_NP], prim[UI_NP], sec[UI_NP];
uint8_t  pickP[UI_NP], pickS[UI_NP];
bool     shift;
int32_t  encLast, preset, ticks;
uint8_t  bSt[5], bRaw[5], bCnt[5], bLong[5];
int32_t  bHeld[5];
int32_t  tapTick, tapInt[3], tapN;
float    tapBpm, knobBpm;
bool     tempoMode, tempoKnob, holdSt, holdMom, lrevSt, lpreSt, holdOut;
int32_t  subZone, rvZone, lsZone, shZone;      /* shZone: SHAPE, 0 square, 1 ramp, 2 triangle, 3 saw */
bool     lonlySt, burstSt, quantSt;             /* looper only / burst / quantize: attributes, then CC 25-27 */
int32_t  puTap, puRec, puStop, puErase, puUndo;
int32_t  popP, popT, clipT, dispTick, dLine, blinkT;
bool     popSec;
char     ln[4][24];
/* live: bypass with trails, MIDI pedal / clock (the MIDI handler runs in another thread and only sets these) */
bool     killSt, auxMode, clkWas;
int32_t  puSync, qCnt;
float    clkBpm;
int32_t  svInt[3], svN, svTick;
float    svBpm;
bool     svKnob;
volatile uint32_t kTime, clkW, clkLast;
volatile int32_t clkDev;                 /* port that owns the clock, -1 = none yet */
volatile uint32_t clkT[32];
volatile int32_t  clkPos, mPc, sppQ;
volatile bool     clkBeat, clkStart, sppNew, mHold, mHoldNew, mKill, mKillNew, mTap, mRec, mStop, mErase, mPcNew;
int32_t  inMode, oMono;
/* REVERSE (encoder push tapped), looper options, MIDI extras */
bool     fxRev, shUsed, burstDown;
float    pAtSh[UI_NP];
int32_t  lsNow;
volatile bool mRecUp, mUndo, mRev, mRevNew;
/* the pedal's own CC chart: queued by the MIDI thread, applied by the k-rate code */
volatile uint32_t cqW, cqR;
uint16_t cq[16];

/* where the clock comes from, for the OLED: DIN = MIDI IN, USB = from the computer, HOST = USB host */
MC_COLD const char *clkTag() {
    switch (clkDev) { case 1: return "DIN"; case 2: return "USB"; case 3: return "HOST"; default: return "CLK"; }
}
MC_COLD static const char *mcName(int a) {
    static const char *const n[11] = { "MOSAIC", "SEQ", "GLIDE", "HAZE", "TUNNEL", "STRUM",
                                 "BLOCKS", "INTERRUPT", "ARP", "PATTERN", "WARP" };
    return n[a < 0 ? 0 : (a > 10 ? 10 : a)];
}
/* the presets run as on the pedal: MOSAIC SEQ GLIDE | BLOCKS INTERRUPT ARP | HAZE TUNNEL STRUM |
   PATTERN WARP; mcAlgo gives the engine's effect number for a place in that row */
MC_COLD static int mcAlgo(int pos) {
    static const uint8_t o[11] = { 0, 1, 2, 6, 7, 8, 3, 4, 5, 9, 10 };
    return o[pos < 0 ? 0 : (pos > 10 ? 10 : pos)];
}
MC_COLD static const char *mcBank(int pos) {
    static const char *const b[4] = { "MICRO LOOP", "GLITCH", "GRANULES", "MULTIDELAY" };
    return b[pos < 3 ? 0 : (pos < 6 ? 1 : (pos < 9 ? 2 : 3))];
}
MC_COLD static const char *shName(int z) {
    static const char *const n[4] = { "SQUARE", "RAMP", "TRIANGLE", "SAW" };
    return n[z & 3];
}
/* secondary functions under SHIFT, on the same knobs as the pedal: REPEATS = MOD DEPTH,
   SHAPE = MOD RATE, MIX = FX VOLUME, TIME = LOOP SPEED, LOOP LEVEL = LOOP FADE */
static bool hasSec(int i) { return i == 1 || i == 2 || i == 4 || i == 5 || i == 7; }

/* ---- tiny text helpers (no libc) ---- */
MC_COLD static char *uPut(char *p, const char *s) { while (*s) *p++ = *s++; return p; }
MC_COLD static char *uNum(char *p, int32_t v, int w) {          /* right aligned integer */
    char t[12]; int n = 0; bool neg = v < 0;
    uint32_t u = neg ? (uint32_t)(-v) : (uint32_t)v;
    do { t[n++] = (char)('0' + u % 10u); u /= 10u; } while (u && n < 11);
    if (neg) t[n++] = '-';
    while (w-- > n) *p++ = ' ';
    while (n) *p++ = t[--n];
    return p;
}
MC_COLD static char *uDec1(char *p, int32_t tenths, int w) {    /* 12.3 */
    if (tenths < 0) tenths = 0;
    p = uNum(p, tenths / 10, w - 2);
    *p++ = '.';
    *p++ = (char)('0' + tenths % 10);
    return p;
}
MC_COLD static void uEnd(char *line, char *p) {                 /* pad to 21 + terminate */
    char *e = line + 21;
    while (p < e) *p++ = ' ';
    *e = 0;
}

static int32_t pct(float v) { int32_t r = (int32_t)(v * 100.0f + 0.5f); return r > 99 ? 99 : r; }
MC_COLD float bpmNow() {
    if (tempoMode) return tempoKnob ? knobBpm : tapBpm;
    return tapBpm;
}
MC_COLD float subMult() { static const float m[6] = { 0.25f, 0.5f, 1.0f, 2.0f, 4.0f, 8.0f }; return tempoMode ? 1.0f : m[subZone]; }
MC_COLD float loopSpeed() {
    if (!tempoMode) { static const float s[5] = { 0.25f, 0.5f, 1.0f, 2.0f, 4.0f }; return s[lsZone]; }
    float v = sec[5];
    if (v > 0.46f && v < 0.54f) return 1.0f;
    float x = v < 0.5f ? (v / 0.46f) - 1.0f : (v - 0.54f) / 0.46f;   /* -1..0 | 0..1 */
    float sp = 1.0f, a = x < 0.0f ? -x : x;
    float o = a * 2.0f;                                              /* 0..2 octaves */
    sp = 1.0f + o * (0.6931f + o * (0.2402f + o * 0.0555f));          /* ~2^o */
    return x < 0.0f ? 1.0f / sp : sp;
}
MC_COLD static int zoneOf(float v, int n, int cur) {          /* quantize with hysteresis */
    float w = 1.0f / (float)n;
    float lo = (float)cur * w - 0.02f, hi = (float)(cur + 1) * w + 0.02f;
    if (v >= lo && v <= hi) return cur;
    int z = (int)(v * (float)n);
    return z < 0 ? 0 : (z >= n ? n - 1 : z);
}

/* popup text for parameter i (primary or secondary) */
MC_COLD void popText(int i, bool s, char *l2, char *l3) {
    if (i == 201 || i == 202) {                       /* short messages */
        char *p = uPut(l2, i == 201 ? "HOLD: NOT WITH LOOPER" : (fxRev ? "REVERSE ON" : "REVERSE OFF"));
        uEnd(l2, p);
        p = uPut(l3, i == 201 ? "STOP THE LOOP FIRST" : "TAP ENCODER = TOGGLE");
        uEnd(l3, p);
        return;
    }
    if (i == 200) {                                   /* start-up: MIDI channel, clock, I/O */
        char *p = l2;
        if (attr_midich == 0) p = uPut(p, "MIDI OMNI  ");
        else { p = uPut(p, "MIDI CH "); p = uNum(p, attr_midich, 2); *p++ = ' '; }
        p = uPut(p, attr_clock ? " CLK SLAVE" : " CLK OFF");
        uEnd(l2, p);
        static const char *const im[3] = { "STEREO", "MONO L", "L+R" };
        p = l3;
        p = uPut(p, "IN "); p = uPut(p, im[(inMode < 0 || inMode > 2) ? 0 : inMode]);
        p = uPut(p, "  OUT "); p = uPut(p, oMono ? "MONO" : "ST");
        uEnd(l3, p);
        return;
    }
    static const char *const pn[UI_NP] = { "ACTIVITY", "REPEATS", "SHAPE", "FILTER", "MIX", "TIME",
                                     "SPACE", "LOOP LEVEL", "RESONANCE", "REVERB" };
    static const char *const sn[UI_NP] = { "", "MOD DEPTH", "MOD RATE", "", "FX VOLUME", "LOOP SPEED",
                                     "", "LOOP FADE", "", "" };
    float v = s ? sec[i] : prim[i];
    char *p = uPut(l2, s ? sn[i] : pn[i]);
    while (p < l2 + 11) *p++ = ' ';                 /* 11 + value (8) + " ~" = 21 */
    if (!s && i == 2) p = uPut(p, shName(shZone));
    else if (!s && i == 3) {
        if (v > 0.94f) p = uPut(p, "OPEN");
        else if (v < 0.03f) p = uPut(p, "OFF");
        else {
            float f = 20.0f;
            float o = v * 10.0f; int oi = (int)o; float fr = o - (float)oi;
            for (int k = 0; k < oi; k++) f *= 2.0f;
            f *= 1.0f + fr * (0.6931f + fr * (0.2402f + fr * 0.0555f));
            if (f < 1000.0f) { p = uNum(p, (int32_t)f, 4); p = uPut(p, "Hz"); }
            else { p = uDec1(p, (int32_t)(f / 100.0f), 4); p = uPut(p, "k"); }
        }
    } else if (!s && i == 5) {
        if (tempoMode) { p = uDec1(p, (int32_t)(knobBpm * 10.0f), 5); p = uPut(p, "BPM"); }
        else { static const char *const z[6] = { "1/4", "1/2", "TAP", "2x", "4x", "8x" }; p = uPut(p, z[subZone]); }
    } else if (!s && i == 9) {
        static const char *const rz[4] = { "A ROOM", "B DARK", "C HALL", "D AMBNT" };
        p = uPut(p, rz[rvZone]);
    } else if (s && i == 5) {
        p = uDec1(p, (int32_t)(loopSpeed() * 10.0f + 0.5f), 4); p = uPut(p, "x");
    } else if (s && i == 7) {
        float t = 0.005f;
        float o = v * 11.0f; int oi = (int)o; float fr = o - (float)oi;
        for (int k = 0; k < oi; k++) t *= 2.0f;
        t *= 1.0f + fr * (0.6931f + fr * (0.2402f + fr * 0.0555f));
        p = uDec1(p, (int32_t)(t * 10.0f + 0.5f), 4); p = uPut(p, "s");
    } else {
        p = uNum(p, (int32_t)(v * 100.0f + 0.5f), 3);
    }
    if (s ? pickS[i] : pickP[i]) p = uPut(p, " ~");
    uEnd(l2, p);
    /* bar */
    char *q = l3;
    *q++ = '[';
    int fill = (int)(v * 19.0f + 0.5f);
    int pot = (int)(pv[i] * 19.0f + 0.5f);
    bool pend = s ? pickS[i] : pickP[i];
    for (int k = 0; k < 19; k++) *q++ = (pend && k == pot) ? 'o' : (k < fill ? '#' : '-');
    *q++ = ']';
    uEnd(l3, q);
}

MC_COLD void drawLine(int n, int32_t lstate, int32_t lposMs, int32_t llenMs) {
    char *l = ln[n];
    char *p = l;
    if (n == 0) {
        int a = preset >> 2;
        p = uPut(p, mcName(mcAlgo(a)));
        *p++ = ' ';
        *p++ = (char)('A' + (preset & 3));
        const char *b = killSt ? "BYPASS" : (lonlySt ? "LOOP ONLY" : (fxRev ? "REVERSE" : mcBank(a)));
        int bl = 0; while (b[bl]) bl++;
        *p++ = ' ';
        while (p < l + 21 - bl) *p++ = ' ';
        p = uPut(p, b);
        uEnd(l, p);
        return;
    }
    if (n == 1 || n == 2) {
        if (popT > 0) {
            if (n == 1) popText(popP, popSec, ln[1], ln[2]);
            return;
        }
        if (n == 1) {
            if (shift) {
                p = uPut(p, "SHIFT MD"); p = uNum(p, pct(sec[1]), 2);
                p = uPut(p, " MR"); p = uNum(p, pct(sec[2]), 2);
            } else {
                p = uDec1(p, (int32_t)(bpmNow() * 10.0f + 0.5f), 5);
                if (clkWas) { const char *t = clkTag(); *p++ = ' '; p = uPut(p, t); while (p < l + 11) *p++ = ' '; }
                else p = uPut(p, " BPM  ");
                if (tempoMode) p = uPut(p, "TEMPO");
                else { static const char *const z[6] = { "1/4", "1/2", "TAP", "2x", "4x", "8x" }; p = uPut(p, "SUB "); p = uPut(p, z[subZone]); }
            }
        } else {
            if (shift) {
                p = uPut(p, "FX"); p = uNum(p, (int32_t)(sec[4] * 200.0f + 0.5f), 3);
                p = uPut(p, " SPD"); p = uDec1(p, (int32_t)(loopSpeed() * 10.0f + 0.5f), 3);
                p = uPut(p, " FD"); p = uNum(p, pct(sec[7]), 2);
            } else {
                p = uPut(p, "A");  p = uNum(p, pct(prim[0]), 2);
                p = uPut(p, " R"); p = uNum(p, pct(prim[1]), 2);
                { static const char *const sz[4] = { " SQR", " RMP", " TRI", " SAW" }; p = uPut(p, sz[shZone & 3]); }
                p = uPut(p, " M"); p = uNum(p, pct(prim[4]), 2);
                p = uPut(p, " SP"); p = uNum(p, pct(prim[6]), 2);
            }
        }
        uEnd(l, p);
        return;
    }
    static const char *const st[5] = { "----", "REC ", "PLAY", "DUB ", "STOP" };
    p = uPut(p, auxMode ? "AUX " : "INS ");
    p = uPut(p, lpreSt ? "PRE " : "PST ");
    p = uPut(p, st[(lstate < 0 || lstate > 4) ? 0 : lstate]);
    *p++ = ' ';
    int32_t ms = (lstate == 1) ? llenMs : (lstate == 0 ? 0 : llenMs);
    if (lstate == 0) p = uPut(p, "     ");
    else { p = uDec1(p, ms / 100, 4); *p++ = 's'; }
    *p++ = ' ';
    *p++ = holdSt ? 'H' : '-';
    *p++ = lrevSt ? 'R' : '-';
    (void)lposMs;
    uEnd(l, p);
}

/* debounced buttons: returns 1 on press, -1 on release */
MC_COLD int btn(int k, bool raw) {
    uint8_t r = raw ? 1 : 0;
    if (r != bRaw[k]) { bRaw[k] = r; bCnt[k] = 0; }
    else if (bCnt[k] < 12) bCnt[k]++;
    if (bCnt[k] == 8 && bSt[k] != r) {
        bSt[k] = r;
        if (r) { bHeld[k] = 0; bLong[k] = 0; return 1; }
        return -1;
    }
    if (bSt[k]) bHeld[k]++;
    return 0;
}

MC_COLD void doTap() {
    if (tapTick > 150) {
        if (tapTick < 7500) {
            tapInt[2] = tapInt[1]; tapInt[1] = tapInt[0]; tapInt[0] = tapTick;
            if (tapN < 3) tapN++;
            int32_t s = 0;
            for (int k = 0; k < tapN; k++) s += tapInt[k];
            tapBpm = 180000.0f * (float)tapN / (float)s;
            if (tapBpm < 20.0f) tapBpm = 20.0f;
            if (tapBpm > 300.0f) tapBpm = 300.0f;
        } else tapN = 0;
        tapTick = 0;
        tempoKnob = false;
        puTap = 3;
    }
}

bool loopActive() { return lsNow >= 1 && lsNow <= 3; }
/* looper REC. BURST (attribute): one-layer loops, recorded only while held and played on release;
   a press when a loop exists deletes it and records a new one at once (no overdub) */
MC_COLD void recPress() {
    burstDown = burstSt;
    if (burstDown && lsNow != 0) puErase = 3;
    puRec = 3;
    holdSt = false;                                   /* starting the looper ends HOLD */
}
MC_COLD void recRelease() {
    if (burstDown) { burstDown = false; puRec = 3; }
}

MC_COLD static float bpmOf(float x) {               /* tempo knob: 40..240 BPM */
    float b = 40.0f;
    float o = x * 2.585f; int oi = (int)o; float fr = o - (float)oi;
    for (int k = 0; k < oi; k++) b *= 2.0f;
    return b * (1.0f + fr * (0.6931f + fr * (0.2402f + fr * 0.0555f)));
}
MC_COLD void setP(int i, float v) { prim[i] = v; pickP[i] = 1; }      /* the pot takes over again when it crosses v */
/* the CC chart of the pedal (beside the live CCs 64 and 80-86, which stay). Knobs: 6 activity,
   7 shape (four bands), 8 filter, 9 mix, 10 time (tempo), 11 repeats, 12 space, 13 loop level,
   14 mod frequency, 15 resonance, 16 effect volume, 17/18 looper speed, 19 mod depth,
   20 reverb mode (four bands), 21 looper fade; 5 subdivision (0-5). Switches: 23 loop reverse,
   24 looper pre, 25 looper only, 26 burst, 27 quantize, 47 reverse, 48 hold, 102 bypass
   (0-63 bypass, 64-127 engage). Looper: 28 record, 29 play, 30 overdub, 31 stop, 34 erase,
   35 undo. 93 tap. */
MC_COLD void pedalCC(int cc, int v) {
    static const uint8_t kn[16] = { 0, 255, 3, 4, 255, 1, 6, 7, 16 + 2, 8, 16 + 4, 16 + 5, 16 + 5, 16 + 1, 255, 16 + 7 };
    const float f = (float)v * (1.0f / 127.0f);
    const bool on = v >= 64;
    if (cc >= 6 && cc <= 21) {
        int k = kn[cc - 6];
        if (k < 16) setP(k, f);
        else if (k < 32) { sec[k - 16] = f; pickS[k - 16] = 1; }
    }
    switch (cc) {
        case 5:  tempoMode = false; setP(5, ((float)(v > 5 ? 5 : v) + 0.5f) * (1.0f / 6.0f)); break;
        case 7:  setP(2, ((float)(v >> 5) + 0.5f) * 0.25f); break;
        case 10: tapBpm = bpmOf(f); tempoKnob = false; break;
        case 20: setP(9, ((float)(v >> 5) + 0.5f) * 0.25f); break;
        case 23: lrevSt = on; break;
        case 24: lpreSt = on; break;
        case 25: lonlySt = on; break;
        case 26: burstSt = on; break;
        case 27: quantSt = on; break;
        case 28: if (lsNow != 1) { if (lsNow != 0) puErase = 3; puRec = 3; holdSt = false; } break;   /* a new take */
        case 29: if (lsNow == 1 || lsNow == 3 || lsNow == 4) puRec = 3; break;
        case 30: if (lsNow == 1 || lsNow == 2 || lsNow == 4) puRec = 3; break;   /* from play; else to play first */
        case 31: if (lsNow >= 1 && lsNow <= 3) puStop = 3; break;
        case 34: puErase = 3; break;
        case 35: puUndo = 3; break;
        case 47: if (fxRev != on) { fxRev = on; popP = 202; popSec = false; popT = 3000; } break;
        case 48: holdSt = on && !loopActive(); break;
        case 93: if (v > 0) doTap(); break;
        case 102: killSt = !on; break;
        default: break;
    }
}

/* MIDI: pedal CCs, Program Change = preset, clock = tempo + beat sync */
MC_COLD void midiTick() {
    kTime = kTime + 1u;
    bool on = clkW > 0u && (uint32_t)(kTime - clkLast) < 1500u;        /* clock seen in the last 0.5 s */
    if (on && !clkWas) { tempoKnob = false; qCnt = 0; }
    clkWas = on;
    if (clkStart) { clkStart = false; qCnt = 0; tempoKnob = false; }
    if (sppNew) { sppNew = false; qCnt = sppQ; }
    if (clkBeat) {
        clkBeat = false;
        uint32_t w = clkW;
        if (w > 24u) {
            uint32_t dt = clkT[(w - 1u) & 31u] - clkT[(w - 25u) & 31u];   /* one quarter note, in k-cycles */
            if (dt >= 600u && dt <= 9000u) {
                float bb = 180000.0f / (float)dt;
                clkBpm = clkBpm > 0.0f ? clkBpm + (bb - clkBpm) * 0.35f : bb;
                float e = clkBpm - tapBpm; if (e < 0.0f) e = -e;
                if (e > tapBpm * 0.004f) tapBpm = clkBpm;
            }
        }
        int per = (!tempoMode && subZone == 0) ? 4 : ((!tempoMode && subZone == 1) ? 2 : 1);
        if (qCnt % per == 0) puSync = 3;
        qCnt++;
    }
    if (mHoldNew) { mHoldNew = false; holdSt = mHold && !loopActive(); }
    if (mKillNew) { mKillNew = false; killSt = mKill; }
    if (mTap) { mTap = false; doTap(); }
    if (mRec) { mRec = false; recPress(); }
    if (mRecUp) { mRecUp = false; recRelease(); }
    if (mUndo) { mUndo = false; puUndo = 3; }
    if (mRevNew) { mRevNew = false; if (fxRev != mRev) { fxRev = mRev; popP = 202; popSec = false; popT = 3000; } }
    if (mStop) { mStop = false; puStop = 3; if (lsNow == 4) holdSt = false; }
    if (mErase) { mErase = false; puErase = 3; }
    if (mPcNew) {
        /* Program Change as in the pedal's chart: 1-4 ARP A-D, 5-8 INTERRUPT, 9-12 BLOCKS, 13-16 GLIDE,
           17-20 SEQ, 21-24 MOSAIC, 25-28 HAZE, 29-32 TUNNEL, 33-36 STRUM, 37-40 PATTERN, 41-44 WARP
           (45-60 are the pedal's user presets: nothing here) */
        mPcNew = false;
        int32_t pc = mPc - 1;
        if (pc >= 0 && pc < 44) { int g = pc >> 2; preset = ((g < 6 ? 5 - g : g) << 2) | (pc & 3); popT = 0; }
    }
    while (cqR != cqW) { uint16_t ev = cq[cqR & 15u]; cqR = cqR + 1u; pedalCC(ev >> 7, ev & 127); }
}

MC_COLD void uiTick(const int32_t *pot, const bool *b, int32_t enc, bool esw) {
    ticks++;
    midiTick();
    tapTick++;
    if (tapTick > 100000) tapTick = 100000;
    /* encoder switch: held = SHIFT, a short tap on its own = REVERSE on/off */
    int e = btn(4, esw);
    if (e == 1) {
        shift = true; shUsed = false;
        for (int i = 0; i < UI_NP; i++) if (hasSec(i)) { pickS[i] = 1; pAtSh[i] = pv[i]; }
    }
    if (e == -1) {
        shift = false;
        for (int i = 0; i < UI_NP; i++) {                 /* only pots turned under SHIFT need picking up again */
            float m = pv[i] - pAtSh[i];
            if (hasSec(i) && (m > 0.015f || m < -0.015f)) pickP[i] = 1;
        }
        if (!shUsed && bHeld[4] < 1200) { fxRev = !fxRev; popP = 202; popSec = false; popT = 3000; }
    }
    if (shift && bHeld[4] >= 1200) shUsed = true;
    if (loopActive()) holdSt = false;
    /* pots */
    for (int i = 0; i < UI_NP; i++) {
        float raw = (float)pot[i] * (1.0f / 134217728.0f);
        raw = raw < 0.0f ? 0.0f : (raw > 1.0f ? 1.0f : raw);
        if (ticks < 30) { pv[i] = raw; pLast[i] = raw; pShow[i] = raw; prim[i] = raw; continue; }
        pv[i] += (raw - pv[i]) * 0.06f;
        float c = pv[i];
        bool s = shift && hasSec(i);
        float *t = s ? &sec[i] : &prim[i];
        uint8_t *pk = s ? &pickS[i] : &pickP[i];
        if (*pk) {
            float a = pLast[i] - *t, d = c - *t;
            if ((a <= 0.0f && d >= 0.0f) || (a >= 0.0f && d <= 0.0f) || (d < 0.015f && d > -0.015f)) *pk = 0;
        }
        bool moved = (c - pShow[i] > 0.012f) || (pShow[i] - c > 0.012f);
        if (!*pk) *t = c;
        if (moved && shift) shUsed = true;               /* any pot turned under SHIFT: not a REVERSE tap */
        if (moved && ticks > 900) {
            pShow[i] = c;
            popP = i; popSec = s; popT = 4500;
            if (i == 5 && !s && tempoMode) tempoKnob = true;
        }
        pLast[i] = c;
    }
    subZone = zoneOf(prim[5], 6, subZone);
    rvZone = zoneOf(prim[9], 4, rvZone);
    lsZone = zoneOf(sec[5], 5, lsZone);
    shZone = zoneOf(prim[2], 4, shZone);
    knobBpm = bpmOf(prim[5]);
    if (popT > 0) popT--;
    /* encoder: preset selection, SHIFT = jump to next effect */
    int32_t d = enc - encLast;
    encLast = enc;
    if (d) {
        if (shift) shUsed = true;
        preset += shift ? d * 4 : d;
        while (preset < 0) preset += 44;
        while (preset >= 44) preset -= 44;
        popT = 0;
    }
    /* buttons */
    int r;
    for (int k = 0; k < 4; k++) if (shift && b[k]) shUsed = true;
    r = btn(0, b[0]);
    if (r == 1) {
        if (shift) tempoMode = !tempoMode;
        else {
            for (int k = 0; k < 3; k++) svInt[k] = tapInt[k];
            svN = tapN; svTick = tapTick; svBpm = tapBpm; svKnob = tempoKnob;
            doTap();
        }
    }
    if (bSt[0] && !bLong[0] && bHeld[0] > 3000 && !shift) {        /* TAP held 1 s = BYPASS (the tap is undone) */
        bLong[0] = 1;
        for (int k = 0; k < 3; k++) tapInt[k] = svInt[k];
        tapN = svN; tapTick = svTick + bHeld[0]; tapBpm = svBpm; tempoKnob = svKnob;
        killSt = !killSt;
    }
    r = btn(1, b[1]);
    if (r == 1) {
        if (shift) { holdMom = !holdMom; holdSt = false; }
        else if (loopActive()) { holdSt = false; popP = 201; popSec = false; popT = 3000; }   /* HOLD not with the looper */
        else if (holdMom) holdSt = true;
        else holdSt = !holdSt;
    }
    if (r == -1 && holdMom) holdSt = false;
    r = btn(2, b[2]);
    if (r == 1) { if (shift) lrevSt = !lrevSt; else recPress(); }
    if (r == -1) recRelease();
    if (bSt[2] && !bLong[2] && bHeld[2] > 3000 && !shift && !burstDown) { bLong[2] = 1; puUndo = 3; }
    r = btn(3, b[3]);
    if (r == 1) { if (shift) lpreSt = !lpreSt; else { puStop = 3; if (lsNow == 4) holdSt = false; } }
    if (bSt[3] && !bLong[3] && bHeld[3] > 3000 && !shift) { bLong[3] = 1; puErase = 3; }
}

MC_COLD void panel_coldInit() {
static const float dprim[UI_NP] = { 0.5f, 0.5f, 0.125f, 1.0f, 0.5f, 0.42f, 0.2f, 0.7f, 0.2f, 0.0f };
for (int i = 0; i < UI_NP; i++) {
    pv[i] = pShow[i] = pLast[i] = 0.0f;
    prim[i] = dprim[i];
    sec[i] = 0.0f;
    pickP[i] = 0; pickS[i] = 1;
}
sec[2] = 0.4f; sec[4] = 0.5f; sec[5] = 0.5f; sec[7] = 0.15f;
shift = false; encLast = 0; preset = 0; ticks = 0;
for (int k = 0; k < 5; k++) { bSt[k] = 0; bRaw[k] = 0; bCnt[k] = 0; bLong[k] = 0; bHeld[k] = 0; }
tapTick = 0; tapN = 0; tapInt[0] = tapInt[1] = tapInt[2] = 1500; tapBpm = 120.0f; knobBpm = 120.0f;
tempoMode = false; tempoKnob = false; holdSt = false; holdMom = false; lrevSt = false; lpreSt = false; holdOut = false;
subZone = 2; rvZone = 0; lsZone = 2; shZone = 0;
lonlySt = attr_lonly != 0; burstSt = attr_lburst != 0; quantSt = attr_lquant != 0;
cqW = 0u; cqR = 0u;
puTap = puRec = puStop = puErase = puUndo = 0;
popP = 0; popT = 0; popSec = false; clipT = 0; dispTick = 0; dLine = 0; blinkT = 0;
killSt = false; auxMode = true; clkWas = false; puSync = 0; qCnt = 0; clkBpm = 0.0f;
for (int k = 0; k < 3; k++) svInt[k] = 1500;
svN = 0; svTick = 0; svBpm = 120.0f; svKnob = false;
kTime = 0u; clkW = 0u; clkLast = 0u; clkPos = 0; clkDev = -1; mPc = 0;
for (int k = 0; k < 32; k++) clkT[k] = 0u;
clkBeat = clkStart = sppNew = mHold = mHoldNew = mKill = mKillNew = mTap = mRec = mStop = mErase = mPcNew = false;
sppQ = 0; inMode = 1; oMono = 0;
fxRev = false; shUsed = false; burstDown = false; lsNow = 0;
for (int i = 0; i < UI_NP; i++) pAtSh[i] = 0.0f;
mRecUp = mUndo = mRev = mRevNew = false;
popP = 200; popSec = false; popT = 7500;                  /* start-up screen */
for (int n = 0; n < 4; n++) drawLine(n, 0, 0, 0);
}

/* ---- the variations' page (VARIAZIONI beside this effect): while it is on the knobs and the buttons are theirs ---- */
bool pgWas;
/* the page is on: MIDI, the clock and the screen go on, the knobs and the buttons are left alone */
MC_COLD void pgFrozen(int32_t enc) {
    ticks++;
    midiTick();
    tapTick++;
    if (tapTick > 100000) tapTick = 100000;
    if (loopActive()) holdSt = false;
    subZone = zoneOf(prim[5], 6, subZone);
    rvZone = zoneOf(prim[9], 4, rvZone);
    lsZone = zoneOf(sec[5], 5, lsZone);
    shZone = zoneOf(prim[2], 4, shZone);
    knobBpm = bpmOf(prim[5]);
    if (popT > 0) popT--;
    encLast = enc;
    shift = false;
}
/* back: every knob takes its value back when it passes it (pick-up); the buttons and the encoder switch start from
   where they are (no press, no long press, no REVERSE) */
MC_COLD void pgResume(const int32_t *pot, const bool *b, bool esw) {
    for (int i = 0; i < UI_NP; i++) {
        float raw = (float)pot[i] * (1.0f / 134217728.0f);
        raw = raw < 0.0f ? 0.0f : (raw > 1.0f ? 1.0f : raw);
        pv[i] = pLast[i] = pShow[i] = raw;
        float d = raw - prim[i];
        pickP[i] = (d > 0.015f || d < -0.015f) ? 1 : 0;
        if (hasSec(i)) pickS[i] = 1;
    }
    for (int k = 0; k < 4; k++) { uint8_t r = b[k] ? 1 : 0; bRaw[k] = bSt[k] = r; bCnt[k] = 12; bHeld[k] = 0; bLong[k] = 1; }
    bRaw[4] = bSt[4] = esw ? 1 : 0; bCnt[4] = 12; bHeld[4] = 2000; shUsed = true;
}
#undef MC_COLD
]]></code.declaration>
         <code.init><![CDATA[
panel_coldInit();

pgWas = false;
]]></code.init>
         <code.krate><![CDATA[{
    int32_t pots[UI_NP] = { inlet_p1, inlet_p2, inlet_p3, inlet_p4, inlet_p5,
                            inlet_p6, inlet_p7, inlet_p8, inlet_p9, inlet_p10 };
    bool bs[4] = { inlet_b1, inlet_b2, inlet_b3, inlet_b4 };
    auxMode = inlet_aux; inMode = inlet_inmode; oMono = inlet_omono; lsNow = inlet_lstate;
    if (inlet_page) pgFrozen(inlet_enc);
    else { if (pgWas) pgResume(pots, bs, inlet_esw); uiTick(pots, bs, inlet_enc, inlet_esw); }
    pgWas = inlet_page != 0;

    const float F = 134217727.0f;
    float bl = 2880000.0f / (bpmNow() * subMult());
    if (bl < 1440.0f) bl = 1440.0f;
    if (bl > 192000.0f) bl = 192000.0f;
    outlet_beat = (int32_t)bl;
    outlet_algo = mcAlgo(preset >> 2);
    outlet_var = preset & 3;
    outlet_act = (int32_t)(prim[0] * F);
    outlet_rep = (int32_t)(prim[1] * F);
    outlet_shp = (int32_t)(((float)shZone + 0.5f) * 0.25f * F);   /* middle of the SHAPE zone */
    outlet_flt = (int32_t)(prim[3] * F);
    outlet_mix = (int32_t)(prim[4] * F);
    outlet_spc = (int32_t)(prim[6] * F);
    outlet_llev = (int32_t)(prim[7] * F);
    outlet_res = (int32_t)(prim[8] * F);
    outlet_rmode = rvZone;
    outlet_mdep = (int32_t)(sec[1] * F);
    outlet_mrate = (int32_t)(sec[2] * F);
    outlet_fxv = (int32_t)(sec[4] * F);
    outlet_lfade = (int32_t)(sec[7] * F);
    outlet_lspd = (int32_t)(loopSpeed() * 65536.0f + 0.5f);
    outlet_tap = puTap > 0;
    outlet_sync = puSync > 0;
    if (puSync > 0) puSync--;
    outlet_kill = killSt;
    outlet_lrec = puRec > 0;
    outlet_lstop = puStop > 0;
    outlet_lerase = puErase > 0;
    outlet_lundo = puUndo > 0;
    if (puTap > 0) puTap--;
    if (puRec > 0) puRec--;
    if (puStop > 0) puStop--;
    if (puErase > 0) puErase--;
    if (puUndo > 0) puUndo--;
    outlet_hold = holdSt;
    outlet_lrev = lrevSt;
    outlet_lpre = lpreSt;
    outlet_frev = fxRev;
    outlet_lshape = attr_lfade;
    outlet_qlen = quantSt ? (int32_t)(2880000.0f / bpmNow() + 0.5f) : 0;   /* one quarter note */
    outlet_lonly = lonlySt;

    /* OLED: redraw one line every 40 k-cycles */
    if (++dispTick >= 40) {
        dispTick = 0;
        drawLine(dLine, inlet_lstate, inlet_lpos, inlet_llen);
        dLine = (dLine + 1) & 3;
    }
    outlet_l1 = &ln[0][0];
    outlet_l2 = &ln[1][0];
    outlet_l3 = &ln[2][0];
    outlet_l4 = &ln[3][0];

    /* LEDs (max value kept below the LED1 software-PWM wrap) */
    const int32_t LM = 0x7F80000;
    blinkT = (blinkT + 1) % 750;
    outlet_led1 = inlet_beatp ? LM : 0;
    float pk = (float)inlet_peak * (1.0f / 134217728.0f);
    if (pk > 0.89f) clipT = 600;
    if (clipT > 0) clipT--;
    if (killSt || clipT > 0) outlet_led2 = LM;
    else outlet_led2 = (int32_t)(pk * pk * 0.6f * (float)LM);
    int32_t ls = inlet_lstate;
    bool nearEnd = (ls == 1) && (inlet_llen > (MCUI_LOOPMS - 5000));
    int32_t r3 = 0, b3 = 0;
    if (ls == 1) r3 = (nearEnd && blinkT > 375) ? 0 : LM;
    if (ls == 2) b3 = LM;
    if (ls == 3) { r3 = LM; b3 = LM; }
    if (ls == 4) b3 = LM / 8;
    outlet_led3r = r3;
    outlet_led3b = b3;
    outlet_led4b = holdSt ? LM : 0;
    outlet_led4r = shift ? LM : 0;
}
]]></code.krate>
         <code.midihandler><![CDATA[{
    /* runs in the MIDI thread: only flags and timestamps, the k-rate code applies them */
    if (status >= 0xF0) {                         /* system: clock slave (attribute clock) */
        if (attr_clock == 0) return;
        /* one port owns the clock (MIDI IN, USB from the computer, USB host): the first that
           sends it keeps it until it is silent for 0.5 s, so the same clock arriving on two
           ports is not counted twice */
        if (status == 0xF8 || status == 0xFA || status == 0xF2) {
            if (clkW > 0u && (uint32_t)(kTime - clkLast) < 1500u && (int32_t)dev != clkDev) return;
            clkDev = (int32_t)dev;
        }
        if (status == 0xF8) {                     /* clock, 24 per quarter note */
            uint32_t w = clkW;
            clkT[w & 31u] = kTime;
            clkW = w + 1u;
            clkLast = kTime;
            int32_t p = clkPos + 1;
            if (p >= 24) p = 0;
            clkPos = p;
            if (p == 0) clkBeat = true;
        } else if (status == 0xFA) {              /* start: the next clock is beat 1 */
            clkPos = 23; clkStart = true;
        } else if (status == 0xF2) {              /* song position (16ths): continue from there */
            int32_t pos = (int32_t)data1 | ((int32_t)data2 << 7);
            clkPos = (pos * 6 + 23) % 24;
            sppQ = (pos + 3) / 4; sppNew = true;
        }
        return;
    }
    if (attr_midich > 0 && (int32_t)(status & 0x0F) != attr_midich - 1) return;   /* channel filter */
    uint8_t st = status & 0xF0;
    if (st == 0xB0) {
        bool on = data2 >= 64;
        if (data1 == 64) { mHold = on; mHoldNew = true; }          /* sustain pedal = HOLD */
        else if (data1 == 80) { mKill = on; mKillNew = true; }     /* BYPASS with trails */
        else if (data1 == 85) { mRev = on; mRevNew = true; }       /* REVERSE */
        else if (data1 == 81 && !on) mRecUp = true;                 /* release: ends a BURST take */
        else if (data1 >= 81 && data1 <= 86) {
            if (!on) return;
            if (data1 == 81) mRec = true;                           /* looper rec / play / dub */
            else if (data1 == 82) mTap = true;                      /* tap tempo */
            else if (data1 == 83) mStop = true;                     /* looper stop / play */
            else if (data1 == 84) mErase = true;                    /* looper erase */
            else if (data1 == 86) mUndo = true;                     /* looper undo */
        }
        else if ((data1 >= 5 && data1 <= 35) || data1 == 47 || data1 == 48 || data1 == 93 || data1 == 102) {
            uint32_t w = cqW;                                       /* the pedal's own CC chart */
            if (w - cqR < 16u) { cq[w & 15u] = (uint16_t)(((uint32_t)data1 << 7) | (data2 & 127u)); cqW = w + 1u; }
        }
    } else if (st == 0xC0) { mPc = data1; mPcNew = true; }          /* preset, numbered as on the pedal */
}
]]></code.midihandler>
      </object>
   </patchobj>
   <patchobj type="patch/object" uuid="060c6f31-af80-555a-bfb1-68e7de4f3838" name="microcosm" x="330" y="160">
      <params/>
