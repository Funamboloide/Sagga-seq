            <frac32.positive name="lfade" description="looper fade time"/>
            <int32 name="lspd" description="looper speed, 65536 = 1x"/>
            <bool32 name="lrec" description="looper rec/play/dub"/>
            <bool32 name="lstop" description="looper stop/play"/>
            <bool32 name="lerase" description="looper erase"/>
            <bool32 name="lundo" description="looper undo overdubs"/>
            <bool32 name="lrev" description="looper reverse"/>
            <bool32 name="lpre" description="looper pre-FX routing"/>
            <bool32 name="sync" description="MIDI clock beat: snap the rhythm grid"/>
            <bool32 name="kill" description="bypass with trails: input muted, tails keep ringing"/>
            <bool32 name="frev" description="REVERSE: effect voices and delay taps play backwards"/>
            <int32 name="lshape" description="looper fade shape 0 in+out 1 in only 2 out only"/>
            <int32 name="qlen" description="looper quantize: quarter note in samples, 0 = off"/>
            <bool32 name="lonly" description="looper only: effect and Space bypassed"/>
         </inlets>
