         <includes/>
         <code.declaration><![CDATA[/* =====================================================================
   mc_dsp  -  "Microcosm"-style engine for Ksoloti Gills
   11 effects x 4 variations, hold sampler, LP filter, mix,
   Space reverb (plate, 4 modes), 60 s phrase looper with overdub/undo.
   Big buffers live in SDRAM. No libm, float math only.
   ===================================================================== */
#define MC_LOOP_SECONDS 60
#ifndef MC_COLD
#ifdef __clang__
#define MC_COLD __attribute__((noinline, minsize))
#else
#define MC_COLD __attribute__((noinline, optimize("Os")))
#endif
#endif
/* the big audio functions: -O2 instead of the patcher's -O3 (GCC), which here mostly makes the code
   larger (loops cloned and peeled). Nothing that runs per sample is built for size. */
#ifndef MC_HOT
#ifdef __clang__
#define MC_HOT
#define MC_SMALL
#else
#define MC_HOT __attribute__((noinline, optimize("O2")))
#define MC_SMALL __attribute__((noinline, optimize("O2")))
#endif
#endif

enum { MC_NV = 8, MC_NT = 6, MC_NO = 8, MC_XSEAM = 480 };

static const uint32_t MC_HMASK = (1u << 19) - 1u;   /* history / delay: 2^19 frames = 10.9 s */
static const uint32_t MC_LMAX  = 48000u * MC_LOOP_SECONDS;

struct MCVoice {
    uint32_t pos, seg0, segLen, xf;     /* Q13 positions in the history */
    int32_t  rate;                      /* Q13 increment per sample */
    int32_t  life, life0;               /* remaining / total output samples */
    float    g, gl, gr, env, decay, kg, xfi, rbase;
    float    fa1, fa2, fa3, fk, f0, flog, s1l, s2l, s1r, s2r;
    float    hl, hr, cq, lk, ll, lr;     /* lk, ll, lr: SHAPE filter contour (one-pole low-pass) */
    int16_t  cd, cc;
    uint8_t  on, ft, contour, kill, slot, gl2, rv, cw, sh; /* rv: spawned by the REVERSE switch; cw: 1 HAZE grain,
                                                               2 loop that also fades over its life; sh: contour
                                                               0 square, 1 ramp, 2 triangle, 3 saw */
};

/* ---------- memory ---------- */
uint32_t *hist;          /* input history, packed stereo int16 */
uint32_t *dly;           /* multidelay line, packed stereo int16 */
uint32_t *lb, *ld;       /* looper base layer, overdub layer */



/* ---------- engine state ---------- */
MCVoice  vo[MC_NV];
uint32_t hw;             /* history write index (next frame) */
uint32_t rng;
int32_t  algo, var, beat;
float    act, rep, shp;  /* shp = 10 + shI: the contour a new voice gets from SHAPE (a voice with a fixed contour
                            asks for 10 square, 11 ramp, 12 triangle or 13 saw itself) */
int32_t  shI;            /* SHAPE, as on the pedal: 0 square, 1 ramp, 2 triangle, 3 saw */
float    wetL[16], wetR[16], fbL[16], fbR[16];
float    xL[16], xR[16];
int32_t  stepCnt, stepIdx, barIdx, beatCnt, beatPulse, slotWait[MC_NV];
float    lfoPh, lfoVal, modDep, modRate, glPh, tunPh, wrpPh;   /* wrpPh: WARP D crossfade, a quarter of the LFO speed */
/* onsets */
float    envF, envS, envFol;
uint32_t onPos[MC_NO];
int32_t  onCount, onHead, onSince, onNew;
/* hold */
bool     holdOn;
float    holdMix;
uint32_t holdLen;
/* sequencer / glitch scratch */
uint8_t  perm[16], gate[16];
uint32_t anchor;
float    chainG;
int32_t  chainIdx, burstLeft, burstCnt, burstOn, burstStep, intLeft, intCnt;
uint32_t intSrc;
float    duck, duckT, hazeAcc, hazeFb, hazeLag;
/* multidelay */
float    tD[MC_NT], tT[MC_NT], tG[MC_NT], tPan[MC_NT], tPh[MC_NT], tPr[MC_NT];
float    tS1[MC_NT], tS2[MC_NT], tS3[MC_NT], tS4[MC_NT];
float    fbD, fbT, dfb, dLpL, dLpR, dDcL, dDcR, dGain, dGainT;
int32_t  nTap;
/* filter + mix */
float    fCut, fRes, fS1l, fS2l, fS1r, fS2r, fWet, mixS, fxvS, spcS, llevS;
/* reverb (SPACE plate and echo, see below) */
int32_t  rvMode, seFree;
float    rvFade, rvTrim, rvTrim0;   /* rvTrim0: level of the plate alone (echo off) */
float    *eb, eTgL, eTgR, eOfL, eOfR, eLpL, eLpR, eSubL, eSubR, eFbk, eK, eMix, eSnd;
uint32_t ew;
/* looper */
int32_t  lst, llen, lrw, ltail, lclr, lspd;
int64_t  lpos;
float    lgain, lgt, lstep, lfadeT;
bool     lfast, dInit, ldubOn, lrevS, lpreS, pRec, pStop, pErase, pUndo, pTap, pHold;
int32_t  lshape, qlenS, lqEnd;        /* fade shape 0 in+out 1 in 2 out; quantize length; pending quantized end */
bool     lqPlay, lonlyS, fxRev, dRev;  /* looper only; effect reverse (voices / delay taps) */
/* live: bypass with trails (input gain), clock sync */
float    inG;
bool     pSync, syncReq;
float    lpL[16], lpR[16];
uint32_t lIdx[16];
float    peakV;

/* ---------- helpers ---------- */
/* small and used once per sample: always expanded in place, also inside the size-optimized functions */
#define MC_INL inline __attribute__((always_inline))
static MC_INL float mc_lo(uint32_t w) { return (float)(int16_t)(w & 0xFFFFu) * (1.0f / 32768.0f); }
static MC_INL float mc_hi(uint32_t w) { return (float)(int16_t)(w >> 16) * (1.0f / 32768.0f); }
static MC_INL float mc_clip1(float x) { return x > 0.999f ? 0.999f : (x < -0.999f ? -0.999f : x); }
static MC_INL uint32_t mc_pack(float l, float r) {
    int32_t a = (int32_t)(mc_clip1(l) * 32767.0f);
    int32_t b = (int32_t)(mc_clip1(r) * 32767.0f);
    return ((uint32_t)a & 0xFFFFu) | ((uint32_t)b << 16);
}
static MC_INL float mc_soft(float x) {           /* gentle limiter, |y| < 1.25 */
    float a = x < 0.0f ? -x : x;
    if (a <= 0.75f) return x;
    float y = 0.75f + (a - 0.75f) / (1.0f + (a - 0.75f) * 2.0f);
    return x < 0.0f ? -y : y;
}
MC_COLD static float mc_exp2(float x) {
    if (x < -40.0f) x = -40.0f;
    if (x > 40.0f) x = 40.0f;
    int32_t i = (int32_t)x;
    if ((float)i > x) i--;
    float f = x - (float)i;
    float p = 1.0f + f * (0.6931472f + f * (0.2402265f + f * (0.0555041f + f * 0.0096181f)));
    union { float f; int32_t i; } u;
    u.f = p;
    u.i += (int32_t)((uint32_t)i << 23);
    return u.f;
}
static inline float mc_tanpi(float x) {          /* tan(pi*x), x in [0, 0.45] */
    float w = 3.14159265f * x;
    float w2 = w * w;
    return w * (15.0f - w2) / (15.0f - 6.0f * w2);
}
static inline float mc_sin1(float ph) {          /* ~sin(2 pi ph), any ph >= 0 */
    ph -= (float)(int32_t)ph;
    float t = ph < 0.25f ? 4.0f * ph : (ph < 0.75f ? 2.0f - 4.0f * ph : 4.0f * ph - 4.0f);
    return t * (1.5f - 0.5f * t * t);
}
MC_COLD uint32_t mc_rand() { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
MC_COLD float mc_rf() { return (float)(mc_rand() >> 8) * (1.0f / 16777216.0f); }
static MC_INL float mc_ramp(float a, float b, float k) { return a + (b - a) * k; }

/* TUNNEL: how a drone fades over its life (quick start, then a curve between a square and a fourth power) */
MC_COLD static float mc_tunDecay(float ph) {
    if (ph <= 0.0f || ph >= 1.0f) return 0.0f;
    const float a = 0.04368f;
    if (ph < a) { float x = ph * (1.0f / a); return x * x * (3.0f - 2.0f * x); }
    float y = 1.0f - (ph - a) * (1.0f / (1.0f - a)), y2 = y * y;
    float e = y2 * (0.72f + 0.28f * y2);
    if (ph > 0.9f) { float z = (1.0f - ph) * 10.0f; e *= z * z * (3.0f - 2.0f * z); }
    return e;
}

/* SHAPE: the four contours of the pedal (square, ramp, triangle, saw), applied to every grain
   or to every turn of a micro loop. a, r: attack and release fades as fractions (mf = longest).
   bell: HAZE grains take a Hann bell for the triangle, the smoothest cloud (after the grain
   windows of Mutable Instruments Clouds, MIT licence, (c) 2014 Emilie Gillet). */
MC_COLD static float mc_shWin(float ph, int sh, float mf, bool bell) {
    if (ph <= 0.0f || ph >= 1.0f) return 0.0f;
    float e = 1.0f, a = 0.0f, r = 0.0f;
    if (sh == 1) { e = ph; r = mf < 0.03f ? mf : 0.03f; }
    else if (sh == 2) {
        if (bell) { float sn = mc_sin1(ph * 0.5f); e = sn * sn; }
        else e = 1.0f - 2.0f * (ph < 0.5f ? 0.5f - ph : ph - 0.5f);
    }
    else if (sh == 3) { e = 1.0f - ph; a = mf < 0.015f ? mf : 0.015f; }
    else { a = mf; r = mf; }
    if (a > 0.0f && ph < a) { float x = ph / a; e *= x * x * (3.0f - 2.0f * x); }
    if (r > 0.0f && ph > 1.0f - r) { float z = (1.0f - ph) / r; e *= z * z * (3.0f - 2.0f * z); }
    return e;
}

/* TPT state-variable filter coefficients */
MC_COLD static void mc_svf(float fc, float k, float &a1, float &a2, float &a3) {
    float x = fc * (1.0f / 48000.0f);
    if (x < 0.0004f) x = 0.0004f;
    if (x > 0.45f) x = 0.45f;
    float g = mc_tanpi(x);
    a1 = 1.0f / (1.0f + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
}

/* ---------- voices ---------- */
MC_COLD void mc_killAll() { for (int i = 0; i < MC_NV; i++) if (vo[i].on) vo[i].kill = 1; }

/* back: frames behind the write head; rate: playback speed; life: output samples */
MC_COLD MCVoice *mc_spawn0(uint32_t back, float rate, int32_t life, float gain, float pan, float shape) {
    int i;
    for (i = 0; i < MC_NV; i++) if (!vo[i].on) break;
    if (i == MC_NV || life < 64) return 0;
    MCVoice &v = vo[i];
    if (rate > 1.0f) {
        uint32_t need = (uint32_t)((rate - 1.0f) * (float)life) + 96u;
        if (back < need) back = need;
    }
    if (back < 2u) back = 2u;
    if (back > MC_HMASK - 8192u) back = MC_HMASK - 8192u;
    v.pos = (hw - back) << 13;
    v.rbase = rate;
    v.rate = (int32_t)(rate * 8192.0f);
    v.seg0 = v.pos; v.segLen = 0; v.xf = 0; v.xfi = 0.0f;
    v.life = life; v.life0 = life;
    { int32_t s = (int32_t)(shape - 9.5f); v.sh = (uint8_t)(s < 0 ? 0 : (s > 3 ? 3 : s)); }
    if (v.sh) gain *= 1.25f;                            /* ramp, triangle, saw: make-up */
    v.g = gain; v.env = 0.0f; v.decay = 1.0f; v.kg = 1.0f;
    v.lk = v.sh ? 0.04f : 1.0f; v.ll = v.lr = 0.0f;
    if (pan > 1.0f) pan = 1.0f;
    if (pan < -1.0f) pan = -1.0f;
    v.gl = pan > 0.0f ? 1.0f - pan * 0.8f : 1.0f;
    v.gr = pan < 0.0f ? 1.0f + pan * 0.8f : 1.0f;
    v.ft = 0; v.cd = 0; v.cc = 0; v.contour = 0; v.kill = 0; v.slot = 255; v.rv = 0; v.cw = 0;
    v.s1l = v.s2l = v.s1r = v.s2r = 0.0f; v.hl = v.hr = 0.0f;
    v.on = 1;
    return &v;
}
/* REVERSE: the same stretch of history is played backwards (window and filter sweep reversed too).
   A forward grain whose end is not recorded yet is moved back in time by its own length. */
MC_COLD MCVoice *mc_spawn(uint32_t back, float rate, int32_t life, float gain, float pan, float shape) {
    if (!fxRev) return mc_spawn0(back, rate, life, gain, pan, shape);
    float ar = rate < 0.0f ? -rate : rate;
    uint32_t span = (uint32_t)(ar * (float)life);
    if (rate > 0.0f) { if (back < span + 96u) back = span + 96u; back -= span; }
    else back += span;
    const uint32_t lim = MC_HMASK - 8192u;
    if (back > lim) back = lim;
    if (rate > 0.0f) {                                  /* read head moves away from the write head */
        uint32_t room = lim - back;
        float mx = (float)room / (ar + 1.0f);
        if ((float)life > mx) life = (int32_t)mx;
    }
    MCVoice *v = mc_spawn0(back, -rate, life, gain, pan, shape);
    if (v) v->rv = 1;
    return v;
}
/* make the voice loop a segment of len frames, with crossfade */
MC_COLD static void mc_setLoop(MCVoice *v, uint32_t len, int contour) {
    if (len < 256u) len = 256u;
    uint32_t xf = len / 8u;
    if (xf > 240u) xf = 240u;
    v->segLen = len << 13;
    v->xf = xf << 13;
    v->xfi = 1.0f / (float)(xf << 13);
    v->seg0 = v->pos;
    v->contour = (uint8_t)contour;
}
/* persistent looping voice: segment of len frames ending 'gap' frames before the write head */
MC_COLD MCVoice *mc_spawnLoop(uint32_t len, uint32_t gap, float rate, int32_t life, float gain, float pan, float shape, int contour) {
    MCVoice *v = mc_spawn0(len + gap, 1.0f, life, gain, pan, shape);
    if (!v) return 0;
    mc_setLoop(v, len, contour);
    if (fxRev) { rate = -rate; v->rv = 1; v->pos = v->seg0 + v->segLen - 1u; }
    v->rbase = rate;
    v->rate = (int32_t)(rate * 8192.0f);
    return v;
}
/* REVERSE switched while playing: looping voices turn around in place (no jump), one-shots finish */
MC_COLD void mc_flipLoops() {
    for (int i = 0; i < MC_NV; i++) {
        MCVoice &v = vo[i];
        if (!v.on || !v.segLen || v.kill) continue;
        v.rbase = -v.rbase; v.rate = -v.rate; v.rv ^= 1;
    }
}
MC_COLD static void mc_setFilt(MCVoice *v, int type, float f0, float f1, float q) {
    v->ft = (uint8_t)type;
    v->f0 = f0;
    float r = f1 / f0;
    float lg = 0.0f;                      /* log2 approximation good enough for sweeps */
    union { float f; int32_t i; } u; u.f = r;
    lg = (float)((u.i >> 23) & 255) - 127.0f;
    u.i = (u.i & 0x007FFFFF) | 0x3F800000;
    lg += (u.f - 1.0f) * (1.3466f - 0.3466f * u.f);
    v->flog = lg;
    v->fk = 1.0f / q;
}
MC_COLD static void mc_setCrush(MCVoice *v, int dec, int bits) {
    v->cd = (int16_t)dec;
    v->cc = 0;
    v->cq = (float)(1 << (bits - 1));
}

MC_HOT void mc_render(MCVoice &v, float *aL, float *aR) {
    int32_t lifeEnd = v.life - 16;
    float eT = 0.0f;
    if (lifeEnd > 0) {
        if (v.contour && v.segLen) {
            float ip = (float)(v.pos - v.seg0) / (float)v.segLen;
            eT = mc_shWin(ip, v.sh, v.sh ? 0.03f : 0.0f, false);
            float fi = (float)(v.life0 - lifeEnd) * (1.0f / 384.0f); if (fi < 1.0f) eT *= fi;
            float fo = (float)lifeEnd * (1.0f / 384.0f); if (fo < 1.0f) eT *= fo;
        } else {
            float ph = (float)lifeEnd / (float)v.life0;          /* reversed one-shot grains: window reversed too; */
            float wp = (v.rv && !v.segLen) ? ph : 1.0f - ph;     /* loops keep their life envelope */
            eT = mc_shWin(wp, v.sh, v.cw ? 0.02f : 0.1f, v.cw != 0);
        }
    }
    /* ramp, triangle and saw also move a gentle low-pass with the contour (SHAPE works on "the volume
       or filter characteristics"): open at the top of the contour, dark where it is low */
    const bool lpOn = v.sh != 0;
    const float kT = lpOn ? 0.04f + 0.96f * eT * eT * eT : 1.0f;
    float lk = v.lk, ll = v.ll, lr = v.lr;
    const float dk = (kT - lk) * (1.0f / 16.0f);
    v.lk = kT;
    if (v.cw == 2 && lifeEnd > 0) eT *= mc_tunDecay(1.0f - (float)lifeEnd / (float)v.life0);
    if (v.kill) { v.kg -= 0.08f; if (v.kg < 0.0f) v.kg = 0.0f; }
    eT *= v.g * v.kg;
    float e = v.env, de = (eT - e) * (1.0f / 16.0f);
    v.env = eT;
    float a1 = 0.0f, a2 = 0.0f, a3 = 0.0f, fk = v.fk;
    if (v.ft) {
        float ph = (float)v.life / (float)v.life0;
        if (!v.rv || v.segLen) ph = 1.0f - ph;
        mc_svf(v.f0 * mc_exp2(ph * v.flog), fk, a1, a2, a3);
    }
    float s1l = v.s1l, s2l = v.s2l, s1r = v.s1r, s2r = v.s2r, hl = v.hl, hr = v.hr;
    int32_t cc = v.cc;
    const int32_t cd = v.cd;
    const float cq = v.cq, cqi = cd ? 1.0f / cq : 0.0f, gl = v.gl, gr = v.gr;
    const uint32_t *h = hist;
    const uint32_t sl = v.segLen, s0 = v.seg0, xz = v.segLen - v.xf;
    const uint32_t r = (uint32_t)v.rate;
    const bool bk = v.rate < 0;                         /* backwards: the seam is at the segment start */
    const uint32_t s1 = bk ? s0 + sl : s0, jo = bk ? sl : 0u - sl;
    const float xfi = v.xfi;
    uint32_t p = v.pos;
    float g = v.g, dec = v.decay;
    for (int i = 0; i < 16; i++) {
        uint32_t ix = p >> 13;
        float fr = (float)(p & 8191u) * (1.0f / 8192.0f);
        uint32_t w0 = h[ix & MC_HMASK], w1 = h[(ix + 1u) & MC_HMASK];
        float l0 = mc_lo(w0), r0 = mc_hi(w0);
        float l = l0 + fr * (mc_lo(w1) - l0);
        float rr = r0 + fr * (mc_hi(w1) - r0);
        if (sl) {
            uint32_t off = bk ? s1 - p : p - s1;
            if (off >= xz) {
                float t = (float)(off - xz) * xfi;
                uint32_t jx = (p + jo) >> 13;
                uint32_t u0 = h[jx & MC_HMASK], u1 = h[(jx + 1u) & MC_HMASK];
                float m0 = mc_lo(u0), n0 = mc_hi(u0);
                float ml = m0 + fr * (mc_lo(u1) - m0), mr = n0 + fr * (mc_hi(u1) - n0);
                l += t * (ml - l);
                rr += t * (mr - rr);
            }
        }
        if (a2 != 0.0f) {
            float v3 = l - s2l, v1 = a1 * s1l + a2 * v3, v2 = s2l + a2 * s1l + a3 * v3;
            s1l = 2.0f * v1 - s1l; s2l = 2.0f * v2 - s2l;
            float u3 = rr - s2r, u1 = a1 * s1r + a2 * u3, u2 = s2r + a2 * s1r + a3 * u3;
            s1r = 2.0f * u1 - s1r; s2r = 2.0f * u2 - s2r;
            if (v.ft == 1) { l = v2; rr = u2; } else { l = v1 * fk * 1.6f; rr = u1 * fk * 1.6f; }
        }
        if (cd) {
            if (--cc <= 0) {
                cc = cd;
                hl = (float)(int32_t)(l * cq) * cqi;
                hr = (float)(int32_t)(rr * cq) * cqi;
            }
            l = hl; rr = hr;
        }
        if (lpOn) { lk += dk; ll += lk * (l - ll); l = ll; lr += lk * (rr - lr); rr = lr; }
        e += de;
        aL[i] += l * e * gl;
        aR[i] += rr * e * gr;
        p += r;
        if (sl && (p - s0) >= sl) { p += jo; g *= dec; }
    }
    v.pos = p; v.g = g;
    v.s1l = s1l; v.s2l = s2l; v.s1r = s1r; v.s2r = s2r; v.hl = hl; v.hr = hr; v.cc = (int16_t)cc;
    v.ll = ll; v.lr = lr;
    v.life -= 16;
    if (v.life <= 0 || (v.kill && v.kg <= 0.0f)) v.on = 0;
}

/* ---------- onsets ---------- */
MC_COLD uint32_t mc_onset(int k) {              /* k = 0 latest, 1 previous ... */
    if (onCount <= 0) return 0;
    if (k >= onCount) k = k % onCount;
    int idx = onHead - 1 - k;
    while (idx < 0) idx += MC_NO;
    return onPos[idx];
}
uint32_t mc_backOf(uint32_t absFrame) { return (hw - absFrame) & MC_HMASK; }

/* ---------- tempo helpers ---------- */
MC_COLD int32_t mc_beatFit(float beats) {        /* beat length scaled so beats*beat fits in 10 s */
    float b = (float)beat;
    while (b * beats > 470000.0f) b *= 0.5f;
    return (int32_t)b;
}

/* ---------- scheduler ---------- */
MC_COLD void mc_resetSched() {
    stepCnt = 0; stepIdx = 0; barIdx = 0; chainG = 0.0f; chainIdx = 0;
    burstLeft = 0; burstCnt = 0; burstOn = 0; intLeft = 0; intCnt = 0;
    duckT = 0.0f; hazeAcc = 0.0f; hazeLag = 0.0f; glPh = 0.0f; tunPh = 0.0f;
    for (int i = 0; i < MC_NV; i++) slotWait[i] = i * 2400;
    for (int i = 0; i < 16; i++) { perm[i] = (uint8_t)(i & 7); gate[i] = 1; }
    anchor = hw;
}

MC_COLD void mc_newPattern() {
    for (int i = 0; i < 16; i++) perm[i] = (uint8_t)(mc_rand() & 7u);
    for (int i = 0; i < 16; i++) gate[i] = (uint8_t)((i & 1) ? (mc_rf() < 0.25f) : (mc_rf() < 0.8f));
    gate[0] = 1;
}

/* MOSAIC / GLIDE / TUNNEL use voice slots 0..n-1 as persistent loopers */
MC_COLD MCVoice *mc_slotVoice(int k) {
    for (int i = 0; i < MC_NV; i++) if (vo[i].on && vo[i].slot == k && !vo[i].kill) return &vo[i];
    return 0;
}

MC_COLD void mc_schedMosaic() {
    static const float sp[4][4] = { {1.0f, 2.0f, 1.0f, 2.0f}, {1.0f, 0.5f, 1.0f, 0.5f},
                                    {2.0f, 2.0f, 2.0f, 2.0f}, {0.5f, 1.0f, 2.0f, 4.0f} };
    static const float lm[6] = { 1.0f, 0.5f, 0.5f, 1.0f, 0.25f, 0.5f };
    int n = 1 + (int)(act * 5.99f);
    for (int k = 0; k < MC_NV; k++) {
        MCVoice *v = mc_slotVoice(k);
        if (k >= n) { if (v) v->kill = 1; continue; }
        if (v) continue;
        if (slotWait[k] > 0) { slotWait[k] -= 16; continue; }
        float s = sp[var & 3][k & 3];
        uint32_t len = (uint32_t)((float)mc_beatFit(1.0f) * lm[k]);
        if (len > 96000u) len = 96000u;
        if (len < 1200u) len = 1200u;
        int iters = 1 + (int)(rep * rep * 15.0f);
        int32_t life = (int32_t)((float)len / s) * iters;
        float pan = (k & 1 ? 1.0f : -1.0f) * (0.15f + 0.12f * (float)k);
        MCVoice *nv = mc_spawnLoop(len, 300u, s, life, 1.1f / (1.0f + 0.3f * (float)(n - 1)), pan, shp, 1);
        if (!nv) continue;
        nv->slot = (uint8_t)k;
        nv->decay = 0.55f + 0.45f * rep;
        slotWait[k] = 0;
    }
}

MC_COLD void mc_schedSeq() {
    int32_t step = mc_beatFit(4.0f) / 4;             /* sixteenth notes */
    if (step < 600) step = 600;
    if (syncReq) stepCnt = stepCnt > step / 2 ? step - 16 : 0;
    stepCnt += 16;
    if (stepCnt < step) return;
    stepCnt -= step;
    int j = stepIdx & 15;
    if (j == 0) {
        int nb = 1 + (int)(rep * 3.99f);
        if (rep < 0.08f || (barIdx % nb) == 0) { anchor = hw - (uint32_t)(step * 8) - 480u; mc_newPattern(); }
        barIdx++;
    }
    stepIdx++;
    uint32_t slice = (uint32_t)step;
    int on = gate[j];
    if (var == 3 && !on && (j & 1) && mc_rf() < act) on = 1;     /* interlocking layer */
    if (!on) return;
    if (rep < 0.08f || (hw - anchor) > 400000u) anchor = hw - (uint32_t)(step * 8) - 480u;
    uint32_t start = anchor + slice * perm[j];
    uint32_t back = mc_backOf(start);
    float rate = 1.0f, lifeMul = 0.95f;
    if (var == 1) {                                  /* B bounces between normal and half speed; ACTIVITY = how often:
                                                        every bar, half bar, beat, eighth, sixteenth */
        static const uint8_t bl[5] = { 16, 8, 4, 2, 1 };
        if (((uint32_t)(stepIdx - 1) / bl[(int)(act * 4.99f)]) & 1u) rate = 0.5f;
    }
    const int lay = (var == 2) ? (int)(act * 2.99f) : 0;            /* C: ACTIVITY adds layers, up to three */
    float gC = 0.8f;
    if (var == 2) {                                  /* more and longer layers: each one a little softer */
        static const float ga[3] = { 0.80f, 0.515f, 0.39f }, gb[3] = { 0.68f, 0.459f, 0.357f };
        lifeMul = 1.0f + act * 1.5f;
        gC = ga[lay] + (gb[lay] - ga[lay]) * (act * 2.99f - (float)lay);
    }
    if (var == 3) lifeMul = 0.85f;
    float pan = (mc_rf() - 0.5f) * 1.2f;
    MCVoice *v = mc_spawn(back, rate, (int32_t)((float)step * lifeMul * ((j & 1) ? 1.0f : 2.0f)), gC, pan, shp);
    if (!v) return;
    if (var == 0 && act > 0.03f) {
        float f = 250.0f * mc_exp2(mc_rf() * act * 5.5f);
        mc_setFilt(v, (mc_rand() & 1u) ? 1 : 2, f, f, 1.2f + act * 3.0f);
    }
    if (var == 2) {
        float lo = 300.0f + 300.0f * mc_rf(), hi = 3000.0f + 5000.0f * act;
        if (j & 4) mc_setFilt(v, 1, lo, hi, 1.4f); else mc_setFilt(v, 1, hi, lo, 1.4f);
        for (int q = 1; q <= lay; q++) {                           /* the added layers: other slices, sweeping the other way */
            MCVoice *s = mc_spawn(mc_backOf(anchor + slice * perm[(j + 5 * q) & 15]), 1.0f,
                                  (int32_t)((float)step * lifeMul * 1.2f), gC, q == 1 ? -pan : pan * 0.3f, shp);     /* 8 voices in all */
            if (!s) break;
            if ((j + q) & 4) mc_setFilt(s, 1, hi, lo, 1.4f); else mc_setFilt(s, 1, lo, hi, 1.4f);
        }
    }
    if (var == 3) {
        mc_setCrush(v, 2 + (int)(mc_rand() & 3u), 6);
        v->g *= 1.4f;
        if (act > 0.9f && (j & 3) == 0) {
            MCVoice *s = mc_spawn(back, 0.5f, step * 2, 0.6f, -pan, shp);
            if (s) mc_setCrush(s, 4, 5);
        }
    }
    if (var == 1 && act > 0.9f && (j & 7) == 0) {               /* sustain pad layer */
        MCVoice *s = mc_spawn(back + (uint32_t)step, 0.5f, step * 16, 0.28f, 0.0f, 11.0f);   /* pad: swells in (ramp) */
        if (s) mc_setFilt(s, 1, 1800.0f, 1800.0f, 0.8f);
    }
}

MC_COLD void mc_schedGlide() {
    static const float lo[4] = { 0.5f, 0.5f, 1.0f, 0.5f };
    static const float oc[4] = { 1.0f, 2.0f, 1.0f, 2.0f };
    float f = 0.04f * mc_exp2(act * 6.5f);              /* glide rate 0.04..3.6 Hz */
    glPh += f * (16.0f / 48000.0f);
    if (glPh >= 1.0f) glPh -= 1.0f;
    /* SHAPE = the glide pattern: square stays on a pitch, slides to the other, stays, slides back (in the
       tutorial the pedal slides for about as long as it stays); ramp climbs and drops back, triangle
       climbs and comes down, saw drops and climbs back */
    float c = shI == 1 ? 0.97f : (shI == 3 ? 0.03f : 0.5f);
    float tri = glPh < c ? glPh / c : (1.0f - glPh) / (1.0f - c);
    if (shI == 2) tri = tri * tri * (3.0f - 2.0f * tri);
    if (shI == 0) { tri = 2.0f * tri - 0.5f; tri = tri < 0.0f ? 0.0f : (tri > 1.0f ? 1.0f : tri); }
    uint32_t len = (uint32_t)mc_beatFit(1.0f) / 4u;
    if (len < 2400u) len = 2400u;
    if (len > 24000u) len = 24000u;
    for (int k = 0; k < 4; k++) {
        /* B goes from double speed down to half (manual: "between double and half speed"; the tutorial's
           memory card: x2 -> x1/2); D has two loops each way */
        float l = (var == 1 || (var == 3 && (k & 2))) ? 1.0f - tri : tri;
        float rate = lo[var & 3] * mc_exp2(l * oc[var & 3]);
        MCVoice *v = mc_slotVoice(k);
        if (v) { v->rbase = v->rv ? -rate : rate; continue; }
        if (slotWait[k] > 0) { slotWait[k] -= 16; continue; }
        int iters = 2 + (int)(rep * rep * 14.0f);
        int32_t life = (int32_t)((float)len * (float)iters / rate);
        if (life > 480000) life = 480000;
        MCVoice *nv = mc_spawnLoop(len, 300u, rate, life, 0.5f, (k & 1) ? 0.6f : -0.6f, 10.0f, 0);
        if (!nv) continue;
        nv->slot = (uint8_t)k;
        slotWait[k] = (int32_t)len / 2;
    }
}

MC_COLD void mc_schedHaze() {
    float gps = 3.0f + act * act * 50.0f;
    float dmin = 0.06f, dmax = 0.25f, spread = 0.03f + act * 1.0f;
    if (var == 0) { gps *= 0.6f; dmin = 0.12f; dmax = 0.24f; spread = 0.03f + act * 0.25f; }
    if (var == 1) { gps *= 1.25f; dmin = 0.04f; dmax = 0.30f; spread = 0.05f + act * 1.5f; }
    hazeFb = rep * 0.78f;
    /* A is "stretched, overlapping samples": the grains walk through the last moments at half speed and start over */
    hazeLag += 8.0f;
    if (hazeLag > spread * 48000.0f) hazeLag = 0.0f;
    hazeAcc += gps * (16.0f / 48000.0f) * (0.5f + mc_rf());
    while (hazeAcc >= 1.0f) {
        hazeAcc -= 1.0f;
        float dur = dmin + (dmax - dmin) * mc_rf();
        float rate = 1.0f;
        if (var == 0) rate = 1.0f + (mc_rf() - 0.5f) * 0.012f;
        if (var == 2 && (mc_rand() & 1u)) rate = 2.0f;
        if (var == 3 && (mc_rand() & 1u)) rate = 0.5f;
        float ov = gps * (dmin + dmax) * 0.5f;
        static const float hzk[4] = { 0.535f, 0.76f, 0.71f, 0.74f };   /* same loudness at every SHAPE */
        float gain = 1.45f / (1.0f + ov * 0.3f) * hzk[shI & 3];
        uint32_t back = (uint32_t)((0.01f + spread * mc_rf()) * 48000.0f);
        if (var == 0) back = 480u + (uint32_t)hazeLag + (uint32_t)(mc_rf() * 288.0f);
        MCVoice *nv = mc_spawn(back, rate, (int32_t)(dur * 48000.0f), gain, (mc_rf() - 0.5f) * (var == 1 ? 1.8f : 1.1f), shp);
        if (nv) nv->cw = 1;
    }
}

MC_COLD void mc_schedTunnel() {
    tunPh += 16.0f / (float)(mc_beatFit(8.0f) * 8);
    if (tunPh >= 1.0f) tunPh -= 1.0f;
    float L0 = (float)mc_beatFit(1.0f) * 0.125f;                   /* micro loop: a 32nd note, 20..250 ms */
    if (L0 < 960.0f) L0 = 960.0f;
    if (L0 > 12000.0f) L0 = 12000.0f;
    float envN = envFol * 8.0f; if (envN > 1.0f) envN = 1.0f;
    /* modifiers on running drones */
    for (int i = 0; i < MC_NV; i++) {
        MCVoice &v = vo[i];
        if (!v.on || v.slot > 3) continue;
        float L = L0;
        if (var == 0) L = L0 * (1.0f + act * 0.6f * mc_sin1(tunPh + 0.25f * (float)v.slot));
        if (var == 3) L = L0 * (1.0f - act * 0.75f * envN);
        if (var == 0 || var == 3) {
            uint32_t q = ((uint32_t)L) << 13;
            if (q < (256u << 13)) q = 256u << 13;
            uint32_t xf = q / 8u; if (xf > (240u << 13)) xf = 240u << 13;
            v.segLen = q; v.xf = xf; v.xfi = 1.0f / (float)xf;
            if (v.pos - v.seg0 >= q) v.pos = v.seg0 + ((v.pos - v.seg0) % q);
        }
        if (var == 1) {
            float sw = 0.5f + 0.5f * mc_sin1(tunPh * 2.0f + 0.3f * (float)v.slot);
            v.f0 = 250.0f * mc_exp2(act * 4.5f * sw + 0.5f); v.flog = 0.0f;
        }
    }
    /* new drone generation: on onsets, or every 2 beats while signal present */
    int32_t gap = mc_beatFit(2.0f);
    stepCnt += 16;
    bool trig = (onNew && stepCnt > gap / 4) || (stepCnt > gap * 2 && envS > 0.004f);
    if (!trig) return;
    stepCnt = 0;
    int k = chainIdx & 3; chainIdx++;
    MCVoice *old = mc_slotVoice(k);
    if (old) old->kill = 1;
    float decay = 0.6f + rep * rep * 20.0f;
    float rate = (var == 1) ? 0.5f : 1.0f;
    MCVoice *v = mc_spawnLoop((uint32_t)L0, 400u, rate, (int32_t)(decay * 48000.0f), var == 3 ? 1.2f : 0.8f,
                              (k & 1) ? 0.55f : -0.55f, shp, 1);
    if (!v) return;
    v->slot = (uint8_t)k;
    v->cw = 2;                                          /* SHAPE on every turn of the loop, the drone fades over its life */
    if (var == 1) mc_setFilt(v, 1, 600.0f, 600.0f, 1.3f);
    if (var == 2) {
        static const float sc[6] = { 220.0f, 330.0f, 440.0f, 660.0f, 880.0f, 1320.0f };
        float f = sc[mc_rand() % 6u] * ((mc_rand() & 1u) ? 1.0f : 2.0f);
        mc_setFilt(v, 2, f, f, 2.0f + act * 18.0f);
        v->g *= 2.6f + act * 2.0f;
    }
}

MC_COLD void mc_schedStrum() {
    static const int spb[6] = { 1, 2, 3, 4, 6, 8 };
    int32_t step = mc_beatFit(1.0f) / spb[(int)(act * 5.99f)];
    if (step < 960) step = 960;
    if (onNew) { chainG = 1.0f; chainIdx = 0; }
    if (syncReq) stepCnt = stepCnt > step / 2 ? step - 16 : 0;
    stepCnt += 16;
    if (stepCnt < step) return;
    stepCnt -= step;
    if (chainG < 0.01f || onCount == 0) return;
    float dur = (float)step * (var == 1 ? 3.0f : 1.6f);
    if (dur > 18000.0f) dur = 18000.0f;
    int k = (var >= 2) ? (chainIdx % (onCount < 4 ? onCount : 4)) : 0;
    uint32_t back = mc_backOf(mc_onset(k)) + 144u;
    float pan = (chainIdx & 1) ? 0.45f : -0.45f;
    float rate = (var == 3 && (chainIdx & 1)) ? 2.0f : 1.0f;
    mc_spawn(back, rate, (int32_t)dur, 0.8f * chainG, pan, shp);
    if (var == 1) {
        mc_spawn(back + 432u, 1.003f, (int32_t)dur, 0.55f * chainG, -pan, shp);
        mc_spawn(back + 816u, 0.997f, (int32_t)dur, 0.55f * chainG, pan * 0.3f, shp);
    }
    chainIdx++;
    chainG *= 0.55f + 0.45f * rep;
}

MC_COLD void mc_schedBlocks() {
    int32_t step = mc_beatFit(1.0f) / 4;
    if (step < 720) step = 720;
    if (onNew && !burstOn && mc_rf() < 0.25f + 0.75f * rep) {
        burstOn = 1; burstLeft = 2 + (int)(act * 6.0f); burstCnt = step; burstStep = 0;
    }
    if (!burstOn && rep > 0.8f && envS > 0.004f) {
        barIdx += 16;
        if (barIdx > step * 8) { barIdx = 0; burstOn = 1; burstLeft = 2 + (int)(act * 6.0f); burstCnt = step; burstStep = 0; }
    }
    if (!burstOn) return;
    burstCnt += 16;
    if (burstCnt < step) return;
    burstCnt -= step;
    int i = burstStep++;
    if (--burstLeft <= 0) burstOn = 0;
    static const uint8_t ord[8] = { 0, 0, 1, 0, 2, 1, 0, 3 };
    int k = (act < 0.3f) ? ord[i & 7] : (int)(mc_rand() % 4u);
    uint32_t back = mc_backOf(mc_onset(k)) + 96u;
    if (onCount == 0) back = (uint32_t)step * 2u;
    float rate = 1.0f;
    if (var == 1 || var == 3) {
        static const float rs[5] = { 1.0f, 2.0f, 0.5f, 1.5f, 0.75f };
        if (mc_rf() < 0.3f + 0.7f * act) rate = rs[mc_rand() % 5u];
    }
    float lifeMul = (var == 2) ? 2.5f : 0.9f;
    float gain = (var == 2) ? 0.75f * (1.0f - 0.1f * (float)i) : 0.8f;
    if (gain < 0.1f) gain = 0.1f;
    bool ratchet = (var == 0 && (i & 3) == 3 && act > 0.5f);
    MCVoice *v;
    if (ratchet) {                                                  /* same slice twice in one step */
        v = mc_spawnLoop((uint32_t)step / 2u, back > (uint32_t)step / 2u ? back - (uint32_t)step / 2u : 2u, 1.0f,
                         step, gain, (mc_rf() - 0.5f) * 1.2f, shp, 1);
    } else {
        v = mc_spawn(back, rate, (int32_t)((float)step * lifeMul), gain, (mc_rf() - 0.5f) * 1.2f, shp);
    }
    if (!v) return;
    if (var == 2) mc_setFilt(v, 1, 1400.0f, 700.0f, 0.8f);
    if (var == 3) mc_setCrush(v, 3, 6);
}

MC_COLD void mc_schedInterrupt() {
    int32_t step = mc_beatFit(1.0f) / 4;
    if (step < 720) step = 720;
    if (syncReq) stepCnt = stepCnt > step / 2 ? step - 16 : 0;
    stepCnt += 16;
    if (stepCnt < step) return;
    stepCnt -= step;
    stepIdx++;
    if (intLeft <= 0) {
        duckT = 0.0f;
        if ((stepIdx & 1) == 0 && mc_rf() < rep * rep * 0.7f) {
            intLeft = 2 * (1 + (int)(mc_rf() * (1.0f + act * 3.0f)));
            intCnt = 0;
            intSrc = hw - (uint32_t)step * 2u - 64u;
        } else return;
    }
    duckT = 1.0f;
    intLeft--;
    int i = intCnt++;
    uint32_t src = intSrc;
    if (act > 0.4f && mc_rf() < act * 0.5f) src = hw - (uint32_t)(step * (1 + (int)(mc_rand() % 6u)));
    float rate = 1.0f;
    if (var == 1) { static const float rs[5] = { 2.0f, 0.5f, 1.5f, 0.75f, 1.335f }; rate = rs[mc_rand() % 5u]; }
    if (var == 3) { static const float rs[5] = { 4.0f, 0.25f, 2.0f, -1.0f, 0.5f }; rate = rs[mc_rand() % 5u]; }
    if (var == 0 && mc_rf() < act * 0.3f) rate = -1.0f;
    uint32_t back = mc_backOf(src);
    if (rate < 0.0f) back = mc_backOf(src) - (uint32_t)step + 64u;
    MCVoice *v = mc_spawn(back, rate, step, 0.85f, (mc_rf() - 0.5f) * 0.8f, 10.0f);
    if (!v) return;
    if (var == 2) {
        float f0 = 7000.0f * mc_exp2(-(float)i * 0.7f);
        mc_setFilt(v, 1, f0, f0 * 0.6f, 2.5f);
        MCVoice *e = mc_spawn(back + (uint32_t)(step * 3), rate, step, 0.45f, 0.7f, 10.0f);
        if (e) mc_setFilt(e, 1, f0 * 0.5f, f0 * 0.3f, 2.0f);
    }
    if (var == 3) mc_setCrush(v, 2 + (int)(mc_rand() % 5u), 5);
}

MC_COLD void mc_schedArp() {
    int32_t step = mc_beatFit(1.0f) / 4;
    if (step < 720) step = 720;
    if (onNew) chainG = 1.0f;
    if (syncReq) stepCnt = stepCnt > step / 2 ? step - 16 : 0;
    stepCnt += 16;
    if (stepCnt < step) return;
    stepCnt -= step;
    if (onCount == 0 || chainG < 0.01f) return;
    int n = 2 + (int)(act * 6.99f);
    int j = stepIdx % n;
    stepIdx++;
    if (j == n - 1) chainG *= 0.65f + 0.35f * rep;
    int k = n - 1 - j;
    uint32_t back = mc_backOf(mc_onset(k)) + 96u;
    static const float rs[8] = { 1.0f, 2.0f, 1.5f, 0.5f, 1.335f, 2.0f, 0.75f, 1.0f };
    float rate = (var == 1) ? rs[j & 7] : 1.0f;
    float pan = ((float)j / (float)(n - 1) - 0.5f) * 1.4f;
    MCVoice *v = mc_spawn(back, rate, (int32_t)((float)step * 0.85f), 0.8f * chainG, pan, shp);
    if (!v) return;
    if (var == 2) {
        float f = 300.0f * mc_exp2(mc_rf() * 5.0f);
        mc_setFilt(v, (mc_rand() & 1u) ? 1 : 2, f, f, 2.0f + mc_rf() * 4.0f);
    }
    if (var == 3) mc_setCrush(v, 2 + (int)(mc_rand() & 3u), 6);
}

MC_COLD void mc_sched() {
    switch (algo) {
        case 0: mc_schedMosaic(); break;
        case 1: mc_schedSeq(); break;
        case 2: mc_schedGlide(); break;
        case 3: mc_schedHaze(); break;
        case 4: mc_schedTunnel(); break;
        case 5: mc_schedStrum(); break;
        case 6: mc_schedBlocks(); break;
        case 7: mc_schedInterrupt(); break;
        case 8: mc_schedArp(); break;
        default: break;
    }
    syncReq = false;
}

/* ---------- multidelay (PATTERN / WARP) ---------- */
MC_COLD void mc_delaySetup() {
    static const float pat[3][6] = { { 0.75f, 1.0f, 1.5f, 1.75f, 0.25f, 1.25f },
                                     { 0.6667f, 1.3333f, 2.0f, 1.0f, 2.3333f, 2.6667f },
                                     { 1.5f, 0.5f, 2.75f, 3.25f, 1.0f, 3.75f } };
    static const float plen[3] = { 2.0f, 3.0f, 4.0f };
    static const float semi[6] = { 0.0f, 12.0f, 7.0f, 12.0f, 19.0f, 24.0f };
    nTap = 1 + (int)(act * 5.99f);
    float P;
    int32_t b;
    if (algo == 9 && var > 0) {
        b = mc_beatFit(plen[var - 1]);
        P = plen[var - 1] * (float)b;
        for (int k = 0; k < MC_NT; k++) tT[k] = pat[var - 1][k] * (float)b;
    } else {
        b = mc_beatFit(0.5f * (float)nTap + 0.5f);
        for (int k = 0; k < MC_NT; k++) tT[k] = 0.5f * (float)(k + 1) * (float)b;
        P = tT[nTap - 1];
    }
    fbT = P;
    for (int k = 0; k < MC_NT; k++) {
        /* SHAPE = level contour over the taps: square a plain delay (every tap a little softer, as the
           pedal's taps are in the tutorial), ramp growing, triangle with the middle taps in front,
           saw fading away; the loudest tap always stays at full level */
        float n = (float)nTap, q = 0.6f * (float)k / n;
        if (shI == 1) q = 1.0f - (float)(k + 1) / n;
        else if (shI == 2) { q = (2.0f * (float)k + 1.0f) / n - 1.0f; if (q < 0.0f) q = -q; }
        else if (shI == 3) q = (float)k / n;
        if (q < 0.0f) q = 0.0f;
        float g = 1.0f - q * 0.85f;
        tG[k] = k < nTap ? g * 0.8f / (1.0f + 0.25f * (float)(nTap - 1)) : 0.0f;
        tPan[k] = (k & 1) ? -0.6f : 0.6f;           /* first tap on the right, then left, as on the pedal */
        float pr = 1.0f;
        if (algo == 10 && var == 2) pr = mc_exp2(semi[k] * (1.0f / 12.0f));
        if (algo == 10 && var == 3) pr = 2.0f;
        tPr[k] = pr;
    }
    dfb = rep * 0.95f;
}

MC_INL void mc_dread(float d, uint32_t wp, float &l, float &r) {
    if (d < 1.0f) d = 1.0f;
    int32_t di = (int32_t)d;
    float fr = d - (float)di;
    uint32_t i0 = (wp - (uint32_t)di) & MC_HMASK, i1 = (i0 - 1u) & MC_HMASK;
    uint32_t w0 = dly[i0], w1 = dly[i1];
    float l0 = mc_lo(w0), r0 = mc_hi(w0);
    l = l0 + fr * (mc_lo(w1) - l0);
    r = r0 + fr * (mc_hi(w1) - r0);
}

/* processes 16 samples: writes the delay line, adds taps into wet */
MC_SMALL void mc_delayBlock(bool active) {
    if (!active) {
        for (int i = 0; i < 16; i++) dly[(hw + (uint32_t)i) & MC_HMASK] = mc_pack(xL[i], xR[i]);
        return;
    }
    mc_delaySetup();
    if (dInit) {
        for (int k = 0; k < MC_NT; k++) { tD[k] = tT[k]; tPh[k] = 0.0f; tS1[k] = tS2[k] = tS3[k] = tS4[k] = 0.0f; }
        fbD = fbT; dInit = false; dRev = fxRev;
    }
    if (dRev != fxRev) {                        /* REVERSE switched: duck the taps, turn them, come back */
        dGain -= 0.1f;
        if (dGain <= 0.0f) { dGain = 0.0f; dRev = fxRev; for (int k = 0; k < MC_NT; k++) tPh[k] = 0.0f; }
    } else { dGain += 0.05f; if (dGain > 1.0f) dGain = 1.0f; }
    /* per tap: pitch ratio (negative = REVERSE) and grain window: 43 ms for pitch shifting,
       reversed chunks as long as the tap delay */
    float wk[MC_NT], prk[MC_NT], inck[MC_NT];
    for (int k = 0; k < nTap; k++) {
        float pr = dRev ? -tPr[k] : tPr[k], w = 2048.0f;
        if (dRev) {
            w = tD[k] * 2.0f;
            if (w < 4800.0f) w = 4800.0f;
            if (w > 96000.0f) w = 96000.0f;
            float room = (float)(MC_HMASK - 2048u) - tD[k];
            if (w > room) w = room;
        }
        prk[k] = pr; wk[k] = w;
        inck[k] = (pr > 1.0f ? pr - 1.0f : 1.0f - pr) / w;
    }
    float envN = envFol * 6.0f; if (envN > 1.0f) envN = 1.0f;
    float ca1[MC_NT], ca2[MC_NT], ca3[MC_NT], ck = 1.0f;
    int fmode = 0;
    if (algo == 10 && var == 0) { fmode = 1; ck = 0.5f; }
    if (algo == 10 && var == 1) { fmode = 2; ck = 1.0f / 6.0f; }
    for (int k = 0; k < nTap; k++) {
        if (fmode == 1) mc_svf(300.0f * mc_exp2(1.2f + 4.1f * envN + 0.3f * (float)k), ck, ca1[k], ca2[k], ca3[k]);
        else if (fmode == 2) mc_svf(300.0f * mc_exp2((float)k * 0.9f + 1.0f), ck, ca1[k], ca2[k], ca3[k]);
    }
    float mod = modDep * 120.0f * lfoVal;
    const bool xfD = algo == 10 && var == 3 && !dRev;   /* WARP D: crossfade plain tap <-> double-speed grains */
    float xk[MC_NT];
    for (int k = 0; k < MC_NT; k++) xk[k] = xfD ? 0.5f + 0.5f * mc_sin1(wrpPh + (float)k * 0.16f) : 0.0f;
    for (int i = 0; i < 16; i++) {
        uint32_t wp = (hw + (uint32_t)i) & MC_HMASK;
        float sl = 0.0f, sr = 0.0f, lastL = 0.0f, lastR = 0.0f;
        for (int k = 0; k < nTap; k++) {
            tD[k] += (tT[k] - tD[k]) * 0.0004f;
            float d = tD[k] + ((k & 1) ? mod : -mod);
            float l, r;
            float pr = prk[k];
            if (pr != 1.0f) {
                const float W = wk[k], inc = inck[k];
                float ph = tPh[k] + inc; if (ph >= 1.0f) ph -= 1.0f;
                tPh[k] = ph;
                float pb = ph + 0.5f; if (pb >= 1.0f) pb -= 1.0f;
                float da = pr > 1.0f ? W * (1.0f - ph) : W * ph;
                float db = pr > 1.0f ? W * (1.0f - pb) : W * pb;
                float la, ra, lb2, rb2;
                mc_dread(d + da, wp, la, ra);
                mc_dread(d + db, wp, lb2, rb2);
                float wa = 1.0f - (ph > 0.5f ? 2.0f * ph - 1.0f : 1.0f - 2.0f * ph);
                l = la * wa + lb2 * (1.0f - wa);
                r = ra * wa + rb2 * (1.0f - wa);
                if (xfD) {
                    float pl, prr;
                    mc_dread(d, wp, pl, prr);
                    const float x = xk[k];
                    l = pl + x * (l - pl);
                    r = prr + x * (r - prr);
                }
            } else {
                mc_dread(d, wp, l, r);
            }
            if (fmode) {
                float a1 = ca1[k], a2 = ca2[k], a3 = ca3[k];
                float v3 = l - tS2[k], v1 = a1 * tS1[k] + a2 * v3, v2 = tS2[k] + a2 * tS1[k] + a3 * v3;
                tS1[k] = 2.0f * v1 - tS1[k]; tS2[k] = 2.0f * v2 - tS2[k];
                float u3 = r - tS4[k], u1 = a1 * tS3[k] + a2 * u3, u2 = tS4[k] + a2 * tS3[k] + a3 * u3;
                tS3[k] = 2.0f * u1 - tS3[k]; tS4[k] = 2.0f * u2 - tS4[k];
                if (fmode == 1) { l = v2; r = u2; } else { l = v1 * ck * 4.5f; r = u1 * ck * 4.5f; }
            }
            float g = tG[k];
            float pl = tPan[k] > 0.0f ? 1.0f - tPan[k] * 0.8f : 1.0f;
            float pr2 = tPan[k] < 0.0f ? 1.0f + tPan[k] * 0.8f : 1.0f;
            sl += l * g * pl; sr += r * g * pr2;
            lastL = l; lastR = r;
        }
        /* feedback */
        float fl, fr;
        fbD += (fbT - fbD) * 0.0004f;
        if (algo == 10) { fl = lastL; fr = lastR; }
        else mc_dread(fbD + ((nTap & 1) ? mod : -mod), wp, fl, fr);
        dLpL += (fl - dLpL) * 0.55f; dLpR += (fr - dLpR) * 0.55f;
        dDcL += (dLpL - dDcL) * 0.003f; dDcR += (dLpR - dDcR) * 0.003f;
        float ql = mc_soft((dLpL - dDcL) * dfb), qr = mc_soft((dLpR - dDcR) * dfb);
        dly[wp] = mc_pack(xL[i] + ql, xR[i] + qr);
        wetL[i] += sl * dGain; wetR[i] += sr * dGain;
    }
}

/* ---------- Space reverb ---------- */
/* ===== SPACE plate ===========================================================
   The Griesinger / Dattorro "figure eight" (J. Dattorro, "Effect Design, Part 1",
   JAES 1997) laid out as in the reverbs of Mutable Instruments Rings and Clouds
   by Emilie Gillet (Copyright 2014 Emilie Gillet, MIT license): four input
   allpasses, then two branches [modulated delay -> low-pass -> two allpasses ->
   delay] that feed each other; left and right are taken at the end of each branch.
   Line lengths are those of the Rings reverb at 48 kHz, scaled by the room size.
   Written anew for this patch: one float circular buffer holds every line (one
   write pointer, each line at its own fixed offset, sized for the largest room so
   the size can glide), the host sets the parameters once per block.

   MIT license of the original: Permission is hereby granted, free of charge, to
   any person obtaining a copy of this software and associated documentation files
   (the "Software"), to deal in the Software without restriction, including without
   limitation the rights to use, copy, modify, merge, publish, distribute,
   sublicense, and/or sell copies of the Software, and to permit persons to whom the
   Software is furnished to do so, subject to the following conditions: The above
   copyright notice and this permission notice shall be included in all copies or
   substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT
   WARRANTY OF ANY KIND.
   ============================================================================= */
static const uint32_t PL_MASK = (1u << 16) - 1u;
float *plm;
uint32_t plw, plB[11];
float plOff[11];      /* read offsets of the lines for the current size, samples */
float plLp1, plLp2, plPh1, plPh2;
/* parameters, set by the host every block */
float plSize, plKap, plKlp, plKrt, plAmp, plGain, plPre;

static inline float pl_lfo(float ph) {                /* smooth 0..1 wave from a 0..1 phase */
    float x = ph < 0.5f ? ph * 4.0f - 1.0f : 3.0f - ph * 4.0f;
    return 0.5f + 0.5f * x * (1.5f - 0.5f * x * x);
}
inline float pl_rd(int k, uint32_t off) { return plm[(plw + plB[k] + off) & PL_MASK]; }
inline float pl_rdi(int k, float off) {
    uint32_t i = (uint32_t)off;
    float f = off - (float)i;
    float a = pl_rd(k, i), b = pl_rd(k, i + 1u);
    return a + f * (b - a);
}
inline void pl_wr(int k, float v) {                  /* float lines: 16-bit ones eat or freeze the tail */
    v = v > 4.0f ? 4.0f : (v < -4.0f ? -4.0f : v);
    plm[(plw + plB[k]) & PL_MASK] = v;
}
inline float pl_ap(int k, float x, float g) {          /* v = x + g d, y = d - g v */
    float d = pl_rd(k, (uint32_t)plOff[k]);
    float v = x + g * d;
    pl_wr(k, v);
    return d - g * v;
}
void pl_setSize(float s) {
    static const float base[11] = { 0.0f, 150.0f, 214.0f, 319.0f, 527.0f, 2182.0f, 2690.0f, 4460.0f, 2525.0f, 2197.0f, 6261.0f };
    if (s < 0.3f) s = 0.3f;
    if (s > 1.6f) s = 1.6f;
    plSize = s;
    for (int k = 1; k < 11; k++) plOff[k] = base[k] * s - 1.0f;
}
void pl_init(float *mem) {
    static const float base[11] = { 0.0f, 150.0f, 214.0f, 319.0f, 527.0f, 2182.0f, 2690.0f, 4460.0f, 2525.0f, 2197.0f, 6261.0f };
    plm = mem; plw = 0;
    for (uint32_t i = 0; i <= PL_MASK; i++) plm[i] = 0.0f;
    uint32_t b = 0;                                     /* regions for size 1.6, 4x modulation, 100 ms predelay */
    for (int k = 0; k < 11; k++) {
        plB[k] = b;
        b += (k == 0) ? 4900u : (uint32_t)(base[k] * 1.6f) + ((k == 7 || k == 10) ? 260u : 4u);
    }
    plLp1 = plLp2 = 0.0f; plPh1 = 0.0f; plPh2 = 0.37f;
    plKap = 0.625f; plKlp = 0.7f; plKrt = 0.5f; plAmp = 1.0f; plGain = 0.2f; plPre = 100.0f;
    pl_setSize(1.0f);
}
/* one block: mono sum of the input in, stereo wet out (overwrites wl / wr) */
#ifndef MC_HOT
#define MC_HOT
#endif
MC_HOT void pl_block(const float *inl, const float *inr, float *wl, float *wr) {
    plPh1 += 0.5f * (16.0f / 48000.0f); if (plPh1 >= 1.0f) plPh1 -= 1.0f;
    plPh2 += 0.3f * (16.0f / 48000.0f); if (plPh2 >= 1.0f) plPh2 -= 1.0f;
    const float o1 = plOff[7] + 40.0f * plAmp * pl_lfo(plPh1);
    const float o2 = plOff[10] + 50.0f * plAmp * pl_lfo(plPh2);
    const float kap = plKap, klp = plKlp, krt = plKrt, g = plGain;
    float pre = plPre < 1.0f ? 1.0f : (plPre > 4800.0f ? 4800.0f : plPre);
    for (int i = 0; i < 16; i++) {
        plw--;
        pl_wr(0, (inl[i] + inr[i]) * g);
        float x = pl_rdi(0, pre);
        x = pl_ap(1, x, kap);
        x = pl_ap(2, x, kap);
        x = pl_ap(3, x, kap);
        x = pl_ap(4, x, kap);
        float a = x + krt * pl_rdi(10, o2);
        plLp1 += klp * (a - plLp1) + 1e-20f;           /* + 1e-20: no subnormals in the tail */
        a = pl_ap(5, plLp1, -kap);
        a = pl_ap(6, a, kap);
        pl_wr(7, a);
        wl[i] = 2.0f * a;
        float c = x + krt * pl_rdi(7, o1);
        plLp2 += klp * (c - plLp2) + 1e-20f;
        c = pl_ap(8, plLp2, kap);
        c = pl_ap(9, c, -kap);
        pl_wr(10, c);
        wr[i] = 2.0f * c;
    }
}

/* SPACE echo. The manual says SPACE "mixes in reverberation and delay" and Sound On Sound
   speaks of a stereo delay beside the reverb; Hologram says no more, so this is our reading:
   a ping-pong pair beside the plate, its repeats also sent into the plate. Its two times are
   subdivisions of the tempo (FREE: as at 120 BPM), folded by octaves into 30 ms .. 1.3 s so
   the pair keeps its rhythm; the repeats darken in the loop. */
static const uint32_t MC_EMAX = 65536u, MC_EMASK = 65535u;
MC_INL float mc_erd(uint32_t base, float d) {
    uint32_t di = (uint32_t)d;
    float f = d - (float)di;
    float a = eb[base + ((ew - di) & MC_EMASK)], b = eb[base + ((ew - di - 1u) & MC_EMASK)];
    return a + f * (b - a);
}
/* the four modes, shortest to longest: A room, B dark medium room, C hall, D ambient wash;
   echo: A 3/32 + 1/16 short and bright, B 1/8 + 3/16 dark, C 3/16 + 1/4, D 3/8 + 1/2 */
MC_COLD void mc_revSetup(int m) {
    static const float sz[4]  = { 0.55f, 0.85f, 1.15f, 1.60f };
    static const float t60[4] = { 0.8f, 1.8f, 4.2f, 12.0f };
    static const float lp[4]  = { 0.80f, 0.30f, 0.55f, 0.45f };
    static const float kp[4]  = { 0.60f, 0.625f, 0.68f, 0.72f };
    static const float md[4]  = { 0.5f, 1.0f, 1.6f, 3.0f };
    static const float pd[4]  = { 96.0f, 576.0f, 1200.0f, 2880.0f };
    static const float tr[4]  = { 0.763f, 1.436f, 1.131f, 1.064f };   /* plate + echo as loud as the earlier SPACE */
    static const float tr0[4] = { 0.838f, 1.648f, 1.370f, 1.380f };   /* the plate alone, as loud (echo off) */
    static const float esl[4] = { 0.1875f, 0.5f, 0.75f, 1.5f };   /* echo times, beats */
    static const float esr[4] = { 0.25f, 0.75f, 1.0f, 2.0f };
    static const float efb[4] = { 0.15f, 0.30f, 0.40f, 0.55f };   /* ping-pong feedback */
    static const float efc[4] = { 6000.0f, 2200.0f, 4000.0f, 3000.0f };   /* loop low-pass, Hz */
    static const float emx[4] = { 0.308f, 0.448f, 0.540f, 0.871f };   /* echo 9, 6, 5, 4 dB under the plate */
    static const float esd[4] = { 0.3f, 0.4f, 0.5f, 0.6f };       /* echo into the plate */
    rvMode = m & 3;
    pl_setSize(sz[rvMode]);
    float branch = 10180.0f * plSize / 48000.0f;        /* mean branch delay, s */
    plKrt = mc_exp2(-9.966f * branch / t60[rvMode]);
    plKlp = lp[rvMode]; plKap = kp[rvMode]; plAmp = md[rvMode]; plPre = pd[rvMode];
    plGain = 0.2f;
    rvTrim = tr[rvMode];
    rvTrim0 = tr0[rvMode];
    rvFade = 0.0f;
    eSubL = esl[rvMode]; eSubR = esr[rvMode]; eFbk = efb[rvMode];
    float w = efc[rvMode] * (6.2831853f / 48000.0f);
    eK = w / (1.0f + w);
    eMix = emx[rvMode]; eSnd = esd[rvMode];
}

MC_HOT void mc_reverb(float *bl, float *br, float wet, float dry) {
    float wl[16], wr[16], el[16], er[16], pl[16], pr[16];
    float b = seFree ? 24000.0f : (float)beat;
    const bool eOff = seFree == 2;                      /* echo off: the plate alone */
    const float eM = eOff ? 0.0f : eMix, eS = eOff ? 0.0f : eSnd, trm = eOff ? rvTrim0 : rvTrim;
    float tl = b * eSubL, tr = b * eSubR;
    while (tr > 62400.0f) { tl *= 0.5f; tr *= 0.5f; }
    while (tl < 1440.0f) { tl *= 2.0f; tr *= 2.0f; }
    /* a new tempo bends the repeats, as tape: the read point keeps its place and glides to the
       new time (the distance to go decays, so the glide lands exactly) */
    if (tl != eTgL) { eOfL += eTgL - tl; eTgL = tl; }
    if (tr != eTgR) { eOfR += eTgR - tr; eTgR = tr; }
    if (eOfL > -0.01f && eOfL < 0.01f) eOfL = 0.0f;
    if (eOfR > -0.01f && eOfR < 0.01f) eOfR = 0.0f;
    for (int i = 0; i < 16; i++) {
        eOfL *= 0.9995f; eOfR *= 0.9995f;
        ew = (ew + 1u) & MC_EMASK;
        float rl = mc_erd(0u, eTgL + eOfL), rr = mc_erd(MC_EMAX, eTgR + eOfR);
        eLpL += (rr - eLpL) * eK;                       /* ping-pong: each side repeats the other */
        eLpR += (rl - eLpR) * eK;
        eb[ew] = mc_soft(bl[i] + eLpL * eFbk);
        eb[MC_EMAX + ew] = mc_soft(br[i] + eLpR * eFbk);
        el[i] = rl; er[i] = rr;
        pl[i] = bl[i] + rl * eS; pr[i] = br[i] + rr * eS;
    }
    pl_block(pl, pr, wl, wr);
    for (int i = 0; i < 16; i++) {
        if (rvFade < 1.0f) rvFade += 1.0f / 2400.0f;
        float w = wet * rvFade * trm;
        bl[i] = bl[i] * dry + (wl[i] + el[i] * eM) * w;
        br[i] = br[i] * dry + (wr[i] + er[i] * eM) * w;
    }
}

/* ---------- looper ---------- */
/* close the first take at len frames (len <= lrw); what was recorded past len feeds the seam */
MC_COLD void mc_loopCloseAt(int32_t len, bool play) {
    lqEnd = 0;
    llen = len;
    if (llen < 4800) { lst = 0; llen = 0; lgain = 0.0f; return; }
    int32_t tail = llen / 4 < MC_XSEAM ? llen / 4 : MC_XSEAM, extra = lrw - llen;
    ltail = extra >= tail ? 0 : tail - extra;              /* record a few ms past the end for the seam */
    lpos = lrevS ? ((int64_t)(llen - 1) << 16) : 0;
    lst = play ? 2 : 4;
    lgain = 0.0f;
    lgt = play ? 1.0f : 0.0f;
    lfast = true;
}
MC_COLD void mc_loopClose(bool play) { mc_loopCloseAt(lrw, play); }
/* end of the first take; QUANTIZE rounds the length to the nearest quarter note
   (shorter: cut now; longer: keep recording up to it) */
MC_COLD void mc_loopEnd(bool play) {
    int32_t q = qlenS;
    if (q > 0 && q <= (int32_t)MC_LMAX) {
        int32_t n = (lrw + q / 2) / q;
        if (n < 1) n = 1;
        int32_t t = n * q;
        while (t > (int32_t)MC_LMAX) t -= q;
        if (t > lrw) { lqEnd = t; lqPlay = play; return; }
        mc_loopCloseAt(t, play);
        return;
    }
    mc_loopClose(play);
}

MC_COLD void mc_loopCmd(bool rec, bool stop, bool erase, bool undo) {
    if (erase) {                                           /* erase + rec together (BURST): a new take at once */
        lst = 0; llen = 0; lrw = 0; lgain = 0.0f; lgt = 0.0f; ldubOn = false; lclr = -1; ltail = 0; lqEnd = 0;
        if (!rec) return;
    }
    if (lst == 1 && lqEnd > 0) return;                     /* waiting for the quantized end */
    if (undo && ldubOn) { ldubOn = false; lclr = 0; if (lst == 3) lst = 2; }
    if (rec) {
        if (lst == 0) {
            lst = 1; lrw = 0; ltail = 0; ldubOn = false; lclr = -1;
            if (qlenS > 0) { beatCnt = 0; stepCnt = 0; }      /* QUANTIZE: effect and loop start together */
        }
        else if (lst == 1) mc_loopEnd(true);
        else if (lst == 2) { if (lspd == 65536 && lclr < 0) { lst = 3; ldubOn = true; } }
        else if (lst == 3) lst = 2;
        else if (lst == 4) { lst = 2; lgt = 1.0f; lpos = lrevS ? ((int64_t)(llen - 1) << 16) : 0; }
    }
    if (stop) {
        if (lst == 1) mc_loopEnd(false);
        else if (lst == 2 || lst == 3) { lst = 4; lgt = 0.0f; }
        else if (lst == 4) { lst = 2; lgt = 1.0f; lpos = lrevS ? ((int64_t)(llen - 1) << 16) : 0; }
    }
    if (lst == 3 && lspd != 65536) lst = 2;
}

/* playback for this block into lpL/lpR, remembers indexes for overdub */
MC_HOT void mc_loopRead(float lev) {
    for (int i = 0; i < 16; i++) { lpL[i] = 0.0f; lpR[i] = 0.0f; lIdx[i] = 0xFFFFFFFFu; }
    if (llen <= 0 || lst == 0 || lst == 1) return;
    if (lgain <= 0.0f && lgt <= 0.0f) return;
    int64_t L16 = (int64_t)llen << 16;
    int64_t sp = lrevS ? -(int64_t)lspd : (int64_t)lspd;
    int32_t tail = (lst != 1) ? (llen / 4 < MC_XSEAM ? llen / 4 : MC_XSEAM) : 0;
    for (int i = 0; i < 16; i++) {
        bool up = lgt > lgain;                            /* fade shape: 1 = fade in only, 2 = fade out only */
        float st = (lfast || (up ? lshape == 2 : lshape == 1)) ? (1.0f / 240.0f) : lstep;
        lgain += (lgt > lgain) ? st : -st;
        if (lgain >= 1.0f && lgt >= 1.0f) lfast = false;
        if (lgain > 1.0f) lgain = 1.0f;
        if (lgain < 0.0f) lgain = 0.0f;
        uint32_t ix = (uint32_t)(lpos >> 16);
        float fr = (float)(uint32_t)(lpos & 0xFFFF) * (1.0f / 65536.0f);
        uint32_t ix1 = ix + 1u >= (uint32_t)llen ? 0u : ix + 1u;
        uint32_t b0 = lb[ix], b1 = lb[ix1];
        float l = mc_lo(b0) + fr * (mc_lo(b1) - mc_lo(b0));
        float r = mc_hi(b0) + fr * (mc_hi(b1) - mc_hi(b0));
        if ((int32_t)ix < tail && ltail == 0) {          /* seam blend with the material recorded past the end */
            float t = (float)ix / (float)tail;
            uint32_t s = lb[(uint32_t)llen + ix];
            l = l * t + mc_lo(s) * (1.0f - t);
            r = r * t + mc_hi(s) * (1.0f - t);
        }
        if (ldubOn) {
            uint32_t d0 = ld[ix], d1 = ld[ix1];
            l += mc_lo(d0) + fr * (mc_lo(d1) - mc_lo(d0));
            r += mc_hi(d0) + fr * (mc_hi(d1) - mc_hi(d0));
        }
        float g = lgain * lev;
        lpL[i] = l * g; lpR[i] = r * g;
        lIdx[i] = ix;
        lpos += sp;
        if (lpos >= L16) lpos -= L16;
        if (lpos < 0) lpos += L16;
    }
    if (lst == 4 && lgain <= 0.0f) lgain = 0.0f;
}

/* recording / overdub for this block; in = looper input */
MC_COLD void mc_loopWrite(const float *inl, const float *inr) {
    int i0 = 0;                                            /* first sample of the block left for the seam tail */
    if (lst == 1) {
        for (i0 = 0; i0 < 16; i0++) {
            if (lqEnd > 0 && lrw >= lqEnd) { mc_loopCloseAt(lqEnd, lqPlay); break; }
            if ((uint32_t)lrw >= MC_LMAX) { lqEnd = 0; mc_loopEnd(true); break; }
            lb[lrw] = mc_pack(inl[i0], inr[i0]);
            ld[lrw] = 0u;
            lrw++;
        }
    }
    if (lst != 1 && ltail > 0) {                           /* record the seam tail (closing mid-block too) */
        for (int i = i0; i < 16 && ltail > 0; i++) {
            int32_t t = (llen / 4 < MC_XSEAM ? llen / 4 : MC_XSEAM) - ltail;
            lb[(uint32_t)llen + (uint32_t)t] = mc_pack(inl[i], inr[i]);
            ltail--;
        }
    }
    if (lst == 3) {
        for (int i = 0; i < 16; i++) {
            uint32_t ix = lIdx[i];
            if (ix >= (uint32_t)llen) continue;
            uint32_t d = ld[ix];
            ld[ix] = mc_pack(mc_lo(d) + inl[i], mc_hi(d) + inr[i]);
        }
    }
    if (lclr >= 0) {
        for (int j = 0; j < 512; j++) {
            if (lclr >= llen) { lclr = -1; break; }
            ld[lclr++] = 0u;
        }
    }
}

/* LOOPER ONLY: the effects are muted and the input itself becomes the "effect" signal, read from
   the history with the pitch modulation (MOD DEPTH / MOD RATE, +-3 % like the voices); filter, MIX
   and Space still work on it */
float passD;
MC_COLD void mc_passBlock() {
    float f = 0.05f * mc_exp2(modRate * 7.0f);
    float a = modDep * 0.03f * 48000.0f / (6.2831853f * f);   /* delay swing for +-3 % pitch */
    float dNow = a * (1.0f + lfoVal);
    if (dNow > 30000.0f) dNow = 30000.0f;
    float d0 = passD, dd = (dNow - d0) * (1.0f / 16.0f);
    uint32_t base = hw - 16u;
    for (int i = 0; i < 16; i++) {
        float d = d0 + dd * (float)(i + 1);
        int32_t di = (int32_t)d;
        float fr = d - (float)di;
        uint32_t i0 = (base + (uint32_t)i - (uint32_t)di) & MC_HMASK, i1 = (i0 - 1u) & MC_HMASK;
        uint32_t w0 = hist[i0], w1 = hist[i1];
        wetL[i] += mc_lo(w0) + fr * (mc_lo(w1) - mc_lo(w0));
        wetR[i] += mc_hi(w0) + fr * (mc_hi(w1) - mc_hi(w0));
    }
    passD = dNow;
}

/* ---------- one k-rate block ---------- */
/* insert (default): MIX is a dry/wet, fully up = effect alone (so it also serves a send/return).
   aux = send/return use only: the direct dry never reaches the output and MIX is the return level.
   kill = bypass with trails: the input to the effect fades out in 10 ms and the tails keep ringing;
   in insert the dry stays exactly where MIX puts it (unity up to half way, nothing at full), so a bypass
   on a bus is silent and a bypass in line leaves the dry alone. omono = L+R on both outputs. */
MC_SMALL void mc_block(const int32_t *inL, const int32_t *inR, int32_t *outL, int32_t *outR,
              int inMode, int aux, int omono, bool kill, bool holdReq,
              float flt, float res, float mix, float fxv, float spc, float llev) {
    const float Q27 = 1.0f / 134217728.0f;
    float dL[16], dR[16], rL[16], rR[16], gI[16], iL[16], iR[16];
    float pk = peakV * 0.992f;
    float gt = kill ? 0.0f : 1.0f, g = inG;
    for (int i = 0; i < 16; i++) {
        float l = (float)inL[i] * Q27, r = (float)inR[i] * Q27;
        if (inMode == 1) r = l;
        else if (inMode == 2) { float m = 0.5f * (l + r); l = m; r = m; }
        float a = l < 0.0f ? -l : l, b = r < 0.0f ? -r : r;
        if (a > pk) pk = a;
        if (b > pk) pk = b;
        if (g < gt) { g += 1.0f / 480.0f; if (g > gt) g = gt; }
        else if (g > gt) { g -= 1.0f / 480.0f; if (g < gt) g = gt; }
        gI[i] = g;
        rL[i] = l; rR[i] = r;
        dL[i] = l * g; dR[i] = r * g;
    }
    inG = g;
    peakV = pk;

    /* looper playback (needed first for pre-FX routing) */
    llevS += (llev - llevS) * 0.05f;
    mc_loopRead(llevS * 1.4f);
    for (int i = 0; i < 16; i++) { iL[i] = dL[i]; iR[i] = dR[i]; }     /* pre-FX recording: the input only */
    if (lpreS) for (int i = 0; i < 16; i++) { dL[i] += lpL[i]; dR[i] += lpR[i]; }

    /* history write: input, hold loop or granular feedback; onset detection */
    float fbk = (algo == 3) ? hazeFb : 0.0f;
    float ht = (holdReq && (lst == 0 || lst == 4)) ? 1.0f : 0.0f;    /* HOLD is off while the looper runs */
    onNew = 0;
    for (int i = 0; i < 16; i++) {
        float l = dL[i], r = dR[i];
        holdMix += (ht > holdMix) ? (1.0f / 960.0f) : -(1.0f / 960.0f);
        if (holdMix < 0.0f) holdMix = 0.0f;
        if (holdMix > 1.0f) holdMix = 1.0f;
        uint32_t wi = (hw + (uint32_t)i) & MC_HMASK;
        if (holdMix > 0.0f) {
            uint32_t o = hist[(wi - holdLen) & MC_HMASK];
            l += (mc_lo(o) - l) * holdMix;
            r += (mc_hi(o) - r) * holdMix;
        } else if (fbk > 0.0f) {
            l += mc_soft(fbL[i] * fbk);
            r += mc_soft(fbR[i] * fbk);
        }
        hist[wi] = mc_pack(l, r);
        xL[i] = l; xR[i] = r;
        float a = (l < 0.0f ? -l : l) + (r < 0.0f ? -r : r);
        a *= 0.5f;
        envF += (a - envF) * (a > envF ? 0.05f : 0.004f);
        envS += (a - envS) * (a > envS ? 0.0008f : 0.0002f);
        envFol += (a - envFol) * (a > envFol ? 0.01f : 0.0003f);
        onSince++;
        if (envF > envS * 1.8f + 0.006f && onSince > 2880) {
            onPos[onHead] = hw + (uint32_t)i - 96u;
            onHead = (onHead + 1) % MC_NO;
            if (onCount < MC_NO) onCount++;
            onSince = 0;
            onNew = 1;
        }
    }

    for (int i = 0; i < 16; i++) { wetL[i] = 0.0f; wetR[i] = 0.0f; }
    mc_delayBlock(algo >= 9 && !lonlyS);
    hw += 16u;

    /* voices: modulation, scheduling, rendering */
    float mm = 1.0f + modDep * 0.03f * lfoVal;
    for (int k = 0; k < MC_NV; k++) if (vo[k].on) vo[k].rate = (int32_t)(vo[k].rbase * mm * 8192.0f);
    if (!lonlyS) mc_sched();
    for (int k = 0; k < MC_NV; k++) if (vo[k].on) mc_render(vo[k], wetL, wetR);
    if (lonlyS) mc_passBlock();
    for (int i = 0; i < 16; i++) { fbL[i] = wetL[i]; fbR[i] = wetR[i]; }

    /* end-of-chain low-pass filter on the effect */
    fCut += (flt - fCut) * 0.08f;
    fRes += (res - fRes) * 0.08f;
    float fc = 20.0f * mc_exp2(fCut * 10.0f);
    float byp = (fCut - 0.94f) * (1.0f / 0.05f);
    if (byp < 0.0f) byp = 0.0f;
    if (byp > 1.0f) byp = 1.0f;
    float gate = fCut * (1.0f / 0.03f);
    if (gate > 1.0f) gate = 1.0f;
    float k = 2.0f * (1.0f - 0.93f * fRes), a1, a2, a3;
    mc_svf(fc, k, a1, a2, a3);
    float comp = 1.0f / (1.0f + fRes * 1.5f);

    mixS += (mix - mixS) * 0.05f;
    fxvS += (fxv - fxvS) * 0.05f;
    spcS += (spc - spcS) * 0.05f;
    float dg = 2.0f * (1.0f - mixS); if (dg > 1.0f) dg = 1.0f;
    float wg = 2.0f * mixS; if (wg > 1.0f) wg = 1.0f;
    float dk = wg;                            /* INTERRUPT: how deep the glitches cut the dry */
    wg *= 2.0f * fxvS * gate;

    float ol[16], orr[16], xl[16], xr[16];
    for (int i = 0; i < 16; i++) {
        float l = wetL[i], r = wetR[i];
        float v3 = l - fS2l, v1 = a1 * fS1l + a2 * v3, v2 = fS2l + a2 * fS1l + a3 * v3;
        fS1l = 2.0f * v1 - fS1l; fS2l = 2.0f * v2 - fS2l;
        float u3 = r - fS2r, u1 = a1 * fS1r + a2 * u3, u2 = fS2r + a2 * fS1r + a3 * u3;
        fS1r = 2.0f * u1 - fS1r; fS2r = 2.0f * u2 - fS2r;
        l = v2 * comp + byp * (l - v2 * comp);
        r = u2 * comp + byp * (r - u2 * comp);
        float d = dg;
        if (algo == 7 && !lonlyS) {           /* INTERRUPT: glitches replace the dry; MIX 100% = no dry at all */
            duck += (duckT - duck) * 0.007f;
            d = dg * (1.0f - duck * dk);
        }
        ol[i] = dL[i] * d + l * wg;
        orr[i] = dR[i] * d + r * wg;
        xl[i] = rL[i] * gI[i] * d;                /* share of the live input in the direct path */
        xr[i] = rR[i] * gI[i] * d;
    }

    /* Space */
    float sw = 2.0f * spcS; if (sw > 1.0f) sw = 1.0f;
    float sd = 2.0f * (1.0f - spcS); if (sd > 1.0f) sd = 1.0f;

    mc_reverb(ol, orr, sw, sd);

    /* looper write: post-FX records the output, pre-FX records the input */
    if (lpreS) mc_loopWrite(iL, iR); else mc_loopWrite(ol, orr);
    for (int i = 0; i < 16; i++) {
        float l = ol[i], r = orr[i];
        if (aux) { l -= xl[i] * sd; r -= xr[i] * sd; }                         /* no direct dry */
        else { float k = (1.0f - gI[i]) * dg; l += rL[i] * k; r += rR[i] * k; }   /* bypass: the dry stays where MIX puts it */
        if (!lpreS) { l += lpL[i]; r += lpR[i]; }
        if (omono) { float m = 0.5f * (l + r); l = m; r = m; }
        l = mc_soft(l); r = mc_soft(r);
        if (l > 1.0f) l = 1.0f;
        if (l < -1.0f) l = -1.0f;
        if (r > 1.0f) r = 1.0f;
        if (r < -1.0f) r = -1.0f;
        outL[i] = (int32_t)(l * 134217727.0f);
        outR[i] = (int32_t)(r * 134217727.0f);
    }
}

MC_COLD void microcosm_coldInit() {
for (uint32_t i = 0; i < (1u << 19); i++) { hist[i] = 0u; dly[i] = 0u; }
ew = 0u; seFree = 0; shI = 0; shp = 10.0f;
for (uint32_t i = 0; i < 2u * 65536u; i++) eb[i] = 0.0f;
eLpL = eLpR = 0.0f; eTgL = 24000.0f * 0.1875f; eTgR = 24000.0f * 0.25f; eOfL = eOfR = 0.0f;
for (int i = 0; i < MC_NV; i++) { vo[i].on = 0; vo[i].slot = 255; vo[i].kill = 0; }
hw = 0u; rng = 0x2545F491u; algo = 0; var = 0; beat = 24000;
act = 0.5f; rep = 0.5f;
for (int i = 0; i < 16; i++) { wetL[i] = wetR[i] = fbL[i] = fbR[i] = xL[i] = xR[i] = lpL[i] = lpR[i] = 0.0f; lIdx[i] = 0xFFFFFFFFu; }
beatCnt = 0; beatPulse = 0; lfoPh = 0.0f; lfoVal = 0.0f; modDep = 0.0f; modRate = 0.0f; wrpPh = 0.0f;
envF = envS = envFol = 0.0f; onCount = 0; onHead = 0; onSince = 0; onNew = 0;
for (int i = 0; i < MC_NO; i++) onPos[i] = 0u;
holdOn = false; holdMix = 0.0f; holdLen = 96000u;
duck = 0.0f; hazeFb = 0.0f;
for (int k = 0; k < MC_NT; k++) { tD[k] = tT[k] = tG[k] = tPan[k] = tPh[k] = 0.0f; tPr[k] = 1.0f; tS1[k] = tS2[k] = tS3[k] = tS4[k] = 0.0f; }
fbD = fbT = 0.0f; dfb = 0.0f; dLpL = dLpR = dDcL = dDcR = 0.0f; dGain = 0.0f; dGainT = 0.0f; nTap = 1; dInit = true;
fCut = 1.0f; fRes = 0.0f; fS1l = fS2l = fS1r = fS2r = 0.0f; fWet = 0.0f;
mixS = 0.5f; fxvS = 0.5f; spcS = 0.0f; llevS = 0.0f;
mc_revSetup(0);
lst = 0; llen = 0; lrw = 0; ltail = 0; lclr = -1; lspd = 65536; lpos = 0;
lgain = 0.0f; lgt = 0.0f; lstep = 1.0f / 480.0f; lfadeT = 0.01f;
lfast = false; ldubOn = false; lrevS = false; lpreS = false;
lshape = 0; qlenS = 0; lqEnd = 0; lqPlay = true; lonlyS = false; fxRev = false; dRev = false; passD = 0.0f;
pRec = pStop = pErase = pUndo = pTap = pHold = false;
peakV = 0.0f;
inG = 1.0f; pSync = false; syncReq = false;
mc_resetSched();
}
]]></code.declaration>
         <code.init><![CDATA[static uint32_t s_hist[1u << 19] __attribute__ ((section (".sdram")));
static uint32_t s_dly[1u << 19] __attribute__ ((section (".sdram")));
static uint32_t s_lb[MC_LMAX + 512u] __attribute__ ((section (".sdram")));
static uint32_t s_ld[MC_LMAX + 512u] __attribute__ ((section (".sdram")));
static float s_pl[1u << 16] __attribute__ ((section (".sdram")));
static float s_eb[2u * 65536u] __attribute__ ((section (".sdram")));
hist = &s_hist[0]; dly = &s_dly[0]; lb = &s_lb[0]; ld = &s_ld[0]; eb = &s_eb[0];
pl_init(&s_pl[0]);
microcosm_coldInit();
]]></code.init>
         <code.krate><![CDATA[/* ---- parameters from the panel ---- */
{
    const float Q27 = 1.0f / 134217728.0f;
    int32_t na = inlet_algo < 0 ? 0 : (inlet_algo > 10 ? 10 : inlet_algo);
    int32_t nv = inlet_var & 3;
    if (na != algo || nv != var) {
        algo = na; var = nv;
        mc_killAll();
        mc_resetSched();
        if (algo >= 9) { dInit = true; dGain = 0.0f; }
    }
    act = (float)inlet_act * Q27; act = act < 0.0f ? 0.0f : (act > 1.0f ? 1.0f : act);
    rep = (float)inlet_rep * Q27; rep = rep < 0.0f ? 0.0f : (rep > 1.0f ? 1.0f : rep);
    {   /* SHAPE: four contours as on the pedal (the panel sends the middle of the zone) */
        int32_t s = (int32_t)((float)inlet_shp * Q27 * 4.0f);
        shI = s < 0 ? 0 : (s > 3 ? 3 : s);
        shp = 10.0f + (float)shI;
    }
    modDep = (float)inlet_mdep * Q27;
    modRate = (float)inlet_mrate * Q27;
    beat = inlet_beat < 1440 ? 1440 : (inlet_beat > 192000 ? 192000 : inlet_beat);
    if (inlet_tap && !pTap) { beatCnt = 0; stepCnt = 0; }
    pTap = inlet_tap;
    if (inlet_sync && !pSync) {                 /* MIDI clock beat: snap the grid without dropping a step */
        beatCnt = beatCnt > beat / 2 ? beat - 16 : 0;
        syncReq = true;
    }
    pSync = inlet_sync;
    beatCnt += 16;
    if (beatCnt >= beat) { beatCnt -= beat; beatPulse = 1440; }
    if (beatPulse > 0) beatPulse -= 16;
    {
        const float li = 0.05f * mc_exp2(modRate * 7.0f) * (16.0f / 48000.0f);
        lfoPh += li; if (lfoPh >= 1.0f) lfoPh -= 1.0f;
        wrpPh += li * 0.25f; if (wrpPh >= 1.0f) wrpPh -= 1.0f;     /* its own phase: no jump when the LFO wraps */
    }
    lfoVal = mc_sin1(lfoPh);
    if (inlet_hold && !pHold) {
        int32_t hl = beat * 4;
        holdLen = (uint32_t)(hl < 24000 ? 24000 : (hl > 384000 ? 384000 : hl));
    }
    pHold = inlet_hold;
    if ((int32_t)inlet_rmode != rvMode) mc_revSetup(inlet_rmode);
    seFree = attr_secho;                        /* SPACE echo: 0 follows the tempo, 1 free (120 BPM), 2 off */
    if ((bool)inlet_frev != fxRev) { fxRev = inlet_frev; mc_flipLoops(); }     /* REVERSE */
    if ((bool)inlet_lonly != lonlyS) { lonlyS = inlet_lonly; if (lonlyS) mc_killAll(); }
    /* looper */
    lspd = inlet_lspd < 16384 ? 16384 : (inlet_lspd > 262144 ? 262144 : inlet_lspd);
    lrevS = inlet_lrev;
    lpreS = inlet_lpre;
    lshape = inlet_lshape < 0 ? 0 : (inlet_lshape > 2 ? 2 : inlet_lshape);
    qlenS = inlet_qlen < 0 ? 0 : (inlet_qlen > (int32_t)MC_LMAX ? 0 : inlet_qlen);
    float fd = (float)inlet_lfade * Q27;
    lfadeT = 0.005f * mc_exp2(fd * 11.0f);
    lstep = 1.0f / (lfadeT * 48000.0f);
    bool eRec = inlet_lrec && !pRec, eStop = inlet_lstop && !pStop;
    bool eErase = inlet_lerase && !pErase, eUndo = inlet_lundo && !pUndo;
    pRec = inlet_lrec; pStop = inlet_lstop; pErase = inlet_lerase; pUndo = inlet_lundo;
    mc_loopCmd(eRec, eStop, eErase, eUndo);

    mc_block(inlet_inL, inlet_inR, outlet_outL, outlet_outR, attr_input, attr_routing, attr_output, inlet_kill, inlet_hold,
             (float)inlet_flt * Q27, (float)inlet_res * Q27, (float)inlet_mix * Q27,
             (float)inlet_fxv * Q27, (float)inlet_spc * Q27, (float)inlet_llev * Q27);

    outlet_lstate = lst;
    outlet_lpos = (int32_t)(lpos >> 16) / 48;
    outlet_llen = (lst == 1 ? lrw : llen) / 48;
    outlet_peak = (int32_t)((peakV > 1.0f ? 1.0f : peakV) * 134217727.0f);
    outlet_beatp = beatPulse > 0;
    outlet_aux = attr_routing != 0;
    outlet_inmode = attr_input;
    outlet_omono = attr_output != 0;
}
]]></code.krate>
