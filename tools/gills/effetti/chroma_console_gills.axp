         </attribs>
         <includes/>
         <code.declaration><![CDATA[/* =====================================================================
   cc_panel - Gills front panel for the Chroma-Console-style patch
   ===================================================================== */
#ifndef MC_COLD
#ifdef __clang__
#define MC_COLD __attribute__((noinline, minsize))
#else
#define MC_COLD __attribute__((noinline, optimize("Os")))
#endif
#endif
enum { UI_NP = 10, G_MAX = 3000 };          /* gesture: 30 s at 100 points a second */

float    pv[UI_NP], pShow[UI_NP], pLast[UI_NP], prim[UI_NP], sec[UI_NP];
uint8_t  pickP[UI_NP], pickS[UI_NP];
bool     shift;
int32_t  encLast, ordIdx, ticks;
uint8_t  bSt[5], bRaw[5], bCnt[5], bLong[5], bShf[5];
int32_t  bHeld[5];
int32_t  fxs[4], bypM;
int32_t  tapTick, tapInt[3], tapN;
float    tapBpm;
bool     tapR, tapT, bypAll, cpre, crec, capHeld;
int32_t  puClr, popP, popT, clipT, dispTick, dLine, blinkT;
bool     popSec;
char     ln[4][24];
/* live: MIDI pedal / clock (the MIDI handler runs in another thread and only sets these) */
bool     auxMode, clkWas;
int32_t  clkLed;
float    clkBpm;
volatile uint32_t kTime, clkW, clkLast;
volatile int32_t clkDev;                 /* port that owns the clock, -1 = none yet */
volatile uint32_t clkT[32];
volatile int32_t  clkPos, mFx[4], mByp[4], mOrd, sppQ;
volatile bool     clkBeat, clkStart, sppNew, mCap, mCapNew, mKill, mKillNew, mTap;
/* the pedal's own CC chart: queued by the MIDI thread, applied by the k-rate code */
volatile uint32_t cqW, cqR;
uint16_t cq[16];
/* tempo divisions, beat index for the DSP, I/O modes, tap undo */
int32_t  tdivZ, rdivZ, bIdx, bOut, puSync, inMode, oMono;
int32_t  svInt[3], svN, svTick;
float    svBpm;
bool     svR, svT;
/* gesture */
float   *gbuf;
int32_t  gN, gLen;
float    gPos, gStart[8], gStop[8];
uint8_t  gUsed[8];
bool     gRec, gPlay;
float    gBpm;                 /* tempo when the gesture was recorded: playback follows tempo changes */
/* CAPTURE: started while playing (= clear and record again), press time */
bool     capFromPlay;
int32_t  capT0;

MC_COLD static const uint8_t *perm(int i) {
    static const uint8_t P[24][4] = {
    {0,1,2,3},{0,1,3,2},{0,2,1,3},{0,2,3,1},{0,3,1,2},{0,3,2,1},{1,0,2,3},{1,0,3,2},
    {1,2,0,3},{1,2,3,0},{1,3,0,2},{1,3,2,0},{2,0,1,3},{2,0,3,1},{2,1,0,3},{2,1,3,0},
    {2,3,0,1},{2,3,1,0},{3,0,1,2},{3,0,2,1},{3,1,0,2},{3,1,2,0},{3,2,0,1},{3,2,1,0} };
    return P[i < 0 ? 0 : (i > 23 ? 23 : i)];
}
/* where the clock comes from, for the OLED: DIN = MIDI IN, USB = from the computer, HOST = USB host */
MC_COLD const char *clkTag() {
    switch (clkDev) { case 1: return "DIN"; case 2: return "USB"; case 3: return "HOST"; default: return "CLK"; }
}
MC_COLD static const char *fxShort(int m, int e) {
    static const char *n[20] = { "DRIV", "SWTN", "FUZZ", "HOWL", "SWEL", "DUBL", "VIBR", "PHAS", "TREM", "PTCH",
                                 "CASC", "REEL", "SPAC", "COLG", "REVR", "FILT", "SQSH", "CASS", "BRKN", "INTF" };
    return n[m * 5 + e];
}
MC_COLD static const char *fxLong(int m, int e) {
    static const char *n[20] = { "DRIVE", "SWEETEN", "FUZZ", "HOWL", "SWELL", "DOUBLER", "VIBRATO", "PHASER",
                                 "TREMOLO", "PITCH", "CASCADE", "REELS", "SPACE", "COLLAGE", "REVERSE",
                                 "FILTER", "SQUASH", "CASSETTE", "BROKEN", "INTERFERENCE" };
    return n[m * 5 + e];
}
/* SHIFT: P1 SENSITIVITY (as on the pedal), P2 P4 P6 P7 module volumes, P8 OUTPUT, P10 FILTER STYLE */
static bool hasSec(int i) { return i == 0 || i == 1 || i == 3 || i == 5 || i == 6 || i == 7 || i == 9; }
MC_COLD static char *uPut(char *p, const char *s) { while (*s) *p++ = *s++; return p; }
MC_COLD static char *uNum(char *p, int32_t v, int w) {
    char t[12]; int n = 0; bool neg = v < 0;
    uint32_t u = neg ? (uint32_t)(-v) : (uint32_t)v;
    do { t[n++] = (char)('0' + u % 10u); u /= 10u; } while (u && n < 11);
    if (neg) t[n++] = '-';
    while (w-- > n) *p++ = ' ';
    while (n) *p++ = t[--n];
    return p;
}
MC_COLD static char *uDec1(char *p, int32_t tenths, int w) {
    if (tenths < 0) tenths = 0;
    p = uNum(p, tenths / 10, w - 2);
    *p++ = '.';
    *p++ = (char)('0' + tenths % 10);
    return p;
}
MC_COLD static void uEnd(char *line, char *p) { char *e = line + 21; while (p < e) *p++ = ' '; *e = 0; }
static int32_t pct(float v) { int32_t r = (int32_t)(v * 100.0f + 0.5f); return r > 99 ? 99 : r; }
MC_COLD static float uExp2(float o) {                 /* 2^o for o >= 0 */
    int oi = (int)o; float fr = o - (float)oi, f = 1.0f;
    for (int k = 0; k < oi; k++) f *= 2.0f;
    return f * (1.0f + fr * (0.6931f + fr * (0.2402f + fr * 0.0555f)));
}
MC_COLD static int zoneOf(float v, int n, int cur) {
    float w = 1.0f / (float)n;
    float lo = (float)cur * w - 0.02f, hi = (float)(cur + 1) * w + 0.02f;
    if (v >= lo && v <= hi) return cur;
    int z = (int)(v * (float)n);
    return z < 0 ? 0 : (z >= n ? n - 1 : z);
}
int32_t fstyleZ;

MC_COLD void popText(int i, bool s, char *l2, char *l3) {
    if (i == 200) {                                   /* start-up: MIDI channel, clock, I/O */
        char *q = l2;
        if (attr_midich == 0) q = uPut(q, "MIDI OMNI  ");
        else { q = uPut(q, "MIDI CH "); q = uNum(q, attr_midich, 2); *q++ = ' '; }
        q = uPut(q, attr_clock ? " CLK SLAVE" : " CLK OFF");
        uEnd(l2, q);
        static const char *im[3] = { "STEREO", "MONO L", "L+R" };
        q = l3;
        q = uPut(q, "IN "); q = uPut(q, im[(inMode < 0 || inMode > 2) ? 0 : inMode]);
        q = uPut(q, "  OUT "); q = uPut(q, oMono ? "MONO" : "ST");
        uEnd(l3, q);
        return;
    }
    static const char *pn[UI_NP] = { "TILT", "CHAR AMOUNT", "RATE", "MOVE AMOUNT", "TIME", "DIFF AMOUNT",
                                     "TEXT AMOUNT", "MIX", "DRIFT MOVE", "DRIFT DIFF" };
    static const char *sn[UI_NP] = { "SENSITIVITY", "CHAR VOL", "", "MOVE VOL", "", "DIFF VOL",
                                     "TEXT VOL", "OUTPUT", "", "FILT STYLE" };
    char *p = l2;
    if (i == 107) {                                   /* tempo follow off */
        p = uPut(p, "TEMPO OFF"); uEnd(l2, p);
        p = l3; p = uPut(p, "RATE / TIME free"); uEnd(l3, p);
        return;
    }
    if (i >= 100) {                                   /* effect / bypass change */
        static const char *mn[4] = { "CHARACTER ", "MOVEMENT ", "DIFFUSION ", "TEXTURE " };     /* TEXTURE INTERFERENCE = 20 */
        int m = i - 100;
        p = uPut(p, mn[m]);
        p = uPut(p, fxLong(m, fxs[m]));
        uEnd(l2, p);
        p = l3;
        p = uPut(p, (bypM >> m) & 1 ? "  module BYPASSED" : "  ");
        if (!((bypM >> m) & 1)) { p = uNum(p, fxs[m] + 1, 1); p = uPut(p, "/5"); }
        uEnd(l3, p);
        return;
    }
    float v = s ? sec[i] : prim[i];
    p = uPut(p, s ? sn[i] : pn[i]);
    while (p < l2 + 11) *p++ = ' ';                 /* 11 + value (8) + " ~" = 21 */
    if (s && i == 9) { static const char *fs[3] = { "LOW-PASS", "TILT", "HIGH-PASS" }; p = uPut(p, fs[fstyleZ]); }
    else if (!s && i == 2 && fxs[1] == 4) {           /* PITCH: continuous, +-12 semitones, none around the centre */
        float u = (v - 0.5f) * 2.0f, a = u < 0.0f ? -u : u;
        a = a < 0.05f ? 0.0f : (a - 0.05f) * (1.0f / 0.95f);
        int32_t t10 = (int32_t)(a * 120.0f + 0.5f);
        if (t10 == 0) p = uPut(p, "0.0");
        else { *p++ = u < 0.0f ? '-' : '+'; p = uDec1(p, t10, 1); }
        p = uPut(p, " st");
    } else if (!s && i == 4 && fxs[2] == 4) {         /* REVERSE: speed of the backwards chunks */
        float sp = (v > 0.47f && v < 0.53f) ? 1.0f : (v < 0.5f ? 1.0f / uExp2((0.5f - v) * 2.0f) : uExp2((v - 0.5f) * 2.0f));
        *p++ = 'x'; p = uDec1(p, (int32_t)(sp * 10.0f + 0.5f), 1);
    } else if (!s && i == 2) {
        static const char *rn[8] = { "4BAR", "2BAR", "1BAR", "1/2", "1/4", "1/8", "1/8T", "1/16" };
        if (tapR) { p = uPut(p, rn[rdivZ & 7]); p = uPut(p, clkWas ? " CLK" : " TAP"); }
        else { p = uDec1(p, (int32_t)(0.05f * uExp2(v * 8.0f) * 10.0f + 0.5f), 4); p = uPut(p, "Hz"); }
    } else if (!s && i == 4 && fxs[2] != 2 && fxs[2] != 4) {
        static const char *tn[8] = { "1/16", "1/8T", "1/8", "1/8.", "1/4", "1/4.", "1/2", "1/2." };
        if (tapT) { p = uPut(p, tn[tdivZ & 7]); p = uPut(p, clkWas ? " CLK" : " TAP"); }
        else { p = uNum(p, (int32_t)(30.0f * uExp2(v * 5.3f)), 4); p = uPut(p, "ms"); }
    } else p = uNum(p, pct(v), 3);
    if (s ? pickS[i] : pickP[i]) p = uPut(p, " ~");
    uEnd(l2, p);
    char *q = l3;
    *q++ = '[';
    int fill = (int)(v * 19.0f + 0.5f), pot = (int)(pv[i] * 19.0f + 0.5f);
    bool pend = s ? pickS[i] : pickP[i];
    for (int k = 0; k < 19; k++) *q++ = (pend && k == pot) ? 'o' : (k < fill ? '#' : '-');
    *q++ = ']';
    uEnd(l3, q);
}

MC_COLD void drawLine(int n, int32_t cs, int32_t clenMs) {
    char *l = ln[n], *p = l;
    if (n == 0) {
        for (int m = 0; m < 4; m++) {
            const char *s = fxShort(m, fxs[m]);
            bool off = (bypM >> m) & 1;
            for (int k = 0; k < 4; k++) *p++ = off ? (char)(s[k] + 32) : s[k];
            if (m < 3) *p++ = ' ';
        }
        uEnd(l, p);
        return;
    }
    if (n == 1 || n == 2) {
        if (popT > 0) { if (n == 1) popText(popP, popSec, ln[1], ln[2]); return; }
        if (n == 1) {
            if (shift) {
                static const char *fs[3] = { "LP", "TILT", "HP" };
                p = uPut(p, "OUT"); p = uNum(p, pct(sec[7]), 3);
                p = uPut(p, " SNS"); p = uNum(p, pct(sec[0]), 3);
                p = uPut(p, " F:"); p = uPut(p, fs[fstyleZ]);
            } else {
                static const char cm[4] = { 'C', 'M', 'D', 'T' };
                for (int k = 0; k < 4; k++) { *p++ = cm[perm(ordIdx)[k]]; if (k < 3) *p++ = '>'; }
                p = uPut(p, cpre ? "  PRE  " : "  POST ");
                if (tapR || tapT) p = uNum(p, (int32_t)(tapBpm + 0.5f), 3); else p = uPut(p, "---");
                p = uPut(p, clkWas ? clkTag() : "BPM");
            }
        } else {
            if (shift) {
                p = uPut(p, "VOL C"); p = uNum(p, pct(sec[1]), 2);
                p = uPut(p, " M"); p = uNum(p, pct(sec[3]), 2);
                p = uPut(p, " D"); p = uNum(p, pct(sec[5]), 2);
                p = uPut(p, " T"); p = uNum(p, pct(sec[6]), 2);
            } else {
                if (bypAll) { p = uPut(p, "BYPASS      "); p = uPut(p, auxMode ? "AUX" : "MIX"); p = uNum(p, pct(prim[7]), 3); }
                else {
                    p = uPut(p, auxMode ? "AUX" : "MIX"); p = uNum(p, pct(prim[7]), 3);
                    p = uPut(p, " DRM"); p = uNum(p, pct(prim[8]), 3);      /* DRIFT of Movement, of Diffusion */
                    p = uPut(p, " DRD"); p = uNum(p, pct(prim[9]), 3);
                }
            }
        }
        uEnd(l, p);
        return;
    }
    int st = cs & 15, md = (cs >> 4) & 1;
    p = uPut(p, "CAP ");
    p = uPut(p, st == 1 ? "REC " : (st == 2 ? (md ? "SUST" : "LOOP") : "----"));
    *p++ = ' ';
    if (st) { p = uDec1(p, clenMs / 100, 4); *p++ = 's'; } else p = uPut(p, "     ");
    p = uPut(p, " G:");
    p = uPut(p, gRec ? "REC " : (gPlay ? "PLAY" : "----"));
    uEnd(l, p);
}

MC_COLD int btn(int k, bool raw) {
    uint8_t r = raw ? 1 : 0;
    if (r != bRaw[k]) { bRaw[k] = r; bCnt[k] = 0; }
    else if (bCnt[k] < 12) bCnt[k]++;
    if (bCnt[k] == 8 && bSt[k] != r) {
        bSt[k] = r;
        if (r) { bHeld[k] = 0; bLong[k] = 0; bShf[k] = shift ? 1 : 0; return 1; }
        return -1;
    }
    if (bSt[k]) bHeld[k]++;
    return 0;
}

MC_COLD void doTap() {
    if (tapTick > 150) {
        if (tapTick < 7500) {
            tapInt[2] = tapInt[1]; tapInt[1] = tapInt[0]; tapInt[0] = tapTick;
            if (tapN < 3) tapN++;
            int32_t s = 0;
            for (int k = 0; k < tapN; k++) s += tapInt[k];
            tapBpm = 180000.0f * (float)tapN / (float)s;
            if (tapBpm < 20.0f) tapBpm = 20.0f;
            if (tapBpm > 300.0f) tapBpm = 300.0f;
            tapR = true; tapT = true;
        } else tapN = 0;
        tapTick = 0;
    }
}

MC_COLD void gestureTick() {
    if (gRec) {
        if ((ticks % 30) == 0 && gN < G_MAX) {
            for (int k = 0; k < 8; k++) {
                gbuf[gN * 8 + k] = prim[k];
                float d = prim[k] - gStart[k];
                if (d > 0.02f || d < -0.02f) gUsed[k] = 1;
            }
            gN++;
        }
        return;
    }
    if (!gPlay || gLen < 2) return;
    gPos += (1.0f / 30.0f) * (gBpm > 0.0f ? tapBpm / gBpm : 1.0f);
    if (gPos >= (float)(gLen - 1)) gPos -= (float)(gLen - 1);
    int i0 = (int)gPos;
    float f = gPos - (float)i0;
    bool any = false;
    for (int k = 0; k < 8; k++) {
        if (!gUsed[k]) continue;
        float d = pv[k] - gStop[k];
        if (d > 0.04f || d < -0.04f) { gUsed[k] = 0; continue; }       /* moving a knob deletes its gesture */
        float a = gbuf[i0 * 8 + k], b = gbuf[(i0 + 1) * 8 + k];
        prim[k] = a + f * (b - a);
        any = true;
    }
    if (!any) gPlay = false;
}

/* CAPTURE (SHIFT+B2 or CC64): press = record while held, release = play (short = pad, long = loop).
   Pressed while it plays: the old one is cleared and the new one records at once; a quick tap
   (under 0.25 s) instead just stops and deletes it. */
MC_COLD void capPress(int32_t cs) {
    capFromPlay = (cs & 15) == 2;
    if (capFromPlay) puClr = 3;
    crec = true; capHeld = true; capT0 = ticks;
}
MC_COLD void capRelease() {
    if (!capHeld) return;
    crec = false; capHeld = false;
    if (capFromPlay && ticks - capT0 < 750) puClr = 3;
}

/* GESTURE: start recording, or stop recording and play what moved */
MC_COLD void gestToggle() {
    if (gRec) {
        gRec = false; gLen = gN;
        bool any = false;
        for (int j = 0; j < 8; j++) { gStop[j] = pv[j]; if (gUsed[j]) any = true; }
        gPlay = any && gLen >= 2; gPos = 0.0f;
    } else {
        gRec = true; gPlay = false; gN = 0; gBpm = tapBpm;
        for (int j = 0; j < 8; j++) { gStart[j] = prim[j]; gUsed[j] = 0; }
    }
}
MC_COLD void gestClear() {
    gRec = false; gPlay = false; gN = 0; gLen = 0;
    for (int j = 0; j < 8; j++) gUsed[j] = 0;
}
/* the CC chart of the pedal. Knobs: 64 TILT, 65 Character amount, 66 RATE, 67 Movement amount, 68 TIME,
   69 Diffusion amount, 70 MIX, 71 Texture amount; 72 SENSITIVITY, 73 Character volume, 74 DRIFT of
   Movement, 75 Movement volume, 76 DRIFT of Diffusion, 77 Diffusion volume, 78 OUTPUT, 79 Texture volume.
   16-19 effect of each module (0-21, 22-43, 44-65, 66-87, 88-109; 110-127 = module off). 80 gesture
   play (0-63) / record (64-127), 81 gesture stop and erase. 82 capture: 0-43 stop and clear, 44-87
   play, 88-127 record. 83 capture PRE (64-127). 84 filter style: 0-43 low-pass, 44-87 tilt, 88-127
   high-pass. 91 bypass (0-63) / engage. 93 tap. 103-106 module bypass (0-63) / engage.
   With midimap = live, 64 80 82 keep their live meaning (capture, bypass, tap). */
MC_COLD void pedalCC(int cc, int v, int32_t cs) {
    static const uint8_t kn[16] = { 0, 1, 2, 3, 4, 5, 7, 6, 16 + 0, 16 + 1, 8, 16 + 3, 9, 16 + 5, 16 + 7, 16 + 6 };
    const float f = (float)v * (1.0f / 127.0f);
    const bool on = v >= 64;
    if (cc >= 64 && cc <= 79) {
        int k = kn[cc - 64];
        if (k < 16) { prim[k] = f; pickP[k] = 1; if (k < 8) gUsed[k] = 0; }
        else { sec[k - 16] = f; pickS[k - 16] = 1; }
    } else if (cc >= 16 && cc <= 19) {
        int m = cc - 16, e = v / 22;
        if (e > 4) bypM |= (1 << m);
        else { fxs[m] = e; bypM &= ~(1 << m); }
        popP = 100 + m; popSec = false; popT = 3000;
    } else if (cc >= 103 && cc <= 106) {
        if (on) bypM &= ~(1 << (cc - 103)); else bypM |= (1 << (cc - 103));
    } else switch (cc) {
        case 80: if (on != gRec) gestToggle(); break;
        case 81: gestClear(); break;
        case 82:
            if (v >= 88) { if (!capHeld) capPress(cs); }
            else if (v >= 44) capRelease();
            else { crec = false; capHeld = false; puClr = 3; }
            break;
        case 83: cpre = on; break;
        case 84: sec[9] = v < 44 ? 0.1667f : (v < 88 ? 0.5f : 0.8333f); pickS[9] = 1; break;
        case 91: bypAll = !on; break;
        case 93: if (v > 0) doTap(); break;
        default: break;
    }
}

/* MIDI: pedal CCs, module CCs, clock = tempo for RATE / TIME */
MC_COLD void midiTick(int32_t cs) {
    kTime = kTime + 1u;
    bool on = clkW > 0u && (uint32_t)(kTime - clkLast) < 1500u;        /* clock seen in the last 0.5 s */
    if ((on && !clkWas) || clkStart) { if (clkStart) bIdx = 0; clkStart = false; tapR = true; tapT = true; }
    if (sppNew) { sppNew = false; bIdx = sppQ; }
    clkWas = on;
    if (clkLed > 0) clkLed--;
    if (clkBeat) {
        clkBeat = false;
        clkLed = 90;
        bOut = bIdx; bIdx++; puSync = 3;
        uint32_t w = clkW;
        if (w > 24u) {
            uint32_t dt = clkT[(w - 1u) & 31u] - clkT[(w - 25u) & 31u];   /* one quarter note, in k-cycles */
            if (dt >= 600u && dt <= 9000u) {
                float bb = 180000.0f / (float)dt;
                clkBpm = clkBpm > 0.0f ? clkBpm + (bb - clkBpm) * 0.35f : bb;
                float e = clkBpm - tapBpm; if (e < 0.0f) e = -e;
                if (e > tapBpm * 0.004f) tapBpm = clkBpm;
            }
        }
    }
    if (mKillNew) { mKillNew = false; bypAll = mKill; }
    if (mTap) { mTap = false; doTap(); }
    if (mCapNew) {                                   /* CC64 behaves like SHIFT+B2 */
        mCapNew = false;
        if (mCap) capPress(cs);
        else capRelease();
    }
    for (int m = 0; m < 4; m++) {
        int32_t f = mFx[m];
        if (f >= 0) { mFx[m] = -1; fxs[m] = f > 4 ? 4 : f; popP = 100 + m; popSec = false; popT = 3000; }
        int32_t y = mByp[m];
        if (y >= 0) { mByp[m] = -1; if (y) bypM |= (1 << m); else bypM &= ~(1 << m); }
    }
    int32_t o = mOrd;
    if (o >= 0) { mOrd = -1; ordIdx = o > 23 ? 23 : o; }
    while (cqR != cqW) { uint16_t ev = cq[cqR & 15u]; cqR = cqR + 1u; pedalCC(ev >> 7, ev & 127, cs); }
}

MC_COLD void uiTick(const int32_t *pot, const bool *b, int32_t enc, bool esw, int32_t cs) {
    ticks++;
    midiTick(cs);
    tapTick++;
    if (tapTick > 100000) tapTick = 100000;
    int e = btn(4, esw);
    if (e == 1) { shift = true; for (int i = 0; i < UI_NP; i++) if (hasSec(i)) pickS[i] = 1; }
    if (e == -1) { shift = false; for (int i = 0; i < UI_NP; i++) if (hasSec(i)) pickP[i] = 1; }
    for (int i = 0; i < UI_NP; i++) {
        float raw = (float)pot[i] * (1.0f / 134217728.0f);
        raw = raw < 0.0f ? 0.0f : (raw > 1.0f ? 1.0f : raw);
        if (ticks < 30) { pv[i] = raw; pLast[i] = raw; pShow[i] = raw; prim[i] = raw; continue; }
        pv[i] += (raw - pv[i]) * 0.06f;
        float c = pv[i];
        bool s = shift && hasSec(i);
        bool ges = !s && i < 8 && gPlay && gUsed[i];
        float *t = s ? &sec[i] : &prim[i];
        uint8_t *pk = s ? &pickS[i] : &pickP[i];
        bool moved = (c - pShow[i] > 0.012f) || (pShow[i] - c > 0.012f);
        if (*pk) {
            float a = pLast[i] - *t, d = c - *t;
            if ((a <= 0.0f && d >= 0.0f) || (a >= 0.0f && d <= 0.0f) || (d < 0.015f && d > -0.015f)) *pk = 0;
            if (s && i == 9 && moved) *pk = 0;            /* FILTER STYLE is a selector: any move takes it */
        }
        if (!*pk && !ges) *t = c;
        if (moved && ticks > 900) {
            pShow[i] = c;
            popP = i; popSec = s; popT = 4500;

        }
        pLast[i] = c;
    }
    fstyleZ = zoneOf(sec[9], 3, fstyleZ);
    rdivZ = zoneOf(prim[2], 8, rdivZ);              /* note divisions while RATE / TIME follow the tempo */
    tdivZ = zoneOf(prim[4], 8, tdivZ);
    gestureTick();
    if (popT > 0) popT--;
    int32_t d = enc - encLast;
    encLast = enc;
    if (d) {
        if (shift) cpre = !cpre;
        else { ordIdx += d; while (ordIdx < 0) ordIdx += 24; while (ordIdx >= 24) ordIdx -= 24; }
        popT = 0;
    }
    /* module buttons: short = next effect, hold = bypass module; with SHIFT: TAP, CAPTURE, GESTURE, BYPASS */
    for (int k = 0; k < 4; k++) {
        int r = btn(k, b[k]);
        if (r == 1 && bShf[k]) {
            if (k == 0) {
                for (int j = 0; j < 3; j++) svInt[j] = tapInt[j];
                svN = tapN; svTick = tapTick; svBpm = tapBpm; svR = tapR; svT = tapT;
                doTap();
            }
            if (k == 1) capPress(cs);
            if (k == 2) gestToggle();
            if (k == 3) bypAll = !bypAll;
        }
        if (r == -1) {
            if (k == 1) capRelease();
            if (!bShf[k] && !bLong[k]) { fxs[k] = (fxs[k] + 1) % 5; popP = 100 + k; popSec = false; popT = 4500; }
        }
        if (bSt[k] && !bLong[k] && !bShf[k] && bHeld[k] > 1800) {
            bLong[k] = 1; bypM ^= (1 << k); popP = 100 + k; popSec = false; popT = 4500;
        }
        if (bSt[k] && !bLong[k] && bShf[k] && k == 0 && bHeld[k] > 3000) {   /* SHIFT+B1 held: tempo follow off */
            bLong[k] = 1;
            for (int j = 0; j < 3; j++) tapInt[j] = svInt[j];
            tapN = svN; tapTick = svTick + bHeld[k]; tapBpm = svBpm;
            tapR = false; tapT = false;
            popP = 107; popSec = false; popT = 4500;
        }
        if (bSt[k] && !bLong[k] && bShf[k] && k == 2 && bHeld[k] > 3000) {   /* SHIFT+B3 held: clear gestures */
            bLong[k] = 1; gestClear();
        }
    }
}

MC_COLD void panel_coldInit() {
for (int i = 0; i < G_MAX * 8 + 8; i++) gbuf[i] = 0.0f;
for (int i = 0; i < UI_NP; i++) { pv[i] = pShow[i] = pLast[i] = 0.0f; prim[i] = 0.5f; sec[i] = 0.5f; pickP[i] = 0; pickS[i] = 1; }
sec[9] = 0.0f; prim[8] = prim[9] = 0.0f;      /* filter style TILT, both DRIFT at zero */
cqW = 0u; cqR = 0u;
shift = false; encLast = 0; ordIdx = 0; ticks = 0;
for (int k = 0; k < 5; k++) { bSt[k] = bRaw[k] = bCnt[k] = bLong[k] = bShf[k] = 0; bHeld[k] = 0; }
for (int m = 0; m < 4; m++) fxs[m] = 0;
fxs[2] = 2;            /* start on DRIVE > DOUBLER > SPACE > FILTER */
bypM = 0;
tapTick = 0; tapN = 0; tapInt[0] = tapInt[1] = tapInt[2] = 1500; tapBpm = 120.0f;
tapR = tapT = bypAll = cpre = crec = capHeld = false;
puClr = 0; popP = 0; popT = 0; popSec = false; clipT = 0; dispTick = 0; dLine = 0; blinkT = 0; fstyleZ = 0;
gN = 0; gLen = 0; gPos = 0.0f; gRec = false; gPlay = false;
for (int k = 0; k < 8; k++) { gStart[k] = gStop[k] = 0.0f; gUsed[k] = 0; }
auxMode = true; clkWas = false; clkLed = 0; clkBpm = 0.0f;
kTime = 0u; clkW = 0u; clkLast = 0u; clkPos = 0; clkDev = -1; mOrd = -1;
for (int k = 0; k < 32; k++) clkT[k] = 0u;
for (int m = 0; m < 4; m++) { mFx[m] = -1; mByp[m] = -1; }
clkBeat = clkStart = sppNew = mCap = mCapNew = mKill = mKillNew = mTap = false;
sppQ = 0; tdivZ = 4; rdivZ = 4; bIdx = 0; bOut = 0; puSync = 0; inMode = 1; oMono = 0;
gBpm = 120.0f; capFromPlay = false; capT0 = 0;
for (int j = 0; j < 3; j++) svInt[j] = 1500;
svN = 0; svTick = 0; svBpm = 120.0f; svR = svT = false;
popP = 200; popSec = false; popT = 7500;                  /* start-up screen */
for (int n = 0; n < 4; n++) drawLine(n, 0, 0);
}
]]></code.declaration>
         <code.init><![CDATA[static float s_gbuf[G_MAX * 8 + 8] __attribute__ ((section (".sdram")));
gbuf = &s_gbuf[0];
panel_coldInit();
]]></code.init>
         <code.krate><![CDATA[{
    int32_t pots[UI_NP] = { inlet_p1, inlet_p2, inlet_p3, inlet_p4, inlet_p5,
                            inlet_p6, inlet_p7, inlet_p8, inlet_p9, inlet_p10 };
    bool bs[4] = { inlet_b1, inlet_b2, inlet_b3, inlet_b4 };
    auxMode = inlet_aux; inMode = inlet_inmode; oMono = inlet_omono;
    uiTick(pots, bs, inlet_enc, inlet_esw, inlet_cstate);
    const float F = 134217727.0f;
    outlet_fx = fxs[0] | (fxs[1] << 3) | (fxs[2] << 6) | (fxs[3] << 9);
    outlet_byp = bypM;
    { const uint8_t *pm = perm(ordIdx); outlet_ord = pm[0] | (pm[1] << 2) | (pm[2] << 4) | (pm[3] << 6); }
    outlet_tilt = (int32_t)(prim[0] * F);
    outlet_camt = (int32_t)(prim[1] * F);
    outlet_rate = (int32_t)(prim[2] * F);
    outlet_mamt = (int32_t)(prim[3] * F);
    outlet_time = (int32_t)(prim[4] * F);
    outlet_damt = (int32_t)(prim[5] * F);
    outlet_tamt = (int32_t)(prim[6] * F);
    outlet_mix = (int32_t)(prim[7] * F);
    outlet_driftm = (int32_t)(prim[8] * F);
    outlet_driftd = (int32_t)(prim[9] * F);
    outlet_sens = (int32_t)(sec[0] * F);
    outlet_fstyle = fstyleZ == 0 ? 1 : (fstyleZ == 1 ? 0 : 2);      /* zones in the pedal's order: low-pass, tilt, high-pass */
    outlet_cvol = (int32_t)(sec[1] * F);
    outlet_mvol = (int32_t)(sec[3] * F);
    outlet_dvol = (int32_t)(sec[5] * F);
    outlet_tvol = (int32_t)(sec[6] * F);
    outlet_olev = (int32_t)(sec[7] * F);
    outlet_beat = (int32_t)(2880000.0f / tapBpm);
    outlet_tapr = tapR;
    outlet_tapt = tapT;
    outlet_tdiv = tdivZ;
    outlet_rdiv = rdivZ;
    outlet_bidx = bOut;
    outlet_sync = puSync > 0;
    if (puSync > 0) puSync--;
    outlet_bypall = bypAll;
    outlet_crec = crec;
    outlet_cclr = puClr > 0;
    if (puClr > 0) puClr--;
    outlet_cpre = cpre;
    if (++dispTick >= 40) {
        dispTick = 0;
        drawLine(dLine, inlet_cstate, inlet_clen);
        dLine = (dLine + 1) & 3;
    }
    outlet_l1 = &ln[0][0];
    outlet_l2 = &ln[1][0];
    outlet_l3 = &ln[2][0];
    outlet_l4 = &ln[3][0];
    const int32_t LM = 0x7F80000;
    blinkT = (blinkT + 1) % 750;
    outlet_led1 = (clkWas ? clkLed > 0 : inlet_beatp) ? LM : 0;
    float pk = (float)inlet_peak * (1.0f / 134217728.0f);
    if (pk > 0.89f) clipT = 600;
    if (bypAll) outlet_led2 = LM;
    else if (clipT > 0) { clipT--; outlet_led2 = LM; }
    else outlet_led2 = (int32_t)(pk * pk * 0.6f * (float)LM);
    int32_t cs = inlet_cstate & 15;
    outlet_led3r = (cs == 1) ? LM : 0;
    outlet_led3b = (cs == 2) ? (((inlet_cstate >> 4) & 1) ? LM / 3 : LM) : 0;
    outlet_led4r = (gRec || (shift && !gPlay)) ? ((gRec && blinkT > 375) ? 0 : LM) : 0;
    outlet_led4b = gPlay ? LM : 0;
}
]]></code.krate>
         <code.midihandler><![CDATA[{
    /* runs in the MIDI thread: only flags and timestamps, the k-rate code applies them */
    if (status >= 0xF0) {                         /* system: clock slave (attribute clock) */
        if (attr_clock == 0) return;
        /* one port owns the clock (MIDI IN, USB from the computer, USB host): the first that
           sends it keeps it until it is silent for 0.5 s, so the same clock arriving on two
           ports is not counted twice */
        if (status == 0xF8 || status == 0xFA || status == 0xF2) {
            if (clkW > 0u && (uint32_t)(kTime - clkLast) < 1500u && (int32_t)dev != clkDev) return;
            clkDev = (int32_t)dev;
        }
        if (status == 0xF8) {                     /* clock, 24 per quarter note */
            uint32_t w = clkW;
            clkT[w & 31u] = kTime;
            clkW = w + 1u;
            clkLast = kTime;
            int32_t p = clkPos + 1;
            if (p >= 24) p = 0;
            clkPos = p;
            if (p == 0) clkBeat = true;
        } else if (status == 0xFA) {              /* start: the next clock is beat 1 */
            clkPos = 23; clkStart = true;
        } else if (status == 0xF2) {              /* song position (16ths) */
            int32_t pos = (int32_t)data1 | ((int32_t)data2 << 7);
            clkPos = (pos * 6 + 23) % 24;
            sppQ = (pos + 3) / 4; sppNew = true;
        }
        return;
    }
    if (attr_midich > 0 && (int32_t)(status & 0x0F) != attr_midich - 1) return;   /* channel filter */
    if ((status & 0xF0) == 0xB0) {
        bool on = data2 >= 64;
        /* midimap = live: three CCs keep their stage meaning; midimap = pedal: all as in the pedal's chart */
        if (attr_midimap == 0 && data1 == 64) { mCap = on; mCapNew = true; }                 /* sustain pedal = CAPTURE */
        else if (attr_midimap == 0 && data1 == 80) { mKill = on; mKillNew = true; }          /* BYPASS with trails */
        else if (attr_midimap == 0 && data1 == 82) { if (on) mTap = true; }                  /* tap tempo */
        else if (data1 >= 20 && data1 <= 23) mFx[data1 - 20] = (int32_t)data2 * 5 / 128;    /* module effect */
        else if (data1 >= 24 && data1 <= 27) mByp[data1 - 24] = on ? 1 : 0;                 /* module bypass */
        else if (data1 == 28) mOrd = (int32_t)data2 * 24 / 128;                            /* module order */
        else if ((data1 >= 16 && data1 <= 19) || (data1 >= 64 && data1 <= 84) || data1 == 91 || data1 == 93 ||
                 (data1 >= 103 && data1 <= 106)) {
            uint32_t w = cqW;                                           /* the pedal's own CC chart */
            if (w - cqR < 16u) { cq[w & 15u] = (uint16_t)(((uint32_t)data1 << 7) | (data2 & 127u)); cqW = w + 1u; }
        }
    }
}
]]></code.midihandler>
