               </CEntries>
            </combo>
            <combo name="anticipo" description="aux: the way to the mixer and back, ms (SHIFT+encoder on the page changes it)">
               <MenuEntries>
                  <string>1.5 ms</string>
                  <string>0 ms</string>
                  <string>0.5 ms</string>
                  <string>1.0 ms</string>
                  <string>2.0 ms</string>
                  <string>2.5 ms</string>
                  <string>3.0 ms</string>
               </MenuEntries>
               <CEntries>
                  <string>1.5f</string>
                  <string>0.0f</string>
                  <string>0.5f</string>
                  <string>1.0f</string>
