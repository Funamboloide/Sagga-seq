         <combo attributeName="output" selection="stereo"/>
      </attribs>
      <object id="patch/object" uuid="7e6de498-7f0d-5a36-b28c-fdb3aa4a560b">
         <sDescription>Chroma-Console-style multi-effect: Character, Movement, Diffusion, Texture (5 effects each), re-orderable, capture looper/sustainer. Uses about 7.3 MB of SDRAM. routing: mix = wet-only chain plus a real dry/wet (MIX fully up = effect alone, for a bus), insert = the pedal, modules in series, aux = send/return only (never any dry, MIX = return level). output: stereo or mono (L+R on both jacks).</sDescription>
         <author>Claude for Ksoloti Gills</author>
         <license>BSD</license>
         <inlets>
            <frac32buffer name="inL" description="audio in left"/>
            <frac32buffer name="inR" description="audio in right"/>
            <int32 name="fx" description="effects, 3 bits per module"/>
            <int32 name="byp" description="bypassed modules bitmask"/>
            <int32 name="ord" description="module order, 2 bits per slot"/>
            <frac32.positive name="tilt" description="character tilt"/>
            <frac32.positive name="camt" description="character amount"/>
            <frac32.positive name="rate" description="movement rate"/>
            <frac32.positive name="mamt" description="movement amount"/>
            <frac32.positive name="time" description="diffusion time"/>
            <frac32.positive name="damt" description="diffusion amount"/>
            <frac32.positive name="tamt" description="texture amount"/>
            <frac32.positive name="mix" description="dry/wet"/>
            <frac32.positive name="driftm" description="drift of Movement"/>
            <frac32.positive name="driftd" description="drift of Diffusion"/>
            <frac32.positive name="sens" description="sensitivity"/>
            <int32 name="fstyle" description="texture filter style 0 tilt 1 lp 2 hp"/>
            <frac32.positive name="cvol" description="character volume"/>
            <frac32.positive name="mvol" description="movement volume"/>
            <frac32.positive name="dvol" description="diffusion wet volume"/>
            <frac32.positive name="tvol" description="texture volume"/>
            <frac32.positive name="olev" description="output level (32 = unity)"/>
