            <bool32 name="tapr" description="rate follows tap"/>
            <bool32 name="tapt" description="time follows tap"/>
            <bool32 name="bypall" description="bypass all"/>
            <bool32 name="crec" description="capture record (held)"/>
            <bool32 name="cclr" description="capture clear"/>
