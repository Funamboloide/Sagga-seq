         <includes/>
         <code.declaration><![CDATA[/* =====================================================================
   chroma - "Chroma Console"-style multi-effect for Ksoloti Gills
   4 modules (CHARACTER, MOVEMENT, DIFFUSION, TEXTURE) x 5 effects,
   re-orderable chain, per-module bypass/volume, DRIFT, SENSITIVITY,
   MIX, OUTPUT, CAPTURE looper/sustainer (30 s). Big buffers in SDRAM.
   ===================================================================== */
#ifndef MC_COLD
#ifdef __clang__
#define MC_COLD __attribute__((noinline, minsize))
#else
#define MC_COLD __attribute__((noinline, optimize("Os")))
#endif
#endif
/* the audio functions are built as the patcher builds everything (-O3): the patch has the room for it */
#ifndef MC_HOT
#define MC_HOT
#endif

static const uint32_t CC_MMASK = (1u << 14) - 1u;     /* movement delay 16384 frames (DOUBLER slapback) */
static const uint32_t CC_DMASK = (1u << 17) - 1u;     /* diffusion delay 131072 frames (2.7 s) */
static const uint32_t CC_TMASK = (1u << 11) - 1u;     /* texture delay 2048 frames */
static const uint32_t CC_CMAX  = 48000u * 30u;        /* capture 30 s */
enum { CC_XS = 480 };

/* memory */
float    *mbuf;          /* movement delay, interleaved stereo */
float    *dbuf;          /* diffusion delay, interleaved stereo */
float    *tbuf;          /* texture delay, interleaved stereo */
uint32_t *cap;           /* capture, packed stereo int16 */
uint32_t mw, dw, tw;
uint32_t rng;

/* parameters (0..1) */
int32_t  fx[4], order[4], byp;
float    tilt, camt, rate, mamt, time_, damt, tamt, mixv, driftM, driftD, sens, vol[4], olev;
int32_t  fstyle, beat;
bool     tapR, tapT, bypAll;
float    modG[4], allG, mixS, olevS, timeS, rateS;
/* live: aux = send/return (modules that add a signal output only their wet part, no direct dry),
   inG = input gain for bypass with trails */
int32_t  auxM;
float    inG;
/* clock slave: note divisions for TIME / RATE when they follow the tempo, LFO locked to the beat */
int32_t  tdiv, rdiv, bidx;
bool     pSync;
float    mvCorr;
MC_COLD static float cc_tdiv(int i) {         /* delay length in quarter notes: 1/16 1/8T 1/8 1/8. 1/4 1/4. 1/2 1/2. */
    static const float m[8] = { 0.25f, 0.3333333f, 0.5f, 0.75f, 1.0f, 1.5f, 2.0f, 3.0f };
    return m[i & 7];
}
MC_COLD static float cc_rdiv(int i) {         /* LFO cycles per quarter: 4 bars 2 bars 1 bar 1/2 1/4 1/8 1/8T 1/16 */
    static const float m[8] = { 0.0625f, 0.125f, 0.25f, 0.5f, 1.0f, 2.0f, 3.0f, 4.0f };
    return m[i & 7];
}

/* ---- helpers ---- */
static inline float cc_abs(float x) { return x < 0.0f ? -x : x; }
static inline float cc_clamp(float x, float a, float b) { return x < a ? a : (x > b ? b : x); }
static inline float cc_tanh(float x) {
    if (x > 3.0f) return 1.0f;
    if (x < -3.0f) return -1.0f;
    float x2 = x * x;
    return x * (27.0f + x2) / (27.0f + 9.0f * x2);
}
MC_COLD static float cc_exp2(float x) {
    if (x < -40.0f) x = -40.0f;
    if (x > 40.0f) x = 40.0f;
    int32_t i = (int32_t)x;
    if ((float)i > x) i--;
    float f = x - (float)i;
    float p = 1.0f + f * (0.6931472f + f * (0.2402265f + f * (0.0555041f + f * 0.0096181f)));
    union { float f; int32_t i; } u;
    u.f = p;
    u.i += (int32_t)((uint32_t)i << 23);
    return u.f;
}
static inline float cc_tanpi(float x) {
    float w = 3.14159265f * x, w2 = w * w;
    return w * (15.0f - w2) / (15.0f - 6.0f * w2);
}
static inline float cc_sin1(float ph) {
    ph -= (float)(int32_t)ph;
    float t = ph < 0.25f ? 4.0f * ph : (ph < 0.75f ? 2.0f - 4.0f * ph : 4.0f * ph - 4.0f);
    return t * (1.5f - 0.5f * t * t);
}
uint32_t cc_rand() { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
float cc_noise() { return (float)(int32_t)cc_rand() * (1.0f / 2147483648.0f); }   /* -1..1 */
float cc_rf() { return (float)(cc_rand() >> 8) * (1.0f / 16777216.0f); }           /* 0..1 */
static inline float cc_lp1(float fc) {                 /* one-pole coefficient */
    float x = fc * (6.2831853f / 48000.0f);
    return x / (1.0f + x);
}
struct CCSvf { float a1, a2, a3, k, s1[2], s2[2]; };
MC_COLD static void cc_svfSet(CCSvf &f, float fc, float q) {
    float x = cc_clamp(fc * (1.0f / 48000.0f), 0.0004f, 0.45f);
    float g = cc_tanpi(x);
    f.k = 1.0f / q;
    f.a1 = 1.0f / (1.0f + g * (g + f.k));
    f.a2 = g * f.a1;
    f.a3 = g * f.a2;
}
/* returns lp, writes bp/hp */
static inline float cc_svf(CCSvf &f, int c, float x, float &bp, float &hp) {
    float v3 = x - f.s2[c], v1 = f.a1 * f.s1[c] + f.a2 * v3, v2 = f.s2[c] + f.a2 * f.s1[c] + f.a3 * v3;
    f.s1[c] = 2.0f * v1 - f.s1[c];
    f.s2[c] = 2.0f * v2 - f.s2[c];
    bp = v1; hp = x - f.k * v1 - v2;
    return v2;
}
static inline float cc_rd(const float *b, uint32_t mask, uint32_t w, float d, int c) {   /* fractional delay read */
    int32_t di = (int32_t)d;
    float fr = d - (float)di;
    uint32_t i0 = (w - (uint32_t)di) & mask, i1 = (i0 - 1u) & mask;
    float a = b[i0 * 2u + (uint32_t)c], bb = b[i1 * 2u + (uint32_t)c];
    return a + fr * (bb - a);
}

/* ===================== CHARACTER ===================== */
float chLp[2], chHp[2], chTl[2], chEnv, chEnvS, chHowlEnv, chSwG, chCmp, chPost[2], chPt[2];
CCSvf chF;
int32_t chOnT, chSwD;
void ch_block() {
    float t = (tilt - 0.5f) * 2.0f;
    chTiltL = cc_exp2(-t * 1.5f);
    chTiltH = cc_exp2(t * 1.5f);
    chTiltLs = cc_exp2(-t * 0.75f);
    chTiltHs = cc_exp2(t * 0.75f);
    chPre = cc_exp2((sens - 0.5f) * 5.0f);
    if (fx[0] == 3) {
        float fc = 180.0f * cc_exp2(chHowlEnv * 7.0f * (0.6f + camt));
        cc_svfSet(chF, fc, 3.0f + camt * 9.0f);
    }
}
float chTiltL, chTiltH, chTiltLs, chTiltHs, chPre;
MC_HOT void ch_run(float *L, float *R) {
    const int e = fx[0];
    float aT = cc_lp1(700.0f);
    float drive = 1.0f + camt * camt * 40.0f;
    float fz = 20.0f + camt * camt * 300.0f, bias = (tilt - 0.5f) * 0.6f;
    float swA = 1.0f / (48000.0f * 0.02f * cc_exp2(camt * 7.0f));
    float thrS = 0.0015f * cc_exp2((1.0f - sens) * 6.0f);
    float howlDec = 1.0f / (48000.0f * 1.2f * cc_exp2(-tilt * 5.5f));
    for (int i = 0; i < 16; i++) {
        float in[2] = { L[i], R[i] };
        float a = 0.5f * (cc_abs(in[0]) + cc_abs(in[1]));
        chEnv += (a - chEnv) * (a > chEnv ? 0.02f : 0.0006f);
        chEnvS += (a - chEnvS) * (a > chEnvS ? 0.0015f : 0.0002f);
        if (e == 3) { if (chEnv > chHowlEnv) chHowlEnv = chEnv * 4.0f > 1.0f ? 1.0f : chEnv * 4.0f; else chHowlEnv -= howlDec; if (chHowlEnv < 0.0f) chHowlEnv = 0.0f; }
        if (e == 4) {
            chOnT++;
            if (chEnv > chEnvS * 1.7f + thrS && chOnT > 4800) { chSwD = 1; chOnT = 0; }   /* new note: down in 5 ms, then swell */
            if (chSwD) { chSwG -= 1.0f / 240.0f; if (chSwG <= 0.0f) { chSwG = 0.0f; chSwD = 0; } }
            else if (chEnvS > thrS * 0.5f) { chSwG += swA; if (chSwG > 1.0f) chSwG = 1.0f; }
            else { chSwG -= swA * 0.5f; if (chSwG < 0.0f) chSwG = 0.0f; }
        }
        if (e == 1) {
            float thr = 0.3f - camt * 0.24f;
            float g = chEnv > thr ? (thr + (chEnv - thr) * 0.33f) / chEnv : 1.0f;
            chCmp += (g - chCmp) * 0.002f;
        }
        for (int c = 0; c < 2; c++) {
            float x = in[c] * chPre, y;
            chHp[c] += (x - chHp[c]) * 0.009f;          /* ~70 Hz high-pass reference */
            switch (e) {
                case 0: {   /* DRIVE: half of the TILT comes before the saturation, so it also changes what distorts */
                    float d = x - chHp[c];
                    chPt[c] += (d - chPt[c]) * aT;
                    d = chPt[c] * chTiltLs + (d - chPt[c]) * chTiltHs;
                    y = cc_tanh(d * drive + 0.15f) - 0.149f; y *= 0.8f / (1.0f + camt * 4.5f);
                    break;
                }
                case 1: y = cc_tanh(x * chCmp * (1.0f + camt * 1.5f)) * (0.75f + camt * 0.1f); break;
                case 2: y = cc_tanh((x - chHp[c]) * fz + bias) - cc_tanh(bias); y *= 0.17f; break;
                case 3: {
                    float f = cc_tanh(x * (30.0f + camt * 200.0f)) * 0.5f, bp, hp;
                    y = cc_svf(chF, c, f, bp, hp) * 0.19f;
                    break;
                }
                default: y = x * chSwG * chSwG; break;
            }
            /* post low-pass for drive/fuzz, then tilt EQ */
            if (e == 0 || e == 2) { chPost[c] += (y - chPost[c]) * (e == 0 ? 0.55f : 0.38f); y = chPost[c]; }
            chTl[c] += (y - chTl[c]) * aT;
            y = chTl[c] * chTiltL + (y - chTl[c]) * chTiltH;
            if (c == 0) L[i] = y; else R[i] = y;
        }
    }
}

/* ===================== MOVEMENT ===================== */
float mvPh, mvPh3, mvDr, mvDrT, mvPh2[2], mvAp[2][12], mvApFb[2], mvW2;
float vbRnd[2], vbT[2];
float dbT[2], dbO[2], mvBase, pcH[2];      /* DOUBLER: tap targets / offsets / base delay; PITCH: lo-fi hold */
int32_t mvDrC, dbC, mvNst, pcC;
/* PITCH: the two read heads are spliced where the sound repeats itself. pcAc is how alike the input is
   to itself 640 .. 1408 samples earlier (every 2 samples; four values refreshed per block, so the whole
   table every 32 ms); when a head starts again it takes, within +-192 samples, the place where it and
   the other head read the most alike stretch. A steady note then comes out as a steady note at the
   right pitch, instead of being pulled off by the phase jumps of a fixed splice. */
enum { PC_R = 192, PC_NL = 2 * PC_R + 1 };
float pcAc[PC_NL], pcOff[2];
int32_t pcAcI;
MC_COLD void pc_scan() {                         /* four more values of the table (2 ms of the left input each) */
    for (int j = 0; j < 4; j++) {
        const uint32_t lag = (uint32_t)(1024 - 2 * PC_R + 2 * pcAcI);
        float sxy = 0.0f, sxx = 1e-9f, syy = 0.0f;
        for (uint32_t m = 1u; m <= 96u; m += 4u) {
            const float a = mbuf[((mw - m) & CC_MMASK) * 2u], b = mbuf[((mw - m - lag) & CC_MMASK) * 2u];
            sxy += a * b; sxx += a * a; syy += b * b;
        }
        pcAc[pcAcI] = sxy / (sxx + syy);
        if (++pcAcI >= PC_NL) pcAcI = 0;
    }
}
MC_COLD void pc_pick(int x, bool up) {
    const int oy = (int)pcOff[x ^ 1];
    float best = -9.0f;
    int bo = 0;
    for (int o = -PC_R; o <= PC_R; o += 2) {
        const int k = PC_R + ((up ? o - oy : oy - o) >> 1);      /* lag = 1024 + (o - oy), or the reverse going down */
        if (k < 0 || k >= PC_NL) continue;
        const float s = pcAc[k] - 0.0004f * (float)(o < 0 ? -o : o);   /* near the middle unless clearly better */
        if (s > best) { best = s; bo = o; }
    }
    pcOff[x] = (float)bo;
}
MC_HOT void mv_run(float *L, float *R) {
    const int e = fx[1];
    const float drift = driftM;
    float hz = tapR ? 48000.0f / (float)beat * cc_rdiv(rdiv) : 0.05f * cc_exp2(rateS * 8.0f);
    mvDrC -= 16;
    if (mvDrC <= 0) { mvDrC = 4800; mvDrT = cc_noise(); }
    mvDr += (mvDrT - mvDr) * 0.004f;
    float dr = mvDr * drift;
    float inc = hz * (tapR ? 1.0f : 1.0f + dr * 0.25f) * (1.0f / 48000.0f);   /* on the tempo the speed does not wander */
    int nst = 2 + 2 * (int)(mamt * 5.0f + 0.5f);
    float apc[2] = { 0.0f, 0.0f };
    /* VIBRATO, PHASER, TREMOLO: DRIFT bends the sine toward a wandering random wave */
    float vbC = hz * (4.0f / 48000.0f); if (vbC > 0.05f) vbC = 0.05f;
    if (e == 2 || e == 3) {
        float k = vbC * 16.0f; if (k > 1.0f) k = 1.0f;
        vbRnd[0] += (vbT[0] - vbRnd[0]) * k; vbRnd[1] += (vbT[1] - vbRnd[1]) * k;
    }
    if (e == 2) {
        if (nst != mvNst) {                              /* stages that leave or join start clean */
            for (int c = 0; c < 2; c++) for (int s = nst < mvNst ? nst : mvNst; s < 12; s++) mvAp[c][s] = 0.0f;
            mvNst = nst;
        }
        for (int c = 0; c < 2; c++) {
            float w = cc_sin1(mvPh + (c ? 0.25f : 0.0f));
            w += drift * 0.7f * (vbRnd[c] - w);
            float s = 0.5f + 0.5f * w;
            float f = 200.0f * cc_exp2(s * 4.0f);
            float g = cc_tanpi(f * (1.0f / 48000.0f));
            apc[c] = (1.0f - g) / (1.0f + g);
        }
    }
    /* TREMOLO: AMOUNT goes from a soft shimmer (sine) to a square chop */
    float trK = 1.0f + 12.0f * mamt * mamt, trN = 1.0f / cc_tanh(trK);
    /* DOUBLER: with DRIFT each tap jumps to a new place every 0.15 .. 0.6 s and glides there in about
       80 ms: random momentary pitch shifts */
    if (e == 0) {
        dbC -= 16;
        if (dbC <= 0) {
            dbC = 7200 + (int32_t)(cc_rand() % 21600u);
            dbT[0] = cc_noise() * drift * 160.0f; dbT[1] = cc_noise() * drift * 160.0f;
        }
    }
    const float baseT = 384.0f * cc_exp2(rateS * 4.0f);
    /* PITCH: RATE is continuous, +-1 octave, no shift in a small zone around the centre; AMOUNT is dry / wet
       (all wet at full); DRIFT is lo-fi: the shifted voice is held for 1..8 samples (48 kHz down to 6 kHz)
       and its pitch wanders */
    float pu = (rateS - 0.5f) * 2.0f, pab = cc_abs(pu);
    pab = pab < 0.05f ? 0.0f : (pab - 0.05f) * (1.0f / 0.95f);
    float semi = (pu < 0.0f ? -12.0f : 12.0f) * pab;
    float pr = cc_exp2((semi + dr * 0.5f) * (1.0f / 12.0f));
    const int32_t pcN = 1 + (int32_t)(drift * 7.0f + 0.5f);
    if (e == 4) pc_scan();
    const float pdG = 1.0f - mamt * mamt, pwG = 1.0f - (1.0f - mamt) * (1.0f - mamt);
    for (int i = 0; i < 16; i++) {
        float x[2] = { L[i], R[i] };
        mbuf[(mw & CC_MMASK) * 2u] = x[0];
        mbuf[(mw & CC_MMASK) * 2u + 1u] = x[1];
        mvPh += inc + mvCorr;
        if (mvPh >= 1.0f) { mvPh -= 1.0f; if (e >= 1 && e <= 3) { vbT[0] = cc_noise(); vbT[1] = cc_noise(); } }
        if (mvPh < 0.0f) mvPh += 1.0f;
        float y[2];
        switch (e) {
            case 0: {   /* DOUBLER: RATE from tight doubling (8 ms) to slapback (128 ms) */
                mvBase += (baseT - mvBase) * 0.002f;
                const float base = mvBase;
                mvPh3 += 0.27f * (1.0f / 48000.0f); if (mvPh3 >= 1.0f) mvPh3 -= 1.0f;
                float m = cc_sin1(mvPh3) * 24.0f;
                dbO[0] += (dbT[0] - dbO[0]) * 0.00026f; dbO[1] += (dbT[1] - dbO[1]) * 0.00026f;
                float dl = base + m + dbO[0], drr = base * 1.37f - m * 0.8f + dbO[1];
                float a = cc_rd(mbuf, CC_MMASK, mw, dl, 1), b = cc_rd(mbuf, CC_MMASK, mw, drr, 0);
                float kd = auxM ? 0.0f : 1.0f - 0.3f * mamt;
                y[0] = x[0] * kd + mamt * a;
                y[1] = x[1] * kd + mamt * b;
                break;
            }
            case 1: {   /* VIBRATO */
                for (int c = 0; c < 2; c++) {
                    vbRnd[c] += (vbT[c] - vbRnd[c]) * vbC;
                    float w = cc_sin1(mvPh + (c ? drift * 0.25f : 0.0f));
                    w += drift * (vbRnd[c] - w);
                    float d = (2.0f + mamt * 6.0f * (0.5f + 0.5f * w)) * 48.0f;
                    y[c] = cc_rd(mbuf, CC_MMASK, mw, d, c);
                }
                break;
            }
            case 2: {   /* PHASER */
                for (int c = 0; c < 2; c++) {
                    float v = x[c] + mvApFb[c] * (0.25f + mamt * 0.45f);
                    float a = apc[c];
                    for (int s = 0; s < nst; s++) {
                        float z = mvAp[c][s];
                        float o = -a * v + z;
                        mvAp[c][s] = v + a * o;
                        v = o;
                    }
                    mvApFb[c] = v;
                    y[c] = (auxM ? v : 0.5f * (x[c] + v)) * (auxM ? 0.65f : 1.3f);
                }
                break;
            }
            case 3: {   /* TREMOLO */
                float w = cc_sin1(mvPh);
                w += drift * 0.7f * (vbRnd[0] - w);
                float s = 0.5f + 0.5f * cc_tanh(trK * w) * trN;
                float g = 1.0f - mamt * s * (1.0f + mamt * 0.3f);
                if (g < 0.0f) g = 0.0f;
                y[0] = x[0] * g; y[1] = x[1] * g;
                break;
            }
            default: {  /* PITCH: two-head delay-line shifter, heads spliced where the sound repeats (pc_pick) */
                const float W = 2048.0f, C0 = (float)(PC_R + 4);
                const bool up = pr > 1.0f;
                float incp = (up ? pr - 1.0f : 1.0f - pr) * (1.0f / W);
                if (incp < 1e-7f) mvW2 += (0.5f - mvW2) * 0.002f;        /* no shift: settle on one head, no comb */
                else {
                    const float w0 = mvW2;
                    mvW2 += incp;
                    if (mvW2 >= 1.0f) { mvW2 -= 1.0f; pc_pick(0, up); }           /* head A starts again (its weight is 0) */
                    else if (w0 < 0.5f && mvW2 >= 0.5f) pc_pick(1, up);           /* head B starts again */
                }
                if (++pcC >= pcN) pcC = 0;
                float pb = mvW2 + 0.5f; if (pb >= 1.0f) pb -= 1.0f;
                float da = (up ? W * (1.0f - mvW2) : W * mvW2) + C0 + pcOff[0];
                float db = (up ? W * (1.0f - pb) : W * pb) + C0 + pcOff[1];
                float wa = 1.0f - cc_abs(2.0f * mvW2 - 1.0f);
                for (int c = 0; c < 2; c++) {
                    float sh = cc_rd(mbuf, CC_MMASK, mw, da, c) * wa + cc_rd(mbuf, CC_MMASK, mw, db, c) * (1.0f - wa);
                    if (pcC == 0) pcH[c] = sh;
                    y[c] = (auxM ? 0.0f : x[c] * pdG) + pcH[c] * pwG;
                }
                break;
            }
        }
        mw++;
        L[i] = y[0]; R[i] = y[1];
    }
}

/* ===================== TAPE PIECES =====================
   After Airwindows, Copyright (c) Chris Johnson (MIT licence, github.com/airwindows/airwindows;
   the MIT permission notice is the one quoted in common/plate.inc), rewritten in float from
   the published algorithms:
   aw_flut  the wobble of Flutter / ToTape: a sine whose speed is drawn again at random
            (0.24 .. 0.98 of the top speed) at every cycle and glides there, the depth
            following the speed squared, so no two wobbles are alike; +-2 at most, rms as
            a plain sine of depth 1
   aw_soft  the "soften" of ToTape: the highs are pulled down by 1 - cos(|highs| pi/2),
            so loud treble is squashed as on tape and quiet treble passes untouched
   aw_sat   the clip of Tape / ToTape: sin() up to +-pi/2, flat beyond
   Each wobble has its own random generator: the main one (cc_rand) keeps its sequence. */
struct AwFlut { float ph, r, nx; uint32_t rs; };
static void aw_flutInit(AwFlut &f, uint32_t seed) { f.ph = 0.0f; f.r = f.nx = 0.61f; f.rs = seed; }
static inline float aw_flut(AwFlut &f, float hz) {
    const float inc = hz * (1.0f / 48000.0f);
    f.r += (f.nx - f.r) * (inc * 6.2831853f);
    f.ph += f.r * inc;
    if (f.ph >= 1.0f) {
        f.ph -= 1.0f;
        f.rs = f.rs * 1664525u + 1013904223u;
        f.nx = 0.24f + 0.74f * (float)(f.rs >> 8) * (1.0f / 16777216.0f);
    }
    return 2.0f * f.r * f.r * cc_sin1(f.ph);
}
static inline float aw_soft(float &lp, float x, float k, float amt) {
    lp += (x - lp) * k;
    float hi = x - lp;
    float a = cc_abs(hi) * 1.5707963f;
    if (a > 1.5707963f) a = 1.5707963f;
    float a2 = a * a;
    float c1 = a2 * (0.5f - a2 * ((1.0f / 24.0f) - a2 * (1.0f / 720.0f)));      /* 1 - cos(a) */
    return lp + hi * (1.0f - c1 * amt);
}
static inline float aw_sat(float x) {
    if (x > 1.5707963f) x = 1.5707963f;
    if (x < -1.5707963f) x = -1.5707963f;
    float x2 = x * x;
    return x * (1.0f - x2 * ((1.0f / 6.0f) - x2 * ((1.0f / 120.0f) - x2 * (1.0f / 5040.0f))));
}

/* ===================== DIFFUSION ===================== */
float dfD, dfLp[2], dfHp[2], dfWow, dfGrPh, dfRvPh, dfFbS[2], dfSoft[2];
AwFlut dfFw, dfFf;
float dfGrMul[2], dfGrSp[2], dfGL, dfRvStart[2];   /* COLLAGE: grain place (grain lengths back), speed, length */
int32_t dfGrCnt;
/* reverb: SPACE plate (common/plate.inc); TIME morphs five rooms, small room ... huge */
/* ===== SPACE plate ===========================================================
   The Griesinger / Dattorro "figure eight" (J. Dattorro, "Effect Design, Part 1",
   JAES 1997) laid out as in the reverbs of Mutable Instruments Rings and Clouds
   by Emilie Gillet (Copyright 2014 Emilie Gillet, MIT license): four input
   allpasses, then two branches [modulated delay -> low-pass -> two allpasses ->
   delay] that feed each other; left and right are taken at the end of each branch.
   Line lengths are those of the Rings reverb at 48 kHz, scaled by the room size.
   Written anew for this patch: one float circular buffer holds every line (one
   write pointer, each line at its own fixed offset, sized for the largest room so
   the size can glide), the host sets the parameters once per block.

   MIT license of the original: Permission is hereby granted, free of charge, to
   any person obtaining a copy of this software and associated documentation files
   (the "Software"), to deal in the Software without restriction, including without
   limitation the rights to use, copy, modify, merge, publish, distribute,
   sublicense, and/or sell copies of the Software, and to permit persons to whom the
   Software is furnished to do so, subject to the following conditions: The above
   copyright notice and this permission notice shall be included in all copies or
   substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT
   WARRANTY OF ANY KIND.
   ============================================================================= */
static const uint32_t PL_MASK = (1u << 16) - 1u;
float *plm;
uint32_t plw, plB[11];
float plOff[11];      /* read offsets of the lines for the current size, samples */
float plLp1, plLp2, plPh1, plPh2;
/* parameters, set by the host every block */
float plSize, plKap, plKlp, plKrt, plAmp, plGain, plPre;

static inline float pl_lfo(float ph) {                /* smooth 0..1 wave from a 0..1 phase */
    float x = ph < 0.5f ? ph * 4.0f - 1.0f : 3.0f - ph * 4.0f;
    return 0.5f + 0.5f * x * (1.5f - 0.5f * x * x);
}
inline float pl_rd(int k, uint32_t off) { return plm[(plw + plB[k] + off) & PL_MASK]; }
inline float pl_rdi(int k, float off) {
    uint32_t i = (uint32_t)off;
    float f = off - (float)i;
    float a = pl_rd(k, i), b = pl_rd(k, i + 1u);
    return a + f * (b - a);
}
inline void pl_wr(int k, float v) {                  /* float lines: 16-bit ones eat or freeze the tail */
    v = v > 4.0f ? 4.0f : (v < -4.0f ? -4.0f : v);
    plm[(plw + plB[k]) & PL_MASK] = v;
}
inline float pl_ap(int k, float x, float g) {          /* v = x + g d, y = d - g v */
    float d = pl_rd(k, (uint32_t)plOff[k]);
    float v = x + g * d;
    pl_wr(k, v);
    return d - g * v;
}
void pl_setSize(float s) {
    static const float base[11] = { 0.0f, 150.0f, 214.0f, 319.0f, 527.0f, 2182.0f, 2690.0f, 4460.0f, 2525.0f, 2197.0f, 6261.0f };
    if (s < 0.3f) s = 0.3f;
    if (s > 1.6f) s = 1.6f;
    plSize = s;
    for (int k = 1; k < 11; k++) plOff[k] = base[k] * s - 1.0f;
}
void pl_init(float *mem) {
    static const float base[11] = { 0.0f, 150.0f, 214.0f, 319.0f, 527.0f, 2182.0f, 2690.0f, 4460.0f, 2525.0f, 2197.0f, 6261.0f };
    plm = mem; plw = 0;
    for (uint32_t i = 0; i <= PL_MASK; i++) plm[i] = 0.0f;
    uint32_t b = 0;                                     /* regions for size 1.6, 4x modulation, 100 ms predelay */
    for (int k = 0; k < 11; k++) {
        plB[k] = b;
        b += (k == 0) ? 4900u : (uint32_t)(base[k] * 1.6f) + ((k == 7 || k == 10) ? 260u : 4u);
    }
    plLp1 = plLp2 = 0.0f; plPh1 = 0.0f; plPh2 = 0.37f;
    plKap = 0.625f; plKlp = 0.7f; plKrt = 0.5f; plAmp = 1.0f; plGain = 0.2f; plPre = 100.0f;
    pl_setSize(1.0f);
}
/* one block: mono sum of the input in, stereo wet out (overwrites wl / wr) */
#ifndef MC_HOT
#define MC_HOT
#endif
MC_HOT void pl_block(const float *inl, const float *inr, float *wl, float *wr) {
    plPh1 += 0.5f * (16.0f / 48000.0f); if (plPh1 >= 1.0f) plPh1 -= 1.0f;
    plPh2 += 0.3f * (16.0f / 48000.0f); if (plPh2 >= 1.0f) plPh2 -= 1.0f;
    const float o1 = plOff[7] + 40.0f * plAmp * pl_lfo(plPh1);
    const float o2 = plOff[10] + 50.0f * plAmp * pl_lfo(plPh2);
    const float kap = plKap, klp = plKlp, krt = plKrt, g = plGain;
    float pre = plPre < 1.0f ? 1.0f : (plPre > 4800.0f ? 4800.0f : plPre);
    for (int i = 0; i < 16; i++) {
        plw--;
        pl_wr(0, (inl[i] + inr[i]) * g);
        float x = pl_rdi(0, pre);
        x = pl_ap(1, x, kap);
        x = pl_ap(2, x, kap);
        x = pl_ap(3, x, kap);
        x = pl_ap(4, x, kap);
        float a = x + krt * pl_rdi(10, o2);
        plLp1 += klp * (a - plLp1) + 1e-20f;           /* + 1e-20: no subnormals in the tail */
        a = pl_ap(5, plLp1, -kap);
        a = pl_ap(6, a, kap);
        pl_wr(7, a);
        wl[i] = 2.0f * a;
        float c = x + krt * pl_rdi(7, o1);
        plLp2 += klp * (c - plLp2) + 1e-20f;
        c = pl_ap(8, plLp2, kap);
        c = pl_ap(9, c, -kap);
        pl_wr(10, c);
        wr[i] = 2.0f * c;
    }
}

float rvSz, rvPreS, rvTrim;
MC_COLD void rv_params(float pos, float dr) {
    static const float sz[5] = { 0.40f, 0.65f, 1.00f, 1.30f, 1.60f };
    static const float t6[5] = { 0.5f, 1.5f, 3.0f, 6.0f, 15.0f };
    static const float lp[5] = { 0.75f, 0.60f, 0.50f, 0.42f, 0.38f };
    static const float kp[5] = { 0.60f, 0.62f, 0.66f, 0.70f, 0.72f };
    static const float md[5] = { 0.3f, 0.8f, 1.4f, 2.0f, 3.0f };
    static const float pd[5] = { 96.0f, 384.0f, 960.0f, 1920.0f, 3360.0f };
    static const float tr[5] = { 0.98f, 1.07f, 1.16f, 1.25f, 1.06f };   /* same loudness as the earlier SPACE */
    if (pos < 0.0f) pos = 0.0f;
    int k = (int)pos; if (k > 3) k = 3;
    float f = pos - (float)k;
    if (f > 1.0f) f = 1.0f;
    float s = sz[k] + f * (sz[k + 1] - sz[k]);
    float t = t6[k] + f * (t6[k + 1] - t6[k]);
    rvSz += (s - rvSz) * 0.02f;                         /* the room glides, no jumps */
    rvPreS += (pd[k] + f * (pd[k + 1] - pd[k]) - rvPreS) * 0.02f;
    pl_setSize(rvSz);
    plKrt = cc_exp2(-9.966f * (10180.0f * plSize / 48000.0f) / t);
    plKlp = lp[k] + f * (lp[k + 1] - lp[k]);
    plKap = kp[k] + f * (kp[k + 1] - kp[k]);
    float a = md[k] + f * (md[k + 1] - md[k]) + dr * 1.5f;   /* DRIFT: more chorus in the tail */
    plAmp = a > 4.5f ? 4.5f : a;
    plPre = rvPreS;
    plGain = 0.2f;
    rvTrim = tr[k] + f * (tr[k + 1] - tr[k]);
}
/* COLLAGE: a new grain 1..3 grain lengths back; with DRIFT some play at double or at half speed */
MC_COLD void df_grain(int g) {
    dfGrMul[g] = 1.0f + (float)(cc_rand() % 3u);
    float r = cc_rf();
    dfGrSp[g] = r < driftD * 0.5f ? 1.0f : (r < driftD * 0.75f ? -0.5f : 0.0f);
}
MC_HOT void df_run(float *L, float *R) {
    const int e = fx[2];
    const float drift = driftD;
    float wetv = vol[2] * 2.0f;
    float dt = tapT ? (float)beat * cc_tdiv(tdiv) : 1440.0f * cc_exp2(timeS * 5.3f);       /* 30 ms .. 1.2 s */
    if (dt > 120000.0f) dt = 120000.0f;
    if (e == 2) rv_params(timeS * 4.0f, drift);
    float fb = (e == 0) ? damt * 1.12f : damt * 1.04f;
    float aLp = cc_lp1(e == 0 ? cc_clamp(6500.0f * cc_exp2(-dt * (1.0f / 48000.0f) * 1.6f - drift * 1.2f), 900.0f, 6500.0f) : 5200.0f - drift * 2500.0f);   /* CASCADE: DRIFT also wears the repeats down */
    float aHp = cc_lp1(e == 0 ? 60.0f : 140.0f);
    const float aSoft = cc_lp1(2800.0f);
    /* collage grain size and reverse chunk */
    float gL = tapT ? (float)beat * cc_tdiv(tdiv) * 0.5f : 1200.0f * cc_exp2(timeS * 6.3f);   /* 25 ms .. 2 s */
    if (gL > 60000.0f) gL = 60000.0f;
    /* REVERSE: TIME is the speed (and pitch) of the backwards chunks, half .. normal at the centre .. double;
       the chunk is one beat with the tempo, half a second without; AMOUNT is dry / wet, all wet at full */
    float rsp = (timeS > 0.47f && timeS < 0.53f) ? 1.0f : cc_exp2((timeS - 0.5f) * 2.0f);
    float rvC = tapT ? (float)beat : 24000.0f;
    const float rdG = 1.0f - damt * damt, rwG = 1.0f - (1.0f - damt) * (1.0f - damt);
    if (rvC > 120000.0f / (1.0f + rsp)) rvC = 120000.0f / (1.0f + rsp);
    for (int i = 0; i < 16; i++) {
        float x[2] = { L[i], R[i] }, y[2], wl[2];
        dfD += (dt - dfD) * 0.0003f;
        if (e == 0 || e == 1) {
            /* REELS: tape wow and flutter (aw_flut); CASCADE: a slow even sway with DRIFT */
            float mod;
            if (e == 1) mod = aw_flut(dfFw, 1.0f) * (10.0f + drift * 100.0f) + aw_flut(dfFf, 11.0f) * (2.0f + drift * 8.0f);
            else { dfWow += 0.42f * (1.0f / 48000.0f); if (dfWow >= 1.0f) dfWow -= 1.0f; mod = cc_sin1(dfWow) * drift * 100.0f; }
            float d = dfD + mod + 2.0f;
            for (int c = 0; c < 2; c++) {
                float r = cc_rd(dbuf, CC_DMASK, dw, d, c);
                dfLp[c] += (r - dfLp[c]) * aLp;
                dfHp[c] += (dfLp[c] - dfHp[c]) * aHp;
                float v = dfLp[c] - dfHp[c];
                /* REELS: every pass through the tape squashes the loud highs and rounds the peaks */
                float w = (e == 1) ? aw_sat(aw_soft(dfSoft[c], v * 1.3f, aSoft, 1.0f)) * 0.77f : cc_tanh(v);
                if (e == 0) w += cc_noise() * 0.0006f * (1.0f + drift);
                wl[c] = x[c] + w * fb;
                y[c] = (auxM ? 0.0f : x[c]) + v * wetv * (e == 0 ? 0.6f : 0.75f);
            }
        } else if (e == 2) {
            wl[0] = x[0]; wl[1] = x[1];
            y[0] = x[0]; y[1] = x[1];          /* reverb added below (aux: wet only) */
        } else if (e == 3) {
            /* COLLAGE: two overlapping grains replay chunks of the line and are written back, so the loop
               keeps editing itself. The chunks sit 1..3 grain lengths back: when TIME moves they slide and
               the pitch bends. DRIFT: some grains at double or half speed, and a slow wobble */
            dfGL += (gL - dfGL) * 0.0002f;
            dfGrPh += 1.0f / dfGL;
            if (dfGrPh >= 1.0f) { dfGrPh -= 1.0f; df_grain(0); }
            float pb = dfGrPh + 0.5f;
            if (pb >= 1.0f) pb -= 1.0f;
            if (pb < 1.0f / dfGL) df_grain(1);
            dfWow += 0.42f * (1.0f / 48000.0f); if (dfWow >= 1.0f) dfWow -= 1.0f;
            float mod = 8.0f + (1.0f + cc_sin1(dfWow)) * drift * 60.0f;
            float oa = dfGL * (dfGrMul[0] - dfGrSp[0] * dfGrPh) + mod, ob = dfGL * (dfGrMul[1] - dfGrSp[1] * pb) + mod;
            if (oa > 126000.0f) oa = 126000.0f;          /* the line is 2.7 s long */
            if (ob > 126000.0f) ob = 126000.0f;
            float wa = 1.0f - cc_abs(2.0f * dfGrPh - 1.0f), wb = 1.0f - wa;
            for (int c = 0; c < 2; c++) {
                float v = cc_rd(dbuf, CC_DMASK, dw, oa, c) * wa + cc_rd(dbuf, CC_DMASK, dw, ob, c) * wb;
                wl[c] = x[c] + cc_tanh(v * damt * 0.95f);
                y[c] = (auxM ? 0.0f : x[c]) + v * wetv * 0.75f;
            }
        } else {               /* REVERSE: backwards chunks; DRIFT wobbles their pitch */
            dfRvPh += 1.0f / rvC;
            if (dfRvPh >= 1.0f) dfRvPh -= 1.0f;
            float pa = dfRvPh, pb = dfRvPh + 0.5f; if (pb >= 1.0f) pb -= 1.0f;
            float wa = 1.0f - cc_abs(2.0f * pa - 1.0f), wb = 1.0f - wa;
            dfWow += 0.6f * (1.0f / 48000.0f); if (dfWow >= 1.0f) dfWow -= 1.0f;
            float mod = 4.0f + (1.0f + cc_sin1(dfWow)) * drift * 100.0f;
            float da = mod + pa * rvC * (1.0f + rsp), db = mod + pb * rvC * (1.0f + rsp);
            for (int c = 0; c < 2; c++) {
                float v = cc_rd(dbuf, CC_DMASK, dw, da, c) * wa + cc_rd(dbuf, CC_DMASK, dw, db, c) * wb;
                wl[c] = x[c];
                y[c] = (auxM ? 0.0f : x[c] * rdG) + v * rwG * wetv * 1.3f;
            }
        }
        dbuf[(dw & CC_DMASK) * 2u] = wl[0];
        dbuf[(dw & CC_DMASK) * 2u + 1u] = wl[1];
        dw++;
        L[i] = y[0]; R[i] = y[1];
    }
    if (e == 2) rv_run(L, R, damt, wetv);
}
MC_HOT void rv_run(float *L, float *R, float amt, float wetv) {
    float wl[16], wr[16];
    pl_block(L, R, wl, wr);
    /* AMOUNT is dry / wet: all wet at full */
    float kd = auxM ? 0.0f : 1.0f - amt * amt, w = (1.0f - (1.0f - amt) * (1.0f - amt)) * wetv * rvTrim;
    for (int i = 0; i < 16; i++) {
        L[i] = L[i] * kd + wl[i] * w;
        R[i] = R[i] * kd + wr[i] * w;
    }
}

/* ===================== TEXTURE ===================== */
CCSvf txF, txH;
float txEnv, txG, txLp[2], txTl[2], txWow, txFl, txBk, txBkT, txAm, txHiss[2], txHold[2], txCrk, txGate, txGateT, txSt, txSoft[2];
AwFlut txFw, txFf;
int32_t txBkC, txHc, txGl, txGlC;
void tx_block() {
    int e = fx[3];
    if (e == 0) {
        if (fstyle == 1) cc_svfSet(txF, 20300.0f * cc_exp2(-tamt * 9.0f), 0.9f);    /* open at 0, 40 Hz at full */
        if (fstyle == 2) cc_svfSet(txF, 20.0f * cc_exp2(tamt * 8.6f), 0.8f);
    }
    if (e == 2) cc_svfSet(txF, 16000.0f * cc_exp2(-tamt * 2.4f), 0.75f);
    if (e == 2) cc_svfSet(txH, 70.0f, 1.0f);                  /* CASSETTE head bump */
    if (e == 4) cc_svfSet(txF, 1200.0f + 2500.0f * tamt, 1.5f);
}
MC_HOT void tx_run(float *L, float *R) {
    const int e = fx[3];
    float aT = cc_lp1(800.0f);
    const float aSoft = cc_lp1(3500.0f);
    /* FILTER, tilt style: left of centre cuts the highs, right cuts the lows, nothing at the centre */
    float t = (tamt - 0.5f) * 2.0f, gLo = t > 0.0f ? cc_exp2(-t * 4.0f) : 1.0f, gHi = t < 0.0f ? cc_exp2(t * 4.0f) : 1.0f;
    for (int i = 0; i < 16; i++) {
        float x[2] = { L[i], R[i] }, y[2];
        float a = 0.5f * (cc_abs(x[0]) + cc_abs(x[1]));
        tbuf[(tw & CC_TMASK) * 2u] = x[0];
        tbuf[(tw & CC_TMASK) * 2u + 1u] = x[1];
        switch (e) {
            case 0: {   /* FILTER: tilt / low-pass / high-pass (low-pass and high-pass do nothing at AMOUNT 0) */
                for (int c = 0; c < 2; c++) {
                    if (fstyle == 0) { txTl[c] += (x[c] - txTl[c]) * aT; y[c] = txTl[c] * gLo + (x[c] - txTl[c]) * gHi; }
                    else { float bp, hp, lp = cc_svf(txF, c, x[c], bp, hp); y[c] = (fstyle == 1) ? lp : hp; }
                }
                break;
            }
            case 1: {   /* SQUASH */
                txEnv += (a - txEnv) * (a > txEnv ? 0.05f : 0.0004f);
                float thr = 0.3f * cc_exp2(-tamt * 6.0f);
                float g = txEnv > thr ? (thr + (txEnv - thr) * 0.12f) / txEnv : 1.0f;
                txG += (g - txG) * 0.01f;
                float mk = 1.0f + tamt * 5.0f;
                float drv = tamt > 0.85f ? 1.0f + (tamt - 0.85f) * 30.0f : 1.0f;
                for (int c = 0; c < 2; c++) y[c] = cc_tanh(x[c] * txG * mk * drv * 0.8f) * 1.1f;
                break;
            }
            case 2: {   /* CASSETTE: wow and flutter, soft highs, head bump, tape clip, hiss, dropouts */
                float d = 96.0f + tamt * (40.0f * (1.0f + aw_flut(txFw, 0.9f)) + 6.0f * aw_flut(txFf, 14.5f));
                txEnv += (a - txEnv) * (a > txEnv ? 0.01f : 0.0003f);
                float cg = 1.0f / (1.0f + txEnv * tamt * 3.0f);
                if (tamt > 0.6f && (cc_rand() & 0xFFFFu) < (uint32_t)((tamt - 0.6f) * 2.0f + 0.5f)) txGateT = 0.15f;
                txGateT += (1.0f - txGateT) * 0.0005f;
                txGate += (txGateT - txGate) * 0.01f;
                for (int c = 0; c < 2; c++) {
                    float v = cc_rd(tbuf, CC_TMASK, tw, d, c) * cg;
                    float bp, hp;
                    cc_svf(txH, c, v, bp, hp);
                    float hb = bp * 0.45f * tamt;
                    if (hb > 1.0f) hb = 1.0f;
                    if (hb < -1.0f) hb = -1.0f;
                    v += hb * (1.0f - hb * hb * (1.0f / 3.0f));              /* the bump holds itself back */
                    v = aw_soft(txSoft[c], v * (1.0f + tamt * 4.0f), aSoft, tamt);
                    v = aw_sat(v) / (1.0f + tamt * 1.5f);
                    v = cc_svf(txF, c, v, bp, hp);
                    float n = cc_noise() * 0.012f * tamt;
                    txHiss[c] += (n - txHiss[c]) * 0.3f;
                    y[c] = (v + (n - txHiss[c])) * txGate * 1.15f;
                }
                break;
            }
            case 3: {   /* BROKEN: periodic pitch drops with AM/FM */
                txBkC -= 1;
                if (txBkC <= 0) { txBkC = 24000 + (int32_t)(cc_rf() * 120000.0f * (1.2f - tamt)); txBkT = tamt * (200.0f + cc_rf() * 500.0f); }
                txBkT *= 0.99993f;
                txBk += (txBkT - txBk) * 0.0006f;
                txWow += 0.8f * (1.0f / 48000.0f); if (txWow >= 1.0f) txWow -= 1.0f;
                float d = 64.0f + txBk + tamt * 18.0f * aw_flut(txFf, (5.0f + tamt * 9.0f) * 1.64f);   /* uneven wobble */
                if (d > 1900.0f) d = 1900.0f;
                float am = 1.0f - tamt * 0.35f * (0.5f + 0.5f * cc_sin1(txWow * 3.0f));
                for (int c = 0; c < 2; c++) y[c] = cc_rd(tbuf, CC_TMASK, tw, d, c) * am;
                break;
            }
            default: {  /* INTERFERENCE: crackle -> static -> digital glitch */
                float z = tamt * 3.0f;
                int zone = z < 1.0f ? 0 : (z < 2.0f ? 1 : 2);
                float k = z - (float)zone;
                float lvl = 0.25f + 0.75f * k;
                float crk = 0.0f;
                if ((cc_rand() & 0xFFFFu) < (uint32_t)(10.0f + 120.0f * lvl)) txCrk = cc_noise() * 0.35f * lvl;
                crk = txCrk; txCrk *= 0.6f;
                float st = 0.0f;
                if (zone >= 1) {
                    txGlC--;
                    if (txGlC <= 0) { txGlC = 2000 + (int32_t)(cc_rf() * 20000.0f); txSt = cc_rf() < 0.5f ? cc_rf() : 0.0f; }
                    st = cc_noise() * 0.06f * lvl * txSt;
                }
                bool hold = (zone == 2 && txGl > 0 && ++txHc >= 4);
                if (hold) txHc = 0;
                for (int c = 0; c < 2; c++) {
                    float bp, hp;
                    cc_svf(txF, c, st, bp, hp);
                    float v = x[c] + crk + bp * 2.0f;
                    if (zone == 2) {
                        if (txGl > 0) {
                            if (hold) txHold[c] = (float)(int32_t)(v * 24.0f) * (1.0f / 24.0f);
                            v = txHold[c];
                        }
                    }
                    y[c] = v;
                }
                if (zone == 2) {
                    if (txGl > 0) txGl--;
                    else if ((cc_rand() & 0xFFFFu) < (uint32_t)(1.0f + 6.0f * lvl)) txGl = 600 + (int32_t)(cc_rf() * 4000.0f);
                }
                break;
            }
        }
        tw++;
        L[i] = y[0]; R[i] = y[1];
    }
}

/* ===================== CAPTURE ===================== */
int32_t cst, clen, crw, ctail, cmode;   /* cst: 0 empty 1 rec 2 play */
float   cpos, cg, cgT, cgr[2], cgrPh;
uint32_t cgrPos[2];
bool    pCrec, pCclr;
float   cpL[16], cpR[16];
MC_HOT void cap_read() {
    for (int i = 0; i < 16; i++) { cpL[i] = 0.0f; cpR[i] = 0.0f; }
    bool fading = cst != 2 && cg > 0.0005f;              /* cleared while playing: a few ms of fade-out */
    if (!fading) { if (cst != 2) cg = 0.0f; if (cst != 2 || clen <= 0) return; }
    if (clen <= 0) return;
    if (cmode == 0) {          /* phrase loop with seam blend */
        int32_t tail = clen / 4 < CC_XS ? clen / 4 : CC_XS;
        for (int i = 0; i < 16; i++) {
            int32_t ix = (int32_t)cpos;
            uint32_t w = cap[ix];
            float l = (float)(int16_t)(w & 0xFFFFu) * (1.0f / 32768.0f), r = (float)(int16_t)(w >> 16) * (1.0f / 32768.0f);
            if (ix < tail && ctail == 0) {
                float t = (float)ix / (float)tail;
                uint32_t s = cap[clen + ix];
                l = l * t + (float)(int16_t)(s & 0xFFFFu) * (1.0f / 32768.0f) * (1.0f - t);
                r = r * t + (float)(int16_t)(s >> 16) * (1.0f / 32768.0f) * (1.0f - t);
            }
            cg += (cgT - cg) * 0.004f;
            cpL[i] = l * cg; cpR[i] = r * cg;
            cpos += 1.0f;
            if (cpos >= (float)clen) cpos -= (float)clen;
        }
    } else {                   /* sustainer: two overlapping grains at random spots -> pad */
        float gl = (float)clen * 0.85f;
        if (gl > 19200.0f) gl = 19200.0f;
        float span = (float)clen - gl;
        for (int i = 0; i < 16; i++) {
            cgrPh += 1.0f / gl;
            if (cgrPh >= 1.0f) { cgrPh -= 1.0f; cgrPos[0] = (uint32_t)(cc_rf() * span); }
            float pb = cgrPh + 0.5f;
            if (pb >= 1.0f) pb -= 1.0f;
            if (pb < 1.0f / gl) cgrPos[1] = (uint32_t)(cc_rf() * span);
            float wa = 1.0f - cc_abs(2.0f * cgrPh - 1.0f), wb = 1.0f - wa;
            uint32_t ia = cgrPos[0] + (uint32_t)(cgrPh * gl), ib = cgrPos[1] + (uint32_t)(pb * gl);
            if (ia >= (uint32_t)clen) ia = (uint32_t)clen - 1u;
            if (ib >= (uint32_t)clen) ib = (uint32_t)clen - 1u;
            uint32_t A = cap[ia], B = cap[ib];
            float l = (float)(int16_t)(A & 0xFFFFu) * wa + (float)(int16_t)(B & 0xFFFFu) * wb;
            float r = (float)(int16_t)(A >> 16) * wa + (float)(int16_t)(B >> 16) * wb;
            cg += (cgT - cg) * 0.002f;
            cpL[i] = l * (1.0f / 32768.0f) * cg; cpR[i] = r * (1.0f / 32768.0f) * cg;
        }
    }
}
MC_COLD void cap_write(const float *l, const float *r, bool rec, bool clr) {
    if (clr && !pCclr) { cst = 0; cgT = 0.0f; }
    pCclr = clr;
    if (rec && !pCrec) { cst = 1; crw = 0; ctail = 0; }
    if (!rec && pCrec && cst == 1) {
        clen = crw;
        if (clen < 2400) { cst = 0; clen = 0; }
        else {
            cmode = clen < 48000 ? 1 : 0;
            ctail = clen / 4 < CC_XS ? clen / 4 : CC_XS;
            cpos = 0.0f; cst = 2; cg = 0.0f; cgT = 1.0f;
            cgrPos[0] = 0u; cgrPos[1] = 0u; cgrPh = 0.0f;
        }
    }
    pCrec = rec;
    if (cst == 1) {
        for (int i = 0; i < 16; i++) {
            if ((uint32_t)crw >= CC_CMAX) break;
            int32_t a = (int32_t)(cc_clamp(l[i], -0.999f, 0.999f) * 32767.0f), b = (int32_t)(cc_clamp(r[i], -0.999f, 0.999f) * 32767.0f);
            cap[crw++] = ((uint32_t)a & 0xFFFFu) | ((uint32_t)b << 16);
        }
    } else if (ctail > 0) {
        int32_t tl = clen / 4 < CC_XS ? clen / 4 : CC_XS;
        for (int i = 0; i < 16 && ctail > 0; i++) {
            int32_t a = (int32_t)(cc_clamp(l[i], -0.999f, 0.999f) * 32767.0f), b = (int32_t)(cc_clamp(r[i], -0.999f, 0.999f) * 32767.0f);
            cap[clen + (tl - ctail)] = ((uint32_t)a & 0xFFFFu) | ((uint32_t)b << 16);
            ctail--;
        }
    }
}

/* ===================== chain ===================== */
float peakV;
int32_t beatCnt, beatPulse;
int32_t pend[4];
MC_COLD void cc_resetMod(int m) {
    if (m == 0) { chSwG = 1.0f; chSwD = 0; chHowlEnv = 0.0f; for (int c = 0; c < 2; c++) { chF.s1[c] = chF.s2[c] = 0.0f; chPost[c] = chPt[c] = 0.0f; } }
    if (m == 1) { mvNst = 0; dbC = 0; pcC = 0; mvBase = 384.0f * cc_exp2(rateS * 4.0f); pcAcI = 0; pcOff[0] = pcOff[1] = 0.0f;
                  for (int k = 0; k < PC_NL; k++) pcAc[k] = 0.0f;
                  for (int c = 0; c < 2; c++) { mvApFb[c] = 0.0f; dbT[c] = dbO[c] = pcH[c] = 0.0f; for (int k = 0; k < 12; k++) mvAp[c][k] = 0.0f; } }
    if (m == 2) { dfLp[0] = dfLp[1] = dfHp[0] = dfHp[1] = 0.0f; dfGrSp[0] = dfGrSp[1] = 0.0f; }
    if (m == 3) { txBk = 0.0f; txBkT = 0.0f; txGl = 0; txGate = txGateT = 1.0f; txG = 1.0f;
                  for (int c = 0; c < 2; c++) { txF.s1[c] = txF.s2[c] = 0.0f; } }
}
/* routing (auxM): 0 insert = the pedal, modules in series, the direct signal runs through doubler, delays and
   reverb, MIX fades between the input and the chain; 1 aux = send/return only, doubler, pitch, delays and reverb give
   their wet part alone, never any dry, MIX is the return level; 2 mix (default) = the wet-only chain of aux plus a
   real dry/wet at the end: MIX fully up is the effect alone (a bus), lower down the clean input comes in.
   bypass (bypAll) = trails: the input to the chain fades out in 10 ms, tails keep ringing; insert: the dry comes back
   at unity; aux: only the tails; mix: the dry stays where MIX puts it. omono = L+R on both outputs. */
MC_HOT void cc_block(const int32_t *inL, const int32_t *inR, int32_t *outL, int32_t *outR, int inMode, int omono, bool crec, bool cclr, bool cpre) {
    const float Q27 = 1.0f / 134217728.0f;
    float dL[16], dR[16], L[16], R[16], rL[16], rR[16], gI[16], cL[16], cR[16];
    float pk = peakV * 0.992f;
    float gt = bypAll ? 0.0f : 1.0f, gg = inG;
    for (int i = 0; i < 16; i++) {
        float l = (float)inL[i] * Q27, r = (float)inR[i] * Q27;
        if (inMode == 1) r = l;
        else if (inMode == 2) { float m = 0.5f * (l + r); l = m; r = m; }
        if (cc_abs(l) > pk) pk = cc_abs(l);
        if (cc_abs(r) > pk) pk = cc_abs(r);
        if (gg < gt) { gg += 1.0f / 480.0f; if (gg > gt) gg = gt; }
        else if (gg > gt) { gg -= 1.0f / 480.0f; if (gg < gt) gg = gt; }
        gI[i] = gg; rL[i] = l; rR[i] = r;
        dL[i] = l * gg; dR[i] = r * gg;
        cL[i] = 0.0f; cR[i] = 0.0f;
    }
    inG = gg;
    peakV = pk;
    cap_read();
    if (cpre) for (int i = 0; i < 16; i++) { dL[i] += cpL[i]; dR[i] += cpR[i]; cL[i] = cpL[i]; cR[i] = cpR[i]; }
    for (int i = 0; i < 16; i++) { L[i] = dL[i]; R[i] = dR[i]; }
    timeS += (time_ - timeS) * 0.03f;
    rateS += (rate - rateS) * 0.05f;
    ch_block();
    tx_block();
    float pL[16], pR[16];
    for (int k = 0; k < 4; k++) {
        int m = order[k] & 3;
        if (pend[m] != fx[m] && modG[m] <= 0.0f) { fx[m] = pend[m]; cc_resetMod(m); }
        bool on = !((byp >> m) & 1) && pend[m] == fx[m];
        float gT = on ? 1.0f : 0.0f;
        float g0 = modG[m];
        if (!on && g0 <= 0.0f) {          /* bypassed: keep delay lines fed so trails stay sane */
            if (m == 1) { for (int i = 0; i < 16; i++) { mbuf[(mw & CC_MMASK) * 2u] = L[i]; mbuf[(mw & CC_MMASK) * 2u + 1u] = R[i]; mw++; } }
            if (m == 2) { for (int i = 0; i < 16; i++) { dbuf[(dw & CC_DMASK) * 2u] = L[i]; dbuf[(dw & CC_DMASK) * 2u + 1u] = R[i]; dw++; } }
            continue;
        }
        for (int i = 0; i < 16; i++) { pL[i] = L[i]; pR[i] = R[i]; }
        if (m == 0) ch_run(L, R);
        else if (m == 1) mv_run(L, R);
        else if (m == 2) df_run(L, R);
        else tx_run(L, R);
        float v = (m == 2) ? 1.0f : vol[m] * 2.0f;
        float g1 = g0 + (gT > g0 ? 0.02f : -0.02f);
        g1 = cc_clamp(g1, 0.0f, 1.0f);
        modG[m] = g1;
        for (int i = 0; i < 16; i++) {
            float g = g0 + (g1 - g0) * (float)(i + 1) * (1.0f / 16.0f);
            L[i] = pL[i] + (L[i] * v - pL[i]) * g;
            R[i] = pR[i] + (R[i] * v - pR[i]) * g;
        }
    }
    mixS += (mixv - mixS) * 0.05f;
    olevS += (olev - olevS) * 0.05f;
    float dg = 2.0f * (1.0f - mixS); if (dg > 1.0f) dg = 1.0f;
    float wg = 2.0f * mixS; if (wg > 1.0f) wg = 1.0f;
    float ol[16], orr[16];
    if (auxM) {
        /* no direct dry in the chain; with every module bypassed the chain would just pass the dry: fade it out.
           mix: the clean input is added here by MIX, whatever the bypass does */
        float w = 1.0f - (1.0f - modG[0]) * (1.0f - modG[1]) * (1.0f - modG[2]) * (1.0f - modG[3]);
        float wa = allG, wb = w;
        const float dm = auxM == 2 ? dg : 0.0f;
        allG = w;
        for (int i = 0; i < 16; i++) {
            float ww = wa + (wb - wa) * (float)(i + 1) * (1.0f / 16.0f);
            ol[i] = (cL[i] * dg + rL[i] * dm + L[i] * wg * ww) * olevS * 2.0f;
            orr[i] = (cR[i] * dg + rR[i] * dm + R[i] * wg * ww) * olevS * 2.0f;
        }
    } else {
        for (int i = 0; i < 16; i++) {
            float k = 1.0f - gI[i];
            ol[i] = (dL[i] * dg + L[i] * wg) * olevS * 2.0f + rL[i] * k;
            orr[i] = (dR[i] * dg + R[i] * wg) * olevS * 2.0f + rR[i] * k;
        }
    }
    if (cpre) cap_write(dL, dR, crec, cclr);
    else cap_write(ol, orr, crec, cclr);
    for (int i = 0; i < 16; i++) {
        float l = ol[i], r = orr[i];
        if (!cpre) { l += cpL[i]; r += cpR[i]; }
        if (omono) { float m = 0.5f * (l + r); l = m; r = m; }
        l = cc_clamp(l, -1.5f, 1.5f); r = cc_clamp(r, -1.5f, 1.5f);
        l = cc_abs(l) > 0.8f ? (l > 0.0f ? 0.8f + 0.2f * cc_tanh((l - 0.8f) * 5.0f) : -0.8f + 0.2f * cc_tanh((l + 0.8f) * 5.0f)) : l;
        r = cc_abs(r) > 0.8f ? (r > 0.0f ? 0.8f + 0.2f * cc_tanh((r - 0.8f) * 5.0f) : -0.8f + 0.2f * cc_tanh((r + 0.8f) * 5.0f)) : r;
        outL[i] = (int32_t)(l * 134217727.0f);
        outR[i] = (int32_t)(r * 134217727.0f);
    }
}

MC_COLD void chroma_coldInit() {
for (uint32_t i = 0; i < 2u * 16384u; i++) mbuf[i] = 0.0f;
vbRnd[0] = vbRnd[1] = vbT[0] = vbT[1] = 0.0f;
for (uint32_t i = 0; i < 2u * 131072u; i++) dbuf[i] = 0.0f;
for (uint32_t i = 0; i < 2u * 2048u; i++) tbuf[i] = 0.0f;
mw = dw = tw = 0u; rng = 0x9E3779B9u;
for (int m = 0; m < 4; m++) { fx[m] = 0; pend[m] = 0; order[m] = m; modG[m] = 1.0f; vol[m] = 0.5f; }
byp = 0; tilt = camt = rate = mamt = time_ = damt = tamt = 0.5f; mixv = 1.0f; driftM = driftD = 0.0f; sens = 0.5f; olev = 0.5f;
fstyle = 0; beat = 24000; tapR = tapT = bypAll = false;
allG = 1.0f; mixS = 1.0f; olevS = 0.5f; timeS = 0.5f; rateS = 0.5f;
chEnv = chEnvS = chHowlEnv = 0.0f; chSwG = 1.0f; chCmp = 1.0f; chOnT = 0; chSwD = 0; chTiltL = chTiltH = chTiltLs = chTiltHs = chPre = 1.0f;
for (int c = 0; c < 2; c++) { chLp[c] = chHp[c] = chTl[c] = chPost[c] = chPt[c] = 0.0f; chF.s1[c] = chF.s2[c] = 0.0f; }
cc_svfSet(chF, 1000.0f, 1.0f);
mvPh = mvPh3 = mvDr = mvDrT = mvW2 = 0.0f; mvDrC = 0; dbC = 0; mvNst = 0; pcC = 0; mvBase = 1536.0f;
dbT[0] = dbT[1] = dbO[0] = dbO[1] = pcH[0] = pcH[1] = 0.0f;
pcAcI = 0; pcOff[0] = pcOff[1] = 0.0f;
for (int k = 0; k < PC_NL; k++) pcAc[k] = 0.0f;
for (int c = 0; c < 2; c++) { mvPh2[c] = 0.0f; mvApFb[c] = 0.0f; for (int k = 0; k < 12; k++) mvAp[c][k] = 0.0f; }
dfD = 24000.0f; dfWow = dfGrPh = dfRvPh = 0.0f; dfGrCnt = 0; dfGL = 10000.0f;
dfSoft[0] = dfSoft[1] = txSoft[0] = txSoft[1] = 0.0f;
aw_flutInit(dfFw, 0x2545F491u); aw_flutInit(dfFf, 0x9E3779B1u); aw_flutInit(txFw, 0x85EBCA77u); aw_flutInit(txFf, 0xC2B2AE3Du);
for (int c = 0; c < 2; c++) { dfLp[c] = dfHp[c] = dfFbS[c] = 0.0f; dfGrMul[c] = 1.0f; dfGrSp[c] = 0.0f; dfRvStart[c] = 0.0f; }
rvSz = 1.0f; rvPreS = 960.0f; rvTrim = 1.0f;
txEnv = 0.0f; txG = 1.0f; txWow = txFl = txBk = txBkT = txAm = txCrk = 0.0f; txGate = txGateT = 1.0f; txSt = 0.0f;
txBkC = 48000; txHc = 0; txGl = 0; txGlC = 0;
for (int c = 0; c < 2; c++) { txLp[c] = txTl[c] = txHiss[c] = txHold[c] = 0.0f; txF.s1[c] = txF.s2[c] = txH.s1[c] = txH.s2[c] = 0.0f; }
cc_svfSet(txF, 2000.0f, 0.8f); cc_svfSet(txH, 2000.0f, 0.8f);
cst = 0; clen = 0; crw = 0; ctail = 0; cmode = 0; cpos = 0.0f; cg = 0.0f; cgT = 0.0f; cgrPh = 0.0f;
cgr[0] = cgr[1] = 0.0f; cgrPos[0] = cgrPos[1] = 0u; pCrec = pCclr = false;
for (int i = 0; i < 16; i++) { cpL[i] = cpR[i] = 0.0f; }
peakV = 0.0f; beatCnt = 0; beatPulse = 0;
auxM = 0; inG = 1.0f;
tdiv = 4; rdiv = 4; bidx = 0; pSync = false; mvCorr = 0.0f;
}
]]></code.declaration>
         <code.init><![CDATA[static float s_mbuf[2u * 16384u] __attribute__ ((section (".sdram")));
static float s_dbuf[2u * 131072u] __attribute__ ((section (".sdram")));
static float s_tbuf[2u * 2048u] __attribute__ ((section (".sdram")));
static float s_pl[1u << 16] __attribute__ ((section (".sdram")));
static uint32_t s_cap[CC_CMAX + 512u] __attribute__ ((section (".sdram")));
mbuf = &s_mbuf[0]; dbuf = &s_dbuf[0]; tbuf = &s_tbuf[0]; cap = &s_cap[0];
pl_init(&s_pl[0]);
chroma_coldInit();
]]></code.init>
         <code.krate><![CDATA[{
    const float Q = 1.0f / 134217728.0f;
    for (int m = 0; m < 4; m++) { int32_t v = (inlet_fx >> (3 * m)) & 7; pend[m] = v > 4 ? 4 : v; }
    byp = inlet_byp & 15;
    for (int k = 0; k < 4; k++) order[k] = (inlet_ord >> (2 * k)) & 3;
    tilt = cc_clamp((float)inlet_tilt * Q, 0.0f, 1.0f);
    camt = cc_clamp((float)inlet_camt * Q, 0.0f, 1.0f);
    rate = cc_clamp((float)inlet_rate * Q, 0.0f, 1.0f);
    mamt = cc_clamp((float)inlet_mamt * Q, 0.0f, 1.0f);
    time_ = cc_clamp((float)inlet_time * Q, 0.0f, 1.0f);
    damt = cc_clamp((float)inlet_damt * Q, 0.0f, 1.0f);
    tamt = cc_clamp((float)inlet_tamt * Q, 0.0f, 1.0f);
    mixv = cc_clamp((float)inlet_mix * Q, 0.0f, 1.0f);
    driftM = cc_clamp((float)inlet_driftm * Q, 0.0f, 1.0f);
    driftD = cc_clamp((float)inlet_driftd * Q, 0.0f, 1.0f);
    sens = cc_clamp((float)inlet_sens * Q, 0.0f, 1.0f);
    vol[0] = cc_clamp((float)inlet_cvol * Q, 0.0f, 1.0f);
    vol[1] = cc_clamp((float)inlet_mvol * Q, 0.0f, 1.0f);
    vol[2] = cc_clamp((float)inlet_dvol * Q, 0.0f, 1.0f);
    vol[3] = cc_clamp((float)inlet_tvol * Q, 0.0f, 1.0f);
    olev = cc_clamp((float)inlet_olev * Q, 0.0f, 1.0f);
    fstyle = inlet_fstyle < 0 ? 0 : (inlet_fstyle > 2 ? 2 : inlet_fstyle);
    beat = inlet_beat < 2400 ? 2400 : (inlet_beat > 120000 ? 120000 : inlet_beat);
    tapR = inlet_tapr; tapT = inlet_tapt; bypAll = inlet_bypall;
    tdiv = inlet_tdiv & 7; rdiv = inlet_rdiv & 7; bidx = inlet_bidx;
    if (!tapR) mvCorr = 0.0f;
    if (inlet_sync && !pSync) {
        beatCnt = beatCnt > beat / 2 ? beat - 16 : 0;           /* LED on the clock beat */
        if (tapR) {                                              /* LFO: loudest point of the tremolo on the beat */
            float rm = cc_rdiv(rdiv), tg = (float)bidx * rm + 0.75f;
            tg -= (float)(int32_t)tg;
            float e = tg - mvPh;
            if (e > 0.5f) e -= 1.0f;
            if (e < -0.5f) e += 1.0f;
            float lim = 0.5f * rm / (float)beat;                 /* never more than half the LFO speed */
            mvCorr = cc_clamp(e / (2.0f * (float)beat), -lim, lim);
        }
    }
    pSync = inlet_sync;
    beatCnt += 16;
    if (beatCnt >= beat) { beatCnt -= beat; beatPulse = 1440; }
    if (beatPulse > 0) beatPulse -= 16;
    auxM = attr_routing;
    cc_block(inlet_inL, inlet_inR, outlet_outL, outlet_outR, attr_input, attr_output, inlet_crec, inlet_cclr, inlet_cpre);
    outlet_cstate = cst | (cmode << 4);
    outlet_clen = (cst == 1 ? crw : clen) / 48;
    outlet_peak = (int32_t)((peakV > 1.0f ? 1.0f : peakV) * 134217727.0f);
    outlet_beatp = beatPulse > 0;
    outlet_aux = attr_routing == 1;
    outlet_inmode = attr_input;
    outlet_omono = attr_output != 0;
}
]]></code.krate>
